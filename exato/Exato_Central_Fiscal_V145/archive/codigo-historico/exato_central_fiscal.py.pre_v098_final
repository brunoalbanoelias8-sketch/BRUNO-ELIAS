    out=Path(output_path); out.parent.mkdir(parents=True,exist_ok=True)
    family=str(family or '').casefold()
    docs=[]
    for d in documents or []:
        fam=str(d.get('family') or '').casefold()
        if family and fam!=family: continue
        xml=d.get('xml') or b''
        if isinstance(xml,memoryview): xml=xml.tobytes()
        if not isinstance(xml,(bytes,bytearray)): continue
        parsed=_parse_fiscal_representation(bytes(xml),fam)
        if not parsed: continue
        parsed['_source']=d; parsed['_xml']=bytes(xml)
        docs.append(parsed)
    # Deterministic de-duplication by access key (or number/date fallback).
    seen=set(); unique=[]
    for d in docs:
        key=d.get('access_key') or f"{d.get('family')}|{d.get('number')}|{str(d.get('issued') or '')[:10]}|{d.get('series')}"
        if key in seen: continue
        seen.add(key); unique.append(d)
    docs=sorted(unique,key=lambda x:(str(x.get('issued') or '')[:10] or '9999-99-99', int(re.sub(r'\D','',str(x.get('number') or '')) or 10**12), str(x.get('number') or ''), str(x.get('access_key') or '')))
    if not docs: raise ValueError('Nenhum XML válido para gerar a representação gráfica fiscal.')

    styles=getSampleStyleSheet(); NAVY=colors.HexColor('#111827'); INK=colors.HexColor('#111827'); MUTED=colors.HexColor('#667085'); GRID=colors.HexColor('#CBD5E1'); LIGHT=colors.HexColor('#F8FAFC'); RED=colors.HexColor('#D71920'); GREEN=colors.HexColor('#15803D'); WHITE=colors.white
