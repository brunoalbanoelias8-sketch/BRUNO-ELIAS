def db_max_source_nsu(cnpj, family):
    """Return the highest source NSU actually stored for a company/family.

    This is a safety fallback for manual continuation: if a previous version failed
    to persist its checkpoint correctly, the documents already stored locally still
    tell us the furthest NSU that was safely captured.
    """
    init_database()
    conn=sqlite3.connect(DB_PATH, timeout=30)
    cnpj_digits=re.sub(r'\D','',str(cnpj or ''))
    row=conn.execute(
        "SELECT MAX(CAST(source_nsu AS INTEGER)) FROM documents WHERE cnpj=? AND family=? AND source_nsu GLOB '[0-9]*'",
        (cnpj_digits,family)
    ).fetchone()
    conn.close()
    try:
        return max(0,int(row[0] or 0))
    except Exception:
        return 0



def db_max_actor_source_nsu(cnpj, family, actor_code):
