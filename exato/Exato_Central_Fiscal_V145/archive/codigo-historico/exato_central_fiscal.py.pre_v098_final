def _parse_event_status(xml_bytes):
    """Return event information used to mark documents such as cancelled."""
    import xml.etree.ElementTree as ET
    result = {'access_key': '', 'event_type': '', 'cstat': ''}
    try:
        root = ET.fromstring(xml_bytes)
    except Exception:
        return result
    for node in root.iter():
        tag = _local_tag(node)
        text = (node.text or '').strip()
        if tag in ('chNFe', 'chCTe') and text and not result['access_key']:
            result['access_key'] = re.sub(r'\D', '', text)
        elif tag == 'tpEvento' and text and not result['event_type']:
            result['event_type'] = text
        elif tag == 'cStat' and text and not result['cstat']:
            result['cstat'] = text
    return result


def _parse_report_document(xml_bytes, consulta_cnpj='', family_hint=''):
    """Extract user-facing report fields from NF-e, NFC-e or CT-e XML."""
    meta = _parse_document_metadata(xml_bytes, consulta_cnpj, family_hint)
    tipo = meta.get('tipo') or 'Documento'
    if tipo not in ('NF-e', 'NFC-e', 'CT-e'):
        return None
    # Events are handled separately so they can change the status of a document.
    raw_type = (family_hint or '').casefold()
    if 'evento' in raw_type or meta.get('tipo') == 'Evento':
        return None
    return {
        'tipo': tipo,
        'numero': meta.get('numero') or '',
        'data': meta.get('data') or '',
        'valor': meta.get('valor') or Decimal('0.00'),
        'chave': meta.get('chave') or '',
        'direcao': meta.get('direcao') or 'Entrada',
        'status': 'Autorizado',
        'empresa': meta.get('empresa') or 'Empresa consultada',
    }


def _build_report_cancel_map(documents):
    """Build access-key -> cancellation map from distributed event XMLs."""
    cancelled = set()
    for doc in documents or []:
        raw_type = str(doc.get('tipo') or '')
        if not raw_type.lower().startswith('procEvento') and 'evento' not in raw_type.lower():
            continue
        ev = _parse_event_status(doc.get('xml') or b'')
        if ev.get('event_type') == '110111' and ev.get('access_key') and ev.get('cstat') in {'135', '155'}:
            cancelled.add(ev['access_key'])
    return cancelled


def _document_protocol_cstat(xml_bytes):
    """Read the authorization protocol status from a processed NF-e/NFC-e/CT-e XML."""
    import xml.etree.ElementTree as ET
    try:
        root = ET.fromstring(xml_bytes)
    except Exception:
        return ''
    # Prefer the protocol's cStat over unrelated batch/event statuses.
    for parent in root.iter():
        if _local_tag(parent) in ('infProt', 'infCte', 'infCTeSupl'):
            for n in parent.iter():
                if _local_tag(n) == 'cStat' and (n.text or '').strip():
                    return (n.text or '').strip()
    # Fallback to the first cStat when the schema is summarized.
    for n in root.iter():
        if _local_tag(n) == 'cStat' and (n.text or '').strip():
            return (n.text or '').strip()
    return ''



def _is_valid_cnpj(cnpj):
    """Validate a traditional numeric 14-digit CNPJ checksum."""
    digits = re.sub(r'\D', '', str(cnpj or ''))
    if len(digits) != 14 or len(set(digits)) == 1:
        return False
    nums = [int(x) for x in digits]
    w1 = [5,4,3,2,9,8,7,6,5,4,3,2]
    total = sum(a*b for a,b in zip(nums[:12], w1))
    r = total % 11
    dv1 = 0 if r < 2 else 11-r
    w2 = [6,5,4,3,2,9,8,7,6,5,4,3,2]
    total = sum(a*b for a,b in zip(nums[:13], w2))
    r = total % 11
    dv2 = 0 if r < 2 else 11-r
    return nums[12] == dv1 and nums[13] == dv2


def lookup_company_name_automatic(cnpj, timeout=8):
    """Best-effort automatic lookup for one explicit CNPJ confirmation.

    Local fiscal data remains the preferred source. When it is unavailable,
    this tries one public consultation at a time using documented public
    services. It is never used for bulk crawling or fiscal capture.
    """
    digits = re.sub(r'\D', '', str(cnpj or ''))
    if len(digits) != 14:
        return {'ok': False, 'name': '', 'fantasy': '', 'status': '', 'source': '', 'error': 'CNPJ inválido.'}
    providers = [
        ('CNPJ.ws', f'https://publica.cnpj.ws/cnpj/{digits}'),
        ('BrasilAPI', f'https://brasilapi.com.br/api/cnpj/v1/{digits}'),
    ]
    last_error = 'Consulta automática indisponível.'
    for provider, url in providers:
        try:
            req = Request(url, headers={'Accept': 'application/json', 'User-Agent': 'Exato-Central-Fiscal/1.0'})
            with urlopen(req, timeout=timeout) as response:
                payload = json.loads(response.read().decode('utf-8', errors='replace'))
            name = str(payload.get('razao_social') or '').strip()
            establishment = payload.get('estabelecimento') or {}
            fantasy = str(payload.get('nome_fantasia') or establishment.get('nome_fantasia') or '').strip()
            status = str(payload.get('descricao_situacao_cadastral') or payload.get('situacao_cadastral') or establishment.get('situacao_cadastral') or '').strip()
            if name:
                return {'ok': True, 'name': name, 'fantasy': fantasy, 'status': status, 'source': provider, 'error': ''}
            last_error = f'{provider}: nome empresarial não retornado.'
        except HTTPError as exc:
            last_error = f'{provider}: consulta indisponível (HTTP {exc.code}).'
        except URLError:
            last_error = f'{provider}: consulta indisponível no momento.'
        except Exception as exc:
            last_error = f'{provider}: {exc}'
    return {'ok': False, 'name': '', 'fantasy': '', 'status': '', 'source': 'consulta automática', 'error': last_error}


def db_set_company_name(cnpj, name):
    digits = re.sub(r'\D', '', str(cnpj or ''))
    clean = str(name or '').strip()
    if not digits or not clean or clean in {f'Empresa_{digits}', 'Empresa não identificada'}:
        return False
    init_database()
    conn = sqlite3.connect(DB_PATH, timeout=30)
    now = datetime.now().isoformat(timespec='seconds')
    conn.execute(
        "INSERT INTO companies(cnpj,name,last_sync_at,created_at) VALUES(?,?,?,?) "
        "ON CONFLICT(cnpj) DO UPDATE SET name=excluded.name,last_sync_at=excluded.last_sync_at",
        (digits, clean, now, now),
    )
    conn.commit(); conn.close()
    return True


def _format_cnpj(value):
    digits = re.sub(r'\D', '', str(value or ''))
    if len(digits) == 14:
        return f'{digits[:2]}.{digits[2:5]}.{digits[5:8]}/{digits[8:12]}-{digits[12:]}'
    return value or 'Não informado'


def _intelligent_fiscal_analysis(entry_authorized, output_authorized, total_authorized,
                                 authorized_count=0, type_values=None, entry_count=0, output_count=0):
    """Produce one concise, prudent fiscal reading when there is a relevant signal.

    The engine focuses only on basic management signals that the fiscal documents can
    support: purchase/sales balance, possible stock pressure and possible cash impact.
    It deliberately avoids positive filler when the period looks balanced and never
    states that a cash/stock problem exists based only on fiscal documents.
    """
    entry = Decimal(str(entry_authorized or 0))
    output = Decimal(str(output_authorized or 0))
    total = Decimal(str(total_authorized or 0))
    if total <= 0 or (entry <= 0 and output <= 0):
        return None

    type_values = type_values or {}
    output_types = type_values.get('outputs') or {}
    entry_types = type_values.get('entries') or {}

    diff = abs(output - entry)
    diff_share = (diff / total) if total else Decimal('0')
    dominant = 'saídas' if output > entry else ('entradas' if entry > output else 'equilíbrio')
    ratio = (min(entry, output) / max(entry, output)) if max(entry, output) > 0 else Decimal('1')

    # Very close movement: do not manufacture a positive message.
    if entry > 0 and output > 0 and (diff_share <= Decimal('0.08') or ratio >= Decimal('0.88')):
        return None

    if entry == 0 and output > 0:
        text = ('Não foram identificados valores de entrada no período. Vale verificar a posição de '
                'estoque e considerar compras realizadas em períodos anteriores antes de interpretar '
                'essa movimentação isoladamente.')
        return {'level': 'Atenção', 'title': 'Saídas sem entradas registradas', 'text': text}

    if output == 0 and entry > 0:
        text = ('As compras ficaram concentradas no período, sem valores de saída registrados. '
                'Vale acompanhar o impacto desses desembolsos sobre o caixa e a formação de estoque.')
        return {'level': 'Atenção', 'title': 'Entradas sem saídas registradas', 'text': text}

    # Very large imbalance.
    if diff_share >= Decimal('0.45'):
        if output > entry:
            base = ('As saídas ficaram muito acima das compras no período. Vale acompanhar a posição '
                    'de estoque e a origem das mercadorias comercializadas, inclusive considerando '
                    'aquisições realizadas em períodos anteriores.')
            if output_types:
                total_out = sum((Decimal(str(v or 0)) for v in output_types.values()), Decimal('0'))
                if total_out > 0:
                    nc = Decimal(str(output_types.get('NFC-e') or 0)) / total_out
                    if nc >= Decimal('0.70'):
                        base = ('As vendas ao consumidor concentraram grande parte das saídas no período, '
                                'enquanto as compras ficaram bem abaixo desse movimento. Vale acompanhar a '
                                'posição de estoque e a necessidade de reposição para os próximos períodos.')
            return {'level': 'Atenção elevada', 'title': 'Forte predominância de saídas', 'text': base}
        base = ('As compras ficaram muito acima das vendas no período. Vale acompanhar a formação de '
                'estoque e o impacto desses desembolsos sobre o caixa da empresa, especialmente caso '
                'parte das aquisições esteja destinada a períodos futuros.')
        return {'level': 'Atenção elevada', 'title': 'Forte predominância de entradas', 'text': base}

    # Relevant but not extreme imbalance.
    if diff_share >= Decimal('0.20'):
        if output > entry:
            text = ('As vendas ficaram significativamente acima das compras no período. Vale acompanhar '
                    'a reposição de estoque e considerar a participação de aquisições realizadas em períodos anteriores.')
            return {'level': 'Observação', 'title': 'Vendas acima das compras', 'text': text}
        text = ('As compras ficaram significativamente acima das vendas no período. Vale acompanhar '
                'o impacto das aquisições sobre o caixa e a formação de estoque.')
        return {'level': 'Observação', 'title': 'Compras acima das vendas', 'text': text}

    # Small-to-moderate difference: only speak when it is actually worth mentioning.
    if diff_share >= Decimal('0.12'):
        if output > entry:
            return {'level': 'Observação', 'title': 'Vendas acima das compras',
                    'text': ('As vendas ficaram acima das compras no período. Vale acompanhar a reposição '
                             'do estoque e a evolução dessa relação nas próximas movimentações.')}
        return {'level': 'Observação', 'title': 'Compras acima das vendas',
                'text': ('As compras ficaram acima das vendas no período. Vale acompanhar a formação de '
                         'estoque e a evolução dos desembolsos nas próximas movimentações.')}

    return None

def generate_documents_pdf(documents, output_path, selected_cert=None, consulta_cnpj='', period_start='', period_end='', audit_result=None, consolidated_family=''):
    """Generate the approved executive report plus direction-separated detail pages.

    The first page is a compact managerial dashboard. Following pages are split by
    Entrada and Saída and list one fiscal document per row with Natureza da Operação.
    No financial conclusion is inferred beyond values present in the XMLs.
    """
    _ensure_reportlab()
    from reportlab.lib import colors
    from reportlab.lib.enums import TA_LEFT, TA_RIGHT, TA_CENTER
    from reportlab.lib.pagesizes import A4
    from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
    from reportlab.lib.units import mm
    from reportlab.platypus import SimpleDocTemplate, Table, TableStyle, Paragraph, Spacer, Image, PageBreak, LongTable
    from reportlab.graphics.shapes import Drawing, Rect, String, Line, Circle
    from reportlab.graphics.charts.piecharts import Pie
    from reportlab.pdfgen import canvas as rlcanvas

    docs=[]
    family_filter={'NF-e':'nfe','NFC-e':'nfce','CT-e':'cte'}.get(str(consolidated_family or '').strip(),str(consolidated_family or '').strip())
    for doc in (documents or []):
        if family_filter and str(doc.get('family') or '').casefold()!=family_filter.casefold(): continue
        issued=str(doc.get('data') or doc.get('issued_at') or '')[:10]
        if period_start and (not issued or issued<str(period_start)[:10]): continue
        if period_end and (not issued or issued>str(period_end)[:10]): continue
        docs.append(doc)
    cancelled_keys=_build_report_cancel_map(documents or [])
    rows=[]; seen=set()
    for doc in docs:
        raw=doc.get('xml') or b''
        if isinstance(raw,memoryview): raw=raw.tobytes()
        parsed=_parse_report_document(raw,consulta_cnpj,doc.get('family') or doc.get('tipo') or '')
        if not parsed: continue
        rep=_parse_fiscal_representation(raw,doc.get('family') or doc.get('tipo') or '') or {}
        key=parsed.get('chave') or f"{parsed.get('tipo')}|{parsed.get('numero')}|{parsed.get('data')}|{parsed.get('valor')}"
        if key in seen: continue
        seen.add(key)
        cstat=_document_protocol_cstat(raw)
        parsed['status']='Cancelado' if parsed.get('chave') in cancelled_keys else ('Autorizado' if cstat in {'100','150'} or not cstat else 'Não autorizado')
        parsed['natureza']=str(rep.get('nat_op') or '').strip() or 'Não informada'
        parsed['serie']=str(rep.get('series') or parsed.get('serie') or '').strip()
        parsed['emit']=rep.get('emit') or {}; parsed['dest']=rep.get('dest') or {}
        parsed['party']=(parsed['emit'] if parsed.get('direcao')=='Entrada' else parsed['dest']) or {}
        rows.append(parsed)
    if not rows: raise ValueError('Nenhum documento fiscal válido foi encontrado para o relatório.')
    rows.sort(key=lambda x:(x.get('data') or '9999-99-99',int(x['numero']) if str(x.get('numero','')).isdigit() else 10**9,x.get('tipo') or '',x.get('chave') or ''))
    entries=[r for r in rows if r.get('direcao')=='Entrada']; outputs=[r for r in rows if r.get('direcao')!='Entrada']
    entry_authorized=sum((r['valor'] for r in entries if r.get('status')=='Autorizado'),Decimal('0.00'))
    output_authorized=sum((r['valor'] for r in outputs if r.get('status')=='Autorizado'),Decimal('0.00'))
    total_authorized=entry_authorized+output_authorized
    entry_pct=(entry_authorized/total_authorized*Decimal('100')) if total_authorized else Decimal('0')
    output_pct=(output_authorized/total_authorized*Decimal('100')) if total_authorized else Decimal('0')
