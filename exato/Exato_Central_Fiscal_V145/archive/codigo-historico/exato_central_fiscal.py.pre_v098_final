    def refresh_certificates(self):
        self.set_status("Lendo certificados instalados no Windows...")
        for iid in self.tree.get_children():
            self.tree.delete(iid)
        self.continue_btn.config(state="disabled")
        # V074: preserve the certificate already selected in the Central.
        # The prior version could clear the in-memory selection during refresh,
        # making it easy for a different certificate to become active.
        current_thumb = (self.selected.get('Thumbprint') or '').replace(' ','').upper() if self.selected else ''
        self._refresh_selected_thumbprint = current_thumb or (self.config_data.get('selected_certificate_thumbprint') or '').replace(' ','').upper()
        if not self.selected:
            self.selection_label.config(text="Restaurando certificado salvo...", fg=MUTED)
        self._show_certificate_header_state()

        def worker():
            certs, error = enumerate_windows_certificates()
            try:
                self.after(0, lambda: self._finish_refresh(certs, error))
            except RuntimeError:
                pass
        threading.Thread(target=worker, daemon=True).start()

    def _finish_refresh(self, certs, error):
        self.certificates = certs
        if error and not certs:
            self.set_status(error)
        else:
            self.set_status(f"{len(certs)} certificado(s) com chave privada encontrado(s).")
        # Mostra somente certificados vigentes e ordena alfabeticamente pela identificação exibida.
        valid_certs = [c for c in certs if c.get("Status") != "Expirado"]
        valid_certs.sort(key=lambda c: (c.get("FriendlyName") or c.get("Subject") or "Sem identificação").casefold())
        self.certificates = valid_certs
        if error and not valid_certs:
            self.set_status(error)
            return
        self.set_status(f"{len(valid_certs)} certificado(s) válido(s) encontrado(s).")
        if hasattr(self, 'cert_count_label'):
            self.cert_count_label.config(text=f"{len(valid_certs)} certificado(s) válido(s) disponível(is)")
        for idx, cert in enumerate(valid_certs):
            subject = cert.get("FriendlyName") or cert.get("Subject") or "Sem identificação"
            not_after = cert.get("NotAfter", "")
            try:
                dt = datetime.fromisoformat(not_after.replace("Z", "+00:00")).replace(tzinfo=None)
                validity = dt.strftime("%d/%m/%Y")
            except Exception:
                validity = "Não informado"
            status = cert.get("Status", "Não informado")
            self.tree.insert("", "end", iid=str(idx), values=(
                subject, cert.get("Document", "Não identificado"), cert.get("TypeGuess", "Não determinado"), validity, status
            ))

        # V074: restore the exact certificate previously confirmed by the user.
        # This is intentionally based on thumbprint and never on alphabetical order
        # or the first certificate returned by Windows.
        saved_thumb=(self.config_data.get('selected_certificate_thumbprint') or '').replace(' ','').upper()
        restore_thumb = getattr(self, '_refresh_selected_thumbprint', '') or saved_thumb
        match=next((c for c in valid_certs if (c.get('Thumbprint') or '').replace(' ','').upper()==restore_thumb),None) if restore_thumb else None
        if match:
            self.selected=match
            idx=valid_certs.index(match)
            try:
                self.tree.selection_set(str(idx))
                self.tree.focus(str(idx))
                self.tree.see(str(idx))
            except Exception:
                pass
            self.continue_btn.config(state="normal")
            subject=match.get('FriendlyName') or match.get('Subject') or 'Certificado selecionado'
            self.selection_label.config(text=subject, fg=TEXT)
            not_after=match.get('NotAfter','')
            try:
                dt=datetime.fromisoformat(not_after.replace('Z','+00:00')).replace(tzinfo=None)
                self.selection_validity.config(text=f"CNPJ/CPF: {match.get('Document','Não informado')}  •  Válido até {dt.strftime('%d/%m/%Y')}", fg=GREEN)
            except Exception:
                self.selection_validity.config(text=f"CNPJ/CPF: {match.get('Document','Não informado')}", fg=GREEN)
            # Keep the saved identity synchronized with the Windows certificate record.
            self.config_data['selected_certificate_thumbprint']=re.sub(r'\s+','',str(match.get('Thumbprint') or '')).upper()
            self.config_data['selected_certificate_subject']=match.get('Subject','')
            self.config_data['selected_certificate_document']=match.get('Document','')
            try: save_config(self.config_data)
            except Exception: pass
            self._show_certificate_header_state()
        elif saved_thumb:
            self.selected=None
            self.continue_btn.config(state="disabled")
            self.selection_label.config(text="O certificado salvo não está disponível neste Windows. Selecione o certificado correto.", fg="#9B1C1C")
            if hasattr(self,'selection_validity'): self.selection_validity.config(text='')
            self._show_certificate_header_state()

        active=self.config_data.get('active_sync') or {}
        if active.get('cnpj') and active.get('run_id') and valid_certs:
            saved_thumb=(self.config_data.get('selected_certificate_thumbprint') or '').replace(' ','').upper()
            match=next((c for c in valid_certs if (c.get('Thumbprint') or '').replace(' ','').upper()==saved_thumb),None)
            if match:
                if messagebox.askyesno('Retomar atualização','Uma atualização anterior foi interrompida. Deseja continuar usando o certificado salvo?'):
                    try: db_update_run(active.get('run_id'),'Interrompida',finished=True,error_text='Aplicativo fechado antes da conclusão; retomada solicitada.')
                    except Exception: pass
                    self.selected=match; self._resume_cnpj=str(active.get('cnpj') or ''); self._show_webservice_test(); self.after(300,self._run_sync_all)
                else:
                    self.config_data.pop('active_sync',None)
                    try: save_config(self.config_data)
                    except Exception: pass

