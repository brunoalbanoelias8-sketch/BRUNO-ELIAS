class AuditCancelled(Exception):
    """Raised when the user cancels the SAT audit."""

class _SATFormParser(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.form_action=''; self.in_form=False; self.depth=0; self.controls=[]
        self._select=None; self._option=None; self._button=None; self._textarea=None
    def handle_starttag(self,tag,attrs):
        a={k.lower():v for k,v in attrs}; tag=tag.lower()
        if tag=='form' and not self.in_form:
            self.in_form=True; self.depth=1; self.form_action=a.get('action') or ''; return
        if not self.in_form: return
        if tag=='form': self.depth+=1; return
        if tag=='input':
            name=a.get('name'); typ=(a.get('type') or 'text').lower()
            if name and 'disabled' not in a:
                self.controls.append({'tag':'input','type':typ,'name':name,'value':a.get('value') or '', 'checked':'checked' in a})
        elif tag=='select':
            name=a.get('name')
            if name: self._select={'tag':'select','name':name,'options':[]}
        elif tag=='option' and self._select is not None:
            self._option={'value':a.get('value') or '', 'selected':'selected' in a, 'text':[]}
        elif tag=='button':
            name=a.get('name')
            if name: self._button={'tag':'button','name':name,'value':a.get('value') or '', 'text':[]}
        elif tag=='textarea':
            name=a.get('name')
            if name: self._textarea={'tag':'textarea','name':name,'text':[]}
    def handle_data(self,data):
        if self._option is not None: self._option['text'].append(data)
        if self._button is not None: self._button['text'].append(data)
        if self._textarea is not None: self._textarea['text'].append(data)
    def handle_endtag(self,tag):
        tag=tag.lower()
        if tag=='option' and self._option is not None and self._select is not None:
            self._option['text']=''.join(self._option['text']).strip(); self._select['options'].append(self._option); self._option=None
        elif tag=='select' and self._select is not None:
            opts=self._select['options']; sel=next((x for x in opts if x.get('selected')), None) or (opts[0] if opts else None)
            self._select['value']=(sel or {}).get('value',''); self.controls.append(self._select); self._select=None
        elif tag=='button' and self._button is not None:
            self._button['text']=' '.join(self._button['text']).strip(); self.controls.append(self._button); self._button=None
        elif tag=='textarea' and self._textarea is not None:
            self._textarea['value']=''.join(self._textarea['text']); self.controls.append(self._textarea); self._textarea=None
        elif tag=='form' and self.in_form:
            self.depth-=1
            if self.depth<=0: self.in_form=False

def _sat_parse_form(html):
    p=_SATFormParser()
    try: p.feed(html or '')
    except Exception: pass
    return p

def _sat_norm_text(v):
    return re.sub(r'\s+',' ',unescape(str(v or ''))).strip().casefold()

def _sat_form_action(parser,current_url):
    return urljoin(current_url, parser.form_action or current_url)

def _sat_find_control(controls,frags,tags=None):
    frags=[str(x).casefold() for x in frags]
    for c in controls:
        if tags and c.get('tag') not in tags: continue
        n=str(c.get('name') or '').casefold()
        if any(f in n for f in frags): return c
    return None

def _sat_select_value(parser,frags,label):
    c=_sat_find_control(parser.controls,frags,{'select'})
    if not c: return None
    wanted=_sat_norm_text(label)
    for o in c.get('options') or []:
        t=_sat_norm_text(o.get('text'))
        if t==wanted or wanted in t or t in wanted: return c,o.get('value','')
    return c,c.get('value','')

def _sat_build_form_payload(parser,updates=None,submit_hint=None):
    updates={str(k):str(v) for k,v in (updates or {}).items()}; pairs=[]; used=set()
    for c in parser.controls:
        n=str(c.get('name') or ''); typ=(c.get('type') or '').lower()
        if not n or typ in {'submit','button','image','reset','file'}: continue
        if n in updates:
            if n not in used: pairs.append((n,updates[n])); used.add(n)
            continue
        if typ in {'radio','checkbox'} and not c.get('checked'): continue
        pairs.append((n,str(c.get('value') or '')))
    for n,v in updates.items():
        if n not in used: pairs.append((n,v))
    if submit_hint:
        h=_sat_norm_text(submit_hint); chosen=None
        for c in parser.controls:
            txt=_sat_norm_text(c.get('value') or c.get('text'))
            name=str(c.get('name') or '').casefold()
            if txt==h or (h in txt and 'itens' not in txt) or ('btn'+h.replace(' ','') in name): chosen=c; break
        if chosen and chosen.get('name'): pairs.append((str(chosen['name']),str(chosen.get('value') or chosen.get('text') or '')))
    return pairs

def _sat_find_curl_schannel():
    for x in (shutil.which('curl.exe'),shutil.which('curl')):
        if not x: continue
        try:
            r=subprocess.run([x,'--version'],capture_output=True,text=True,timeout=10,encoding='utf-8',errors='replace')
            if 'Schannel' in (r.stdout or '')+(r.stderr or ''): return x
        except Exception: pass
    return ''

def _sat_cookie_names(jar):
    out=[]
    try:
        for line in Path(jar).read_text(encoding='utf-8',errors='replace').splitlines():
            if line.startswith('#') or not line.strip(): continue
            c=line.split('\t')
            if len(c)>=7 and c[5] not in out: out.append(c[5])
    except Exception: pass
    return out

def _sat_curl_request(curl,jar,thumb,url,method='GET',form_pairs=None,referer='',output_path=None,timeout_sec=60,cancel_cb=None):
    if cancel_cb and cancel_cb(): raise AuditCancelled('Auditoria cancelada pelo usuário.')
    temp=Path(jar).parent; temp.mkdir(parents=True,exist_ok=True)
    payload=None
    if form_pairs is not None:
        payload=temp/f'payload_{time.time_ns()}.txt'
        from urllib.parse import urlencode
        payload.write_text(urlencode(form_pairs,doseq=True),encoding='utf-8')
    body=Path(output_path) if output_path else temp/f'body_{time.time_ns()}.bin'
    cert_ref='CurrentUser\\MY\\'+re.sub(r'\s+','',str(thumb or '')).upper()
    meta='__EXATO_HTTP__%{http_code}\n__EXATO_REDIRECT__%{redirect_url}\n__EXATO_URL__%{url_effective}\n__EXATO_TYPE__%{content_type}\n'
    cmd=[curl,'--silent','--show-error','--http1.1','--compressed','--connect-timeout','20','--max-time',str(max(10,int(timeout_sec))),'--cert',cert_ref,'--cookie',str(jar),'--cookie-jar',str(jar),'--user-agent','Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153 Safari/537.36','--output',str(body),'--write-out',meta]
    if referer: cmd += ['--referer',referer]
    if method.upper()!='GET': cmd += ['--request',method.upper()]
    if form_pairs is not None: cmd += ['--header','Content-Type: application/x-www-form-urlencoded','--data-binary','@'+str(payload)]
    proc=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,encoding='utf-8',errors='replace')
    started=time.monotonic()
    while proc.poll() is None:
        if cancel_cb and cancel_cb():
            try: proc.terminate()
            except Exception: pass
            raise AuditCancelled('Auditoria cancelada pelo usuário.')
        if time.monotonic()-started>max(10,int(timeout_sec))+5:
            try: proc.kill()
            except Exception: pass
            raise RuntimeError('A comunicação com o SAT excedeu o tempo limite.')
        time.sleep(.15)
    stdout,stderr=proc.communicate(timeout=5)
    status=0; redirect=''; effective=url; ctype=''
    for line in (stdout or '').splitlines():
        if line.startswith('__EXATO_HTTP__'): status=int(re.sub(r'[^0-9]','',line) or 0)
        elif line.startswith('__EXATO_REDIRECT__'): redirect=line.split('__EXATO_REDIRECT__',1)[1].strip()
        elif line.startswith('__EXATO_URL__'): effective=line.split('__EXATO_URL__',1)[1].strip() or effective
        elif line.startswith('__EXATO_TYPE__'): ctype=line.split('__EXATO_TYPE__',1)[1].strip()
    try: data=body.read_bytes()
    except Exception: data=b''
    if payload:
        try: payload.unlink(missing_ok=True)
        except Exception: pass
    return {'status':status,'redirect':redirect,'url':effective,'content_type':ctype,'body':data,'stderr':(stderr or '').strip(),'cookie_names':_sat_cookie_names(jar),'path':str(body)}

def _sat_follow(curl,jar,thumb,url,method='GET',form_pairs=None,referer='',output_path=None,timeout_sec=60,cancel_cb=None,max_hops=8):
