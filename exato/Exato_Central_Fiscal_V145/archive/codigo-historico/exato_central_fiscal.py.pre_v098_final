    value=conn.execute(f"SELECT COALESCE(SUM(CAST(value AS DECIMAL)),0) FROM documents {where} AND status='Autorizado'",args).fetchone()[0] or 0
    by_type={f:conn.execute(f"SELECT COUNT(*) FROM documents {where} AND family=? AND status!='Evento'",args+[f]).fetchone()[0] for f in SUPPORTED_FAMILIES}
