def _sat_direct_cert_session(selected_certificate=None, timeout=60):
    'Primary Windows-native SAT session attempt using the exact certificate.'

    cert=selected_certificate or {}
    thumb=re.sub(r"\s+","",str(cert.get("Thumbprint") or "")).upper()
