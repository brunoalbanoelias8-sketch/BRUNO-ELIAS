$first=Invoke-Get $LoginUrl '' $false
$default=Invoke-Get $DefaultUrl $LoginUrl $true
$chain=@($default);$current=$default
for($i=0;$i -lt 8;$i++){
  if($current.Status -notin 301,302,303,307,308 -or [string]::IsNullOrWhiteSpace($current.Location)){break}
  $next=$current.Location
