    def _audit_rebuild_table(self):
        if not hasattr(self,'audit_tree'): return
        for item in self.audit_tree.get_children(): self.audit_tree.delete(item)
        result=getattr(self,'last_audit_result',None) or {}
        rows=list(result.get('audit_rows') or [])
        term=str(self.audit_search_var.get() or '').strip().casefold()
        filt=str(self.audit_filter_var.get() or 'Todos')
        if filt!='Todos': rows=[r for r in rows if r.get('status')==filt]
        if term:
            rows=[r for r in rows if term in ' '.join([str(r.get('numero') or ''),str(r.get('data') or ''),str(r.get('modelo') or ''),str(r.get('valor_sat') or ''),str(r.get('valor_xml') or ''),str(r.get('observacao') or '')]).casefold()]
        self.audit_filtered_rows=rows
        pages=max(1,(len(rows)+self.audit_page_size-1)//self.audit_page_size)
        self.audit_page=max(0,min(self.audit_page,pages-1))
        start=self.audit_page*self.audit_page_size; subset=rows[start:start+self.audit_page_size]
        self._audit_row_map={}
        for pos,r in enumerate(subset,start):
            tag={'Conforme':'ok','XML não localizado':'missing','Divergência':'diff'}.get(r.get('status'),'')
            iid=f'audit_{pos}'
            self._audit_row_map[iid]=r
            self.audit_tree.insert('', 'end', iid=iid, values=(r.get('status'),r.get('numero'),_format_user_date(r.get('data') or ''),r.get('modelo') or '—',_format_brl(r.get('valor_sat') or 0),'—' if r.get('valor_xml') is None else _format_brl(r.get('valor_xml')),r.get('observacao') or ''), tags=(tag,))
        self._on_audit_selection()
        total=len(result.get('audit_rows') or [])
        if hasattr(self,'audit_table_title_label'):
            statuses={r.get('status') for r in (result.get('audit_rows') or [])}
            problematic = bool(statuses.intersection({'XML não localizado','Divergência'}))
            self.audit_table_title_label.config(text=('Documentos para conferência' if problematic else 'Documentos conciliados'))
        if total:
            self.audit_table_count.config(text=f'({total})')
            shown=len(subset); self.audit_table_hint.config(text=f'Exibindo {start+1}–{start+shown} de {len(rows)} documento(s) filtrado(s).')
        else:
            self.audit_table_count.config(text='(0)'); self.audit_table_hint.config(text='Nenhum documento disponível para exibição.')
        self.audit_page_label.config(text=f'{self.audit_page+1} / {pages}')
        self.audit_prev_btn.config(state='normal' if self.audit_page>0 else 'disabled'); self.audit_next_btn.config(state='normal' if self.audit_page<pages-1 else 'disabled')

