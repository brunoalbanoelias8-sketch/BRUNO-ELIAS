def _pdf_wrapped_lines(text, font, size, max_width, canvas):
    words=str(text or '').split()
    if not words: return []
    lines=[]; cur=''
    for word in words:
        test=word if not cur else cur+' '+word
        if canvas.stringWidth(test,font,size)<=max_width:
            cur=test
        else:
            if cur: lines.append(cur)
            cur=word
    if cur: lines.append(cur)
    return lines


def _normalize_export_direction(value):
    """Normalize document movement to the two user-facing export folders."""
    text = unicodedata.normalize('NFKD', str(value or '')).encode('ascii', 'ignore').decode('ascii').casefold().strip()
    if text in {'e', 'ent', 'entrada', 'entradas'} or any(token in text for token in ('entrada', 'recebid', 'destinat')):
        return 'Entrada'
    if text in {'s', 'sai', 'saida', 'saidas'} or any(token in text for token in ('saida', 'emitid', 'emitente')):
        return 'Saída'
    return ''


def _resolve_document_export_direction(doc, xml_bytes, cnpj_digits, family_hint=''):
    """Resolve Entrada/Saída from stored metadata, with XML as a safe fallback."""
    explicit = _normalize_export_direction(doc.get('direcao') or doc.get('direction'))
    if explicit:
        return explicit
    try:
        meta = _parse_document_metadata(xml_bytes, cnpj_digits, family_hint or doc.get('family') or '') or {}
        parsed = _normalize_export_direction(meta.get('direcao'))
        if parsed:
            return parsed
    except Exception:
        pass
    return ''


