   }
  }
 }catch{}
 Start-Sleep -Milliseconds 120
}
try{[IO.File]::WriteAllText($ResultPath,($result|ConvertTo-Json -Compress))}catch{}
'''
    match_json=json.dumps(variants,ensure_ascii=False)
    b64=base64.b64encode(ps.encode('utf-8')).decode('ascii')
    command=("$s=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('"+b64+"'));$sb=[ScriptBlock]::Create($s);& $sb "+f"-MatchJson '{match_json.replace(chr(39),chr(39)+chr(39))}' -TimeoutSec {int(timeout_sec)} -ResultPath '{result_path.replace(chr(39),chr(39)+chr(39))}'")
    flags=getattr(subprocess,'CREATE_NO_WINDOW',0x08000000)
    try:
        proc=subprocess.Popen(['powershell.exe','-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-WindowStyle','Hidden','-Command',command],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,creationflags=flags)
        return proc,result_path
    except Exception: return None,None

def _sat_read_certificate_monitor(proc, result_path):
    try:
        if proc and proc.poll() is None:
            return {}
        if result_path and Path(result_path).exists():
            return json.loads(Path(result_path).read_text(encoding='utf-8',errors='replace') or '{}')
    except Exception: pass
    return {}


def _sat_stop_certificate_monitor(proc, result_path):
    try:
        if proc and proc.poll() is None: proc.terminate()
    except Exception: pass
    data=_sat_read_certificate_monitor(proc,result_path)
    try:
        if result_path: Path(result_path).unlink(missing_ok=True)
    except Exception: pass
    return data


def _sat_browser_auth_session(pw, selected_certificate=None, timeout_ms=90000, download_dir=None):
    """Reproduce the manual SAT flow with a policy attempt and a native-dialog attempt."""
    cert=selected_certificate or {}
    identity=_sat_windows_certificate_identity(cert)
    filt=_sat_build_certificate_filter(cert)
    if not identity.get('Thumbprint'):
        raise RuntimeError('Não foi possível identificar o certificado selecionado no Windows.')
    if os.name!='nt':
        raise RuntimeError('A autenticação automática do SAT requer Windows/Edge.')
    root=Path(download_dir or APP_DIR/'SAT_AUDITORIA'); root.mkdir(parents=True,exist_ok=True)
    attempts=[]
    try:
        (root/'CERTIFICADO_SAT_IDENTIDADE.json').write_text(json.dumps(identity,ensure_ascii=False,indent=2),encoding='utf-8')
    except Exception:
        pass
    for attempt_no,use_policy in enumerate((True,False),start=1):
        profile_dir=root/f'EDGE_PROFILE_{attempt_no}'; profile_dir.mkdir(parents=True,exist_ok=True)
        netlog=str(root/f'EDGE_NETLOG_{attempt_no}.json')
        policy_token=None; monitor_proc=None; monitor_path=None; context=None; browser=None
        policy_mode='native-dialog'
        args=['--start-minimized','--disable-popup-blocking','--no-first-run','--no-default-browser-check','--disable-extensions','--window-size=1280,800',f'--log-net-log={netlog}','--net-log-capture-mode=Default']
        if use_policy and filt:
            policy={'pattern':'https://sat.sef.sc.gov.br/*','filter':filt}
            try:
                policy_token=_sat_install_edge_autoselect_policy(policy)
                policy_mode='registry'
            except Exception as exc:
                (root/f'EDGE_POLICY_ERROR_{attempt_no}.txt').write_text(str(exc),encoding='utf-8')
                policy_mode='native-fallback'
        try:
            context=pw.chromium.launch_persistent_context(str(profile_dir),channel='msedge',headless=False,args=args,accept_downloads=True,downloads_path=str(root),viewport={'width':1280,'height':800})
            page=context.pages[0] if context.pages else context.new_page()
            monitor_proc,monitor_path=_sat_start_native_certificate_monitor(cert,timeout_sec=max(35,int(timeout_ms/1000)+5),result_path=str(root/f'CERT_DIALOG_{attempt_no}.json'))
            page.goto(SAT_LOGIN_URL,wait_until='domcontentloaded',timeout=60000)
            page.wait_for_timeout(1000)
            if _sat_is_applications_page(page): return browser,context,page,filt,policy_mode,policy_token
            if not _sat_select_certificate_login(page): raise RuntimeError('O SAT não apresentou o botão "Entrar com Certificado Digital".')
            deadline=time.monotonic()+timeout_ms/1000.0; urls=[]
            while time.monotonic()<deadline:
                for p in list(context.pages):
                    try:
                        url=getattr(p,'url','') or ''
                        if url and url not in urls: urls.append(url)
                        if _sat_is_applications_page(p):
                            mon=_sat_stop_certificate_monitor(monitor_proc,monitor_path)
                            (root/f'AUTH_ATTEMPT_{attempt_no}.json').write_text(json.dumps({'attempt':attempt_no,'policy_mode':policy_mode,'identity':identity,'filter':filt,'monitor':mon,'urls':urls[-10:]},ensure_ascii=False,indent=2),encoding='utf-8')
                            return browser,context,p,filt,policy_mode,policy_token
                    except Exception: pass
                try: page.wait_for_timeout(350)
                except Exception: time.sleep(0.35)
            mon=_sat_stop_certificate_monitor(monitor_proc,monitor_path)
            attempts.append(f'#{attempt_no} {policy_mode}: não chegou a Apps; dialog={json.dumps(mon,ensure_ascii=False)} urls={urls[-5:]}')
        except Exception as exc:
            mon=_sat_stop_certificate_monitor(monitor_proc,monitor_path)
            attempts.append(f'#{attempt_no} {policy_mode}: {exc}; dialog={json.dumps(mon,ensure_ascii=False)}')
        finally:
            try:
                if context: context.close()
            except Exception: pass
            try:
                if browser: browser.close()
            except Exception: pass
            try: _sat_remove_edge_autoselect_policy(policy_token)
            except Exception: pass
    raise RuntimeError('Falha na autenticação automática do SAT. '+' | '.join(attempts))

def sat_fetch_excel_automatic(cnpj,date_from,date_to,selected_certificate=None,progress_cb=None,cancel_cb=None):
    cnpj_digits=re.sub(r'\D','',str(cnpj or '')); root=APP_DIR/'SAT_AUDITORIA'; root.mkdir(parents=True,exist_ok=True)
    download_dir=root/f'{cnpj_digits}_{datetime.now().strftime("%Y%m%d_%H%M%S")}'; download_dir.mkdir(parents=True,exist_ok=True)
    auth=_sat_direct_curl_auth(selected_certificate or {},download_dir,progress_cb,cancel_cb); sess=auth['session']; collected=[]; query_log=[]
    for idx,(doc,direction) in enumerate(((d,x) for d in ('NF-e','NFC-e') for x in ('Emitente','Destinatário')),1):
        if cancel_cb and cancel_cb(): raise AuditCancelled('Auditoria cancelada pelo usuário.')
        rows,rec=_sat_direct_consult(sess,cnpj_digits,date_from,date_to,doc,direction,download_dir,idx,progress_cb,cancel_cb); collected.extend(rows or []); query_log.append(rec)
    seen=set(); rows=[]
    for r in collected:
        k=_audit_key(r) or '|'.join(str(r.get(x) or '') for x in ('numero','data','valor','tipo_documento','operacao'))
        if k in seen: continue
        seen.add(k); rows.append(r)
    try:
        (download_dir/'CONSULTAS_SAT.json').write_text(json.dumps({'consultas':query_log,'auth':auth.get('attempts') or []},ensure_ascii=False,indent=2),encoding='utf-8')
        (download_dir/'CERTIFICADO_SAT_IDENTIDADE.json').write_text(json.dumps(_sat_windows_certificate_identity(selected_certificate or {}),ensure_ascii=False,indent=2),encoding='utf-8')
    except Exception: pass
    return {'rows':rows,'files':sorted(str(x) for x in download_dir.glob('*.xlsx')),'download_dir':str(download_dir),'query_log':query_log}


def _audit_xml_rows(cnpj, date_from='', date_to='', family=''):
    """Load the local XML universe using indexed DB metadata first.

    The V083 routine reparsed every XML even though the database already stores
    number/date/value/access-key/direction. With large fiscal archives this made
    the Auditoria appear to hang. V084 uses the persisted metadata and only
    falls back to XML parsing when a required field is missing.
    """
    rows = db_list_documents(cnpj=cnpj, family=family, date_from=date_from, date_to=date_to, limit=1000000)
    result=[]
    for row in rows:
        if row.get('status') == 'Evento' or row.get('doc_type') == 'Evento':
            continue
        fam = row.get('family') or family or ''
        parsed = {}
        numero = str(row.get('number') or '').strip()
        data = str(row.get('issued_at') or '')[:10]
        valor = row.get('value')
        chave = _normalize_access_key(row.get('access_key') or '')
        serie = str(row.get('series') or '').strip()
        direcao = row.get('direction') or ''
        tipo = row.get('doc_type') or fam or ''
        if not numero or not data or valor in (None, '') or not chave or not direcao or not tipo:
            parsed = _parse_report_document(row.get('xml') or b'', cnpj, fam) or {}
        numero = str(parsed.get('numero') or numero).strip().lstrip('0') or '0'
        data = str(parsed.get('data') or data)[:10]
        valor_raw = parsed.get('valor') if parsed.get('valor') is not None else (valor if valor not in (None,'') else 0)
        valor = _audit_clean_decimal(valor_raw)
        chave = _normalize_access_key(row.get('access_key') or parsed.get('chave') or '')
        serie = str(parsed.get('serie') or serie).strip()
        tipo = parsed.get('tipo') or tipo
        direcao = parsed.get('direcao') or direcao or 'Entrada'
        result.append({
            'numero': numero,
            'data': data,
            'valor': valor,
            'chave': chave,
            'serie': serie,
            'tipo': tipo,
            'direcao': direcao,
            'status': row.get('status') or parsed.get('status') or 'Autorizado',
        })
    return result

def _normalize_access_key(value):
    digits = re.sub(r'\D','',str(value or ''))
    if len(digits) >= 44:
        return digits[-44:]
    return digits


def _audit_family(value):
    text = str(value or '').strip().casefold().replace(' ', '').replace('_','').replace('-','')
    if text in {'nfe','55','notaeletronica'}:
        return 'nfe'
    if text in {'nfce','65','notaconsumidor','notafiscalconsumidor'}:
        return 'nfce'
    if text in {'cte','57','conhecimentotransporte'}:
        return 'cte'
    return ''


def _audit_key(row):
    key = _normalize_access_key(row.get('chave') or '')
    if len(key) == 44:
        return ('chave', key)
    return _audit_fallback_key(row)


def _audit_fallback_key(row):
    direction = _normalize_audit_direction(row.get('operacao') or row.get('direcao') or '')
    family = _audit_family(row.get('tipo_documento') or row.get('tipo') or '')
    return (
        'combinada',
        str(row.get('numero') or '').lstrip('0') or '0',
        str(row.get('serie') or ''),
        str(row.get('data') or '')[:10],
        family,
        direction,
    )


def _normalize_audit_direction(value):
    text=str(value or '').strip().casefold()
    if any(token in text for token in ('entrada','recebid','destinat')): return 'entrada'
    if text in {'e','ent','entrada'} or any(token in text for token in ('entrada','recebid','destinat')): return 'entrada'
    if text in {'s','sai','saida','saída'} or any(token in text for token in ('saida','saída','emitid','emitente')): return 'saida'
    return ''


def _audit_clean_decimal(value):
    try:
        return Decimal(str(value or '0')).quantize(Decimal('0.01'))
    except Exception:
        return Decimal('0.00')


def _audit_display_family(value):
    family = _audit_family(value)
    return {'nfe': 'NF-e', 'nfce': 'NFC-e', 'cte': 'CT-e'}.get(family, str(value or '—'))


def _audit_pt(count, singular, plural=None):
    plural = plural or singular + 's'
    return singular if int(count or 0) == 1 else plural


def _audit_compare_pair(sat_row, xml_row):
    differences=[]
    sat_number=str(sat_row.get('numero') or '').lstrip('0') or '0'
    xml_number=str(xml_row.get('numero') or '').lstrip('0') or '0'
    sat_date=str(sat_row.get('data') or '')[:10]
    xml_date=str(xml_row.get('data') or '')[:10]
    sat_value=_audit_clean_decimal(sat_row.get('valor'))
    xml_value=_audit_clean_decimal(xml_row.get('valor'))
    if sat_number != xml_number:
        differences.append({'kind':'numero','label':'Número','detail':f'SAT {sat_number} × XML {xml_number}'})
    if sat_date != xml_date:
        differences.append({'kind':'data','label':'Data','detail':f'SAT {_format_user_date(sat_date)} × XML {_format_user_date(xml_date)}'})
    diff=sat_value-xml_value
    if abs(diff) > Decimal('0.01'):
        differences.append({'kind':'valor','label':'Valor','detail':f'SAT {_format_brl(sat_value)} × XML {_format_brl(xml_value)} ({_format_brl(diff)})'})
    return differences, diff


def _audit_build_rows(result):
    rows=[]
    for sr in result.get('sat_rows') or []:
        xr = None
        key = sr.get('_match_key')
        if key is not None:
            xr = result.get('_xml_by_match_key', {}).get(key)
        diffs=[]
        if xr is not None:
            diffs, _ = _audit_compare_pair(sr, xr)
        if xr is None:
            status='XML não localizado'
            observation='XML não localizado na Central.'
        elif diffs:
            status='Divergência'
            observation=' • '.join(d['detail'] for d in diffs)
        else:
            status='Conforme'
            observation='Valores e dados principais conferem.'
        rows.append({
            'status': status,
            'numero': str(sr.get('numero') or ''),
            'data': str(sr.get('data') or '')[:10],
            'modelo': _audit_display_family(sr.get('tipo_documento') or sr.get('tipo') or result.get('family') or '—'),
            'valor_sat': _audit_clean_decimal(sr.get('valor')),
            'valor_xml': _audit_clean_decimal(xr.get('valor')) if xr is not None else None,
            'observacao': observation,
            'chave': _normalize_access_key(sr.get('chave') or ''),
            'serie': str(sr.get('serie') or ''),
            'direction': _normalize_audit_direction(sr.get('operacao') or ''),
            'xml': xr,
            'differences': diffs,
        })
    return rows


def _find_local_audit_document(cnpj, audit_row):
    """Resolve an audit row to the original local fiscal document without changing the audit engine."""
    row = audit_row or {}
    cnpj_digits = re.sub(r'\D', '', str(cnpj or ''))
    if len(cnpj_digits) != 14:
        return None
    family = _audit_family(row.get('modelo') or row.get('tipo_documento') or row.get('tipo') or '')
    if family not in ('nfe', 'nfce'):
        return None

    target_key = _normalize_access_key(row.get('chave') or '')
    target_number = str(row.get('numero') or '').strip().lstrip('0') or '0'
    target_date = str(row.get('data') or '')[:10]
    target_series = str(row.get('serie') or '').strip()
    candidates = []

    # Prefer the access key because it is the strongest identifier.
    if len(target_key) == 44:
        candidates = db_list_documents(cnpj=cnpj_digits, family=family, query=target_key, limit=50)
    if not candidates and target_number:
        candidates = db_list_documents(cnpj=cnpj_digits, family=family, query=target_number, limit=500)

    for candidate in candidates:
        ckey = _normalize_access_key(candidate.get('access_key') or candidate.get('chave') or '')
        cnumber = str(candidate.get('number') or '').strip().lstrip('0') or '0'
        cdate = str(candidate.get('issued_at') or candidate.get('data') or '')[:10]
        cseries = str(candidate.get('series') or candidate.get('serie') or '').strip()

        if target_key and len(target_key) == 44 and ckey == target_key:
            return candidate
        if cnumber != target_number:
            continue
        if target_date and cdate and cdate != target_date:
            continue
        if target_series and cseries and cseries != target_series:
            continue
        if candidate.get('xml'):
            return candidate
    return None



def _exato_ia_recent_texts(company_name='', family=''):
    """Return recent IA texts for anti-repetition while keeping the audit engine untouched."""
    try:
        entries=_audit_history_load()
    except Exception:
        entries=[]
    company_digits=re.sub(r'\D','',str(company_name or ''))
    wanted_family=str(family or '').strip()
    out=[]
    for item in reversed(entries[-12:]):
        if wanted_family and str(item.get('family') or '') not in ('',wanted_family):
            continue
        if company_digits:
            other=re.sub(r'\D','',str(item.get('cnpj') or ''))
            if other and other!=company_digits:
                continue
        ai=item.get('ai_analysis') or {}
        for key in ('title','callout','message'):
            txt=str(ai.get(key) or '').strip()
            if txt: out.append(txt)
    return out


def _exato_ia_pick(options, seed, recent=None):
    options=list(options or [])
    if not options: return ''
    recent=set(str(x).strip() for x in (recent or []))
    digest=hashlib.sha256(str(seed).encode('utf-8')).hexdigest()
    start=int(digest[:8],16)%len(options)
    for step in range(len(options)):
        cand=options[(start+step)%len(options)]
        if cand not in recent:
            return cand
    return options[start]


def _exato_ia_pct(part,total):
    try:
        p=Decimal(str(part or 0)); t=Decimal(str(total or 0))
        return (p/t*Decimal('100')) if t>0 else Decimal('0')
    except Exception:
        return Decimal('0')


def _exato_ia_dashboard_summary(stats, failed=None, audits=None, company=''):
    """Short operational IA summary for the home dashboard, built only from local evidence."""
    stats=stats or {}; failed=failed or []; audits=audits or []
    total=int(stats.get('total') or 0); authorized=int(stats.get('authorized') or 0); pending=len(failed)
    if not total:
        return 'Ainda não há documentos suficientes para eu analisar a movimentação. Faça uma busca de XML para eu começar.'
    clauses=[]
    if pending:
        clauses.append(f'{pending} atualização(ões) recente(s) merecem atenção')
    else:
        clauses.append('as últimas atualizações registradas não apresentam falhas')
    if authorized and total:
        coverage=_exato_ia_pct(authorized,total)
        clauses.append(f'{coverage:.0f}% dos documentos locais estão autorizados')
    if audits:
