def run_local_audit(cnpj='', date_from='', date_to=''):
    """First audit engine: local consistency checks. SAT x XML connector plugs into this engine later."""
    cnpj_digits=re.sub(r'\D','',str(cnpj or ''))
    rows=db_list_documents(cnpj=cnpj_digits,date_from=date_from,date_to=date_to,limit=1000000)
    actual=[r for r in rows if r.get('status')!='Evento' and r.get('doc_type')!='Evento']
    findings=[]
    key_counts={}
    for r in actual:
        k=r.get('access_key') or ''
        if k: key_counts[k]=key_counts.get(k,0)+1
        if not r.get('xml'): findings.append({'severity':'critical','title':'XML ausente','detail':f"Documento {r.get('number') or '-'} sem conteúdo XML armazenado."})
    for k,count in key_counts.items():
        if count>1: findings.append({'severity':'warning','title':'Chave duplicada','detail':f'Chave {k} aparece {count} vezes na base.'})
    event_rows=[r for r in rows if r.get('status')=='Evento' or r.get('doc_type')=='Evento']
    keys={r.get('access_key') for r in actual if r.get('access_key')}
    orphan_events=sum(1 for r in event_rows if r.get('access_key') and r.get('access_key') not in keys)
    if orphan_events: findings.append({'severity':'warning','title':'Eventos sem documento principal','detail':f'{orphan_events} evento(s) não encontraram o documento principal na base.'})
    return {'ok':True,'documents':len(actual),'findings':findings,'orphan_events':orphan_events,'note':'O motor está preparado para SAT × XML; a primeira implementação desta versão audita a integridade da base local.'}


