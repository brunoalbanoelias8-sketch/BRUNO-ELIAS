def _sat_direct_curl_auth(selected_certificate,root_dir,progress_cb=None,cancel_cb=None):
    thumb=re.sub(r'\s+','',str((selected_certificate or {}).get('Thumbprint') or '')).upper()
    if os.name!='nt': raise RuntimeError('A autenticação sem navegador está disponível somente no Windows.')
    if not thumb: raise RuntimeError('O certificado selecionado não possui thumbprint válido.')
    curl=_sat_find_curl_schannel()
    if not curl: raise RuntimeError('curl.exe com suporte Schannel não foi encontrado no Windows.')
    root=Path(root_dir); root.mkdir(parents=True,exist_ok=True); jar=root/'SAT_COOKIES.txt'
    try: jar.unlink(missing_ok=True)
    except Exception: pass
    if progress_cb: progress_cb('Autenticando no SAT com o certificado já selecionado no Central...')
    login,cl=_sat_follow(curl,jar,thumb,SAT_LOGIN_URL,timeout_sec=45,cancel_cb=cancel_cb)
    attempts=[{'rota':'Login','status':login['status'],'url':login['url'],'cookies':login['cookie_names']}]
    if _sat_is_apps_html(login['url'],login['body']): return {'session':{'curl':curl,'jar':str(jar),'thumbprint':thumb},'attempts':attempts}
    if progress_cb: progress_cb('Testando default.aspx com o certificado do Windows...')
    default,cd=_sat_follow(curl,jar,thumb,SAT_DEFAULT_URL,referer=SAT_LOGIN_URL,timeout_sec=45,cancel_cb=cancel_cb)
    attempts.append({'rota':'default.aspx','status':default['status'],'url':default['url'],'cookies':default['cookie_names']})
    if _sat_is_apps_html(default['url'],default['body']): return {'session':{'curl':curl,'jar':str(jar),'thumbprint':thumb},'attempts':attempts}
    cert_auth=f'{SAT_ORIGIN}/tax.NET/CertificateAuth.ashx?Thumbprint={thumb}'
    if progress_cb: progress_cb('Testando a autenticação interna do SAT, ainda sem navegador...')
    auth,ca=_sat_follow(curl,jar,thumb,cert_auth,referer=SAT_LOGIN_URL,timeout_sec=45,cancel_cb=cancel_cb)
    attempts.append({'rota':'CertificateAuth','status':auth['status'],'url':auth['url'],'cookies':auth['cookie_names']})
    if _sat_is_apps_html(auth['url'],auth['body']): return {'session':{'curl':curl,'jar':str(jar),'thumbprint':thumb},'attempts':attempts}
    apps,capp=_sat_follow(curl,jar,thumb,SAT_APPS_URL,referer=auth['url'] or default['url'],timeout_sec=45,cancel_cb=cancel_cb)
    attempts.append({'rota':'Apps.aspx','status':apps['status'],'url':apps['url'],'cookies':apps['cookie_names']})
    if _sat_is_apps_html(apps['url'],apps['body']): return {'session':{'curl':curl,'jar':str(jar),'thumbprint':thumb},'attempts':attempts}
    (root/'AUTH_NO_BROWSER_DIAGNOSTIC.json').write_text(json.dumps({'attempts':attempts},ensure_ascii=False,indent=2),encoding='utf-8')
    raise RuntimeError(f'O SAT não reconheceu a sessão sem navegador. Última URL: {apps["url"]}; HTTP {apps["status"]}; cookies: {len(apps["cookie_names"])}.')

def _sat_parse_result_table(html):
    class T(HTMLParser):
        def __init__(self): super().__init__(convert_charrefs=True); self.tables=[]; self.t=None; self.r=None; self.c=None
        def handle_starttag(self,tag,attrs):
            tag=tag.lower()
            if tag=='table' and self.t is None: self.t=[]
            elif self.t is not None and tag=='tr': self.r=[]
            elif self.t is not None and tag in ('td','th') and self.r is not None: self.c=[]
        def handle_data(self,data):
            if self.c is not None: self.c.append(unescape(data))
        def handle_endtag(self,tag):
            tag=tag.lower()
            if self.t is not None and tag in ('td','th') and self.c is not None: self.r.append(re.sub(r'\s+',' ',' '.join(self.c)).strip()); self.c=None
            elif self.t is not None and tag=='tr' and self.r is not None: self.t.append(self.r); self.r=None
            elif tag=='table' and self.t is not None: self.tables.append(self.t); self.t=None
    q=T(); q.feed(html or '')
    for rows in q.tables:
        if not rows: continue
        h=[_sat_norm_text(x) for x in rows[0]]
        def find(*pats):
            for i,x in enumerate(h):
                if any(p in x for p in pats): return i
            return None
        i_num=find('nº do documento','n° do documento','numero do documento'); i_date=find('emissão','emissao'); i_val=find('valor total','valor total (r$)','valor')
        if None in (i_num,i_date,i_val): continue
        out=[]
        for row in rows[1:]:
            if len(row)<=max(i_num,i_date,i_val): continue
            num=re.sub(r'\D','',row[i_num])
            if not num: continue
            rv=re.sub(r'[^0-9,.-]','',row[i_val]).replace('.','').replace(',','.')
            try: val=Decimal(rv or '0')
            except Exception: val=Decimal('0')
            out.append({'numero':num.lstrip('0') or '0','data':row[i_date],'valor':val,'chave':'','serie':'','situacao':'','tipo_documento':'','operacao':''})
        return out
    return []

