            except RuntimeError:
                pass
        threading.Thread(target=worker,daemon=True).start()

    def _apply_dashboard_stats(self,stats,company='',failed=None,runs=None,audits=None):
        if not hasattr(self,'dash_values'): return
        current_cnpj=re.sub(r'\D','', self.cnpj_var.get().strip()) if hasattr(self,'cnpj_var') else ''
        if not current_cnpj:
            for key in ('value','entries','outputs','total','authorized','pending'):
                self.dash_values[key].config(text='—')
            self.dash_context.config(text='Nenhuma empresa selecionada. Confirme um CNPJ para visualizar os dados fiscais.')
            self.dash_ratio_label.config(text='Aguardando empresa')
            self.dash_ratio_canvas.delete('all')
            self.dash_ratio_canvas.create_rectangle(0,4,max(self.dash_ratio_canvas.winfo_width(),400),20,fill='#EEF2F6',outline='')
            self.dash_attention.config(text='Confirme o CNPJ da empresa em Documentos fiscais para carregar o painel.',fg=MUTED)
            return
        if not current_cnpj:
            if hasattr(self,'dash_smart'): self.dash_smart.config(text='Selecione uma empresa para que eu leia a movimentação, atualizações e ocorrências recentes.')
            if hasattr(self,'dash_activity'): self.dash_activity.config(text='Nenhuma atividade disponível sem uma empresa selecionada.')
            return
        entries_value=Decimal(str(stats.get('entries_value') or 0)); outputs_value=Decimal(str(stats.get('outputs_value') or 0)); total_value=Decimal(str(stats.get('value') or 0))
        self.dash_values['total'].config(text=f"{stats['total']:,}".replace(',','.'))
        self.dash_values['authorized'].config(text=f"{stats['authorized']:,}".replace(',','.'))
        self.dash_values['pending'].config(text=str(len(failed or [])))
        self.dash_values['entries'].config(text=_format_brl(entries_value))
        self.dash_values['outputs'].config(text=_format_brl(outputs_value))
        self.dash_values['value'].config(text=_format_brl(total_value))
        last=_format_user_date((stats.get('last_sync') or '')[:10]) + (f" {str(stats.get('last_sync'))[11:16]}" if stats.get('last_sync') and len(str(stats.get('last_sync')))>=16 else '')
        self.dash_context.config(text=f"Empresa ativa: {company or 'Nenhuma empresa selecionada'}   |   CNPJ: {_format_cnpj(self.cnpj_var.get()) if hasattr(self,'cnpj_var') and self.cnpj_var.get().strip() else '—'}   |   Última atualização: {last or '—'}")
        if total_value > 0:
            diff_value=abs(outputs_value-entries_value)
            lead='saídas' if outputs_value>entries_value else ('entradas' if entries_value>outputs_value else 'equilíbrio')
            self.dash_ratio_label.config(text=f"Entradas {_format_brl(entries_value)}  •  Saídas {_format_brl(outputs_value)}  •  Diferença {_format_brl(diff_value)}")
        else:
            lead='equilíbrio'
            self.dash_ratio_label.config(text='Nenhuma movimentação autorizada no período')
        self.dash_ratio_canvas.delete('all')
        self.dash_ratio_canvas.update_idletasks(); w=max(self.dash_ratio_canvas.winfo_width(),400); h=28
        split=float(entries_value/total_value) if total_value>0 else 0.5
        self.dash_ratio_canvas.create_rectangle(0,4,w,22,fill='#EEF2F6',outline='')
        self.dash_ratio_canvas.create_rectangle(0,4,int(w*split),22,fill=NFE_ACCENT,outline='')
        self.dash_ratio_canvas.create_rectangle(int(w*split),4,w,22,fill=NFCE_ACCENT,outline='')
        cert_warning=''
        try:
            na=str((self.selected or {}).get('NotAfter') or '')
            if na:
                exp=datetime.fromisoformat(na.replace('Z','+00:00')).replace(tzinfo=None)
                days=(exp-datetime.now()).days
                if days < 0: cert_warning='O certificado selecionado está expirado.'
                elif days <= 30: cert_warning=f'O certificado selecionado vence em {days} dia(s). Vale revisar a renovação.'
        except Exception: pass
        if failed:
            msg='Há registros recentes que merecem atenção. Abra Pendências ou Histórico para verificar.'
            if cert_warning: msg += '  ' + cert_warning
            self.dash_attention.config(text=msg,fg='#B54708')
        elif cert_warning:
            self.dash_attention.config(text=cert_warning,fg='#B54708')
        elif not company:
            self.dash_attention.config(text='Nenhuma empresa selecionada. Confirme o CNPJ em Documentos fiscais para visualizar o painel.',fg=MUTED)
        else:
            self.dash_attention.config(text='Tudo certo por enquanto. Nenhuma ocorrência relevante foi encontrada nas últimas sincronizações.',fg=GREEN)
        total=int(stats.get('total') or 0); pending_count=len(failed or [])
        smart=_exato_ia_dashboard_summary(stats,failed,audits,company)
        if hasattr(self,'dash_smart'): self.dash_smart.config(text=smart,fg=(ORANGE if pending_count else TEXT))
        timeline=[]
        for r in (runs or [])[:3]:
            status='OK' if str(r.get('status') or '').casefold()=='concluído' else 'ATENÇÃO'
            stamp=str(r.get('started_at') or '').replace('T',' ')
            timeline.append((stamp,f"{status}  Busca XML • {int(r.get('total_found') or 0)} documento(s)"))
        for a in (audits or [])[:2]:
            label='Conforme' if a.get('status')=='conforme' else ('Divergência' if a.get('status')=='divergencia' else 'Atenção')
            stamp=str(a.get('timestamp') or '').replace('T',' ')
            timeline.append((stamp,f"{label}  Auditoria • {int(a.get('sat_count') or 0)} documento(s)"))
        timeline.sort(key=lambda item:item[0],reverse=True)
        activity_lines=[f"• {stamp}  {event}" for stamp,event in timeline[:5]]
        if hasattr(self,'dash_activity'): self.dash_activity.config(text='\n'.join(activity_lines) if activity_lines else 'Nenhuma atividade registrada ainda.',fg=TEXT if activity_lines else MUTED)

