    def _refresh_dashboard_async(self):
        if not hasattr(self,'dash_values'): return
        cnpj=re.sub(r'\D','',self.cnpj_var.get().strip()) if hasattr(self,'cnpj_var') else ''
        def worker():
            try: stats=db_get_stats(cnpj); company=db_get_company_name(cnpj); runs=db_list_runs(20,cnpj); failed=[r for r in runs if r.get('error_text') or r.get('status') in ('Concluído com observações','Não concluído','Cancelado')]; audits=[a for a in _audit_history_load() if not cnpj or re.sub(r'\D','',str(a.get('cnpj') or ''))==cnpj]
            except Exception: return
            try:
