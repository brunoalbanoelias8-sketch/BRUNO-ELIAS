def save_documents_organized(documents, base_folder, cnpj, config_data=None, selected_cert=None,
                              run_legacy_migration=False, generate_companion_pdf=True, period_start='', period_end=''):
    """Export XMLs as Empresa → Ano → Mês → Entrada/Saída → tipo, with each PDF beside its XML."""
    base=Path(base_folder); saved=[]; errors=[]
    cnpj_digits=re.sub(r'\D','',str(cnpj or ''))
    company_name=db_reconcile_company_name(cnpj_digits, limit=100) or db_get_company_name(cnpj_digits)
    if not company_name:
        company_name=str((config_data or {}).get('company_names',{}).get(cnpj_digits) or '').strip()
    company_name=_safe_filename(company_name or f'Empresa_{cnpj_digits or "nao_identificada"}')

    docs=[]
    for doc in (documents or []):
        d=str(doc.get('data') or doc.get('issued_at') or '')[:10]
        if period_start and (not d or d < str(period_start)[:10]): continue
        if period_end and (not d or d > str(period_end)[:10]): continue
        docs.append(doc)
    docs=_sort_document_exports(docs)

    for idx,doc in enumerate(docs,1):
        try:
            xml=doc.get('xml') or b''
            if isinstance(xml,memoryview): xml=xml.tobytes()
            if not isinstance(xml,(bytes,bytearray)): xml=bytes(xml)
            if not xml: raise ValueError('XML vazio')
            xml_bytes=bytes(xml)
            family_hint=str(doc.get('family') or '').casefold()
            direction=_resolve_document_export_direction(doc,xml_bytes,cnpj_digits,family_hint)
            if not direction:
                raise ValueError('Não foi possível identificar com segurança se o documento é de Entrada ou Saída.')
            dtype=str(doc.get('family') or doc.get('doc_type') or doc.get('tipo') or 'Documento').casefold()
            dtype={'nfe':'NF-e','nfce':'NFC-e','cte':'CT-e','nfeproc':'NF-e','nfceproc':'NFC-e','cteproc':'CT-e'}.get(dtype,dtype)
            if dtype not in ('NF-e','NFC-e','CT-e'):
                m=_parse_document_metadata(xml_bytes,cnpj_digits,doc.get('family') or '')
                dtype=m.get('tipo') or dtype
            if dtype not in ('NF-e','NFC-e','CT-e'):
                raise ValueError(f'Tipo documental não identificado: {dtype or "desconhecido"}')
            date_value=str(doc.get('data') or doc.get('issued_at') or '')[:10]
            year=date_value[:4] if len(date_value)==10 and date_value[4]=='-' else 'Sem data'
            month_num=date_value[5:7] if len(date_value)==10 and date_value[4]=='-' else '00'
            month_name=_FISCAL_PDF_MONTHS.get(month_num,'Sem mês')
            month_root=base/company_name/_safe_filename(year)/_safe_filename(f'{month_num} - {month_name}')
            folder=month_root/_safe_filename(direction)/_safe_filename(dtype)
            folder.mkdir(parents=True,exist_ok=True)
            family={'NF-e':'nfe','NFC-e':'nfce','CT-e':'cte'}[dtype]
            access_key=_safe_filename(doc.get('chave') or doc.get('access_key') or '')
            number=_safe_filename(doc.get('numero') or doc.get('number') or str(idx))
            prefix={'NF-e':'NFe','NFC-e':'NFCe','CT-e':'CTe'}.get(dtype,'DOC')
            target=folder/(f'{access_key}.xml' if access_key and access_key!='documento' else f'{prefix}_{number}.xml')
            if target.exists() and target.read_bytes()!=xml_bytes:
                n=2
                while True:
                    alt=folder/f'{target.stem}_{n}{target.suffix}'
                    if not alt.exists(): target=alt; break
                    n+=1
            target.write_bytes(xml_bytes)
            saved.append(str(target))

            if generate_companion_pdf:
                pdf_target=target.with_suffix('.pdf')
                if not pdf_target.exists() or pdf_target.stat().st_size<1000:
                    payload={'family':family,'direcao':direction,'data':date_value,'numero':doc.get('numero') or doc.get('number') or number,'serie':doc.get('serie') or doc.get('series') or '','chave':doc.get('chave') or doc.get('access_key') or '','xml':xml_bytes}
                    generate_fiscal_representation_pdf([payload],str(pdf_target),family=family)
                saved.append(str(pdf_target))
        except Exception as exc:
            errors.append(f'Documento {idx}: {type(exc).__name__}: {exc}')
    return saved, errors

def _safe_filename(value):
    # Preserve accented Portuguese characters while removing only characters
    # forbidden by Windows/macOS/Linux filenames.
    value = re.sub(r'[<>:"/\\|?*\x00-\x1F]+', '_', str(value or '')).strip(' .')
    value = re.sub(r'\s{2,}', ' ', value)
    return value or 'documento'


def _parse_user_date(value, field_name='data'):
    value = str(value or '').strip()
    if not value:
        return ''
    for fmt in ('%d/%m/%Y', '%Y-%m-%d'):
        try:
            return datetime.strptime(value, fmt).strftime('%Y-%m-%d')
        except ValueError:
            continue
    raise ValueError(f'Informe a {field_name} no formato DD/MM/AAAA. Exemplo: 01/08/2026.')


def _format_user_date(value):
    value = str(value or '').strip()
    if not value:
        return ''
    try:
        base = value[:10]
        return datetime.strptime(base, '%Y-%m-%d').strftime('%d/%m/%Y')
    except ValueError:
        return value[:10]



def _format_brl(value):
    try:
        val = Decimal(str(value or '0')).quantize(Decimal('0.01'))
    except Exception:
        val = Decimal('0.00')
    text = f"{val:,.2f}"
    return "R$ " + text.replace(",", "X").replace(".", ",").replace("X", ".")



def _excel_serial_to_iso(value):
    """Convert common Excel serial dates to YYYY-MM-DD without third-party dependencies."""
    text = str(value or '').strip()
    if not text:
        return ''
    try:
        from datetime import timedelta
        base = datetime(1899, 12, 30)
        serial = float(text)
        return (base + timedelta(days=serial)).strftime('%Y-%m-%d')
    except Exception:
        pass
    for fmt in ('%d/%m/%Y', '%Y-%m-%d', '%d/%m/%Y %H:%M:%S', '%Y-%m-%d %H:%M:%S'):
        try:
            return datetime.strptime(text[:19], fmt).strftime('%Y-%m-%d')
        except Exception:
            continue
    return text[:10]


def _xlsx_col_ref(cell_ref):
    m = re.match(r'([A-Z]+)', cell_ref or '')
    return m.group(1) if m else ''


def _xlsx_read_values(path):
    """Read the SAT-exported XLSX using only the standard library."""
    path = Path(path)
    with zipfile.ZipFile(path, 'r') as z:
        names = set(z.namelist())
        shared = []
        if 'xl/sharedStrings.xml' in names:
            root = ET.fromstring(z.read('xl/sharedStrings.xml'))
            for si in root:
                shared.append(''.join(t.text or '' for t in si.iter('{http://schemas.openxmlformats.org/spreadsheetml/2006/main}t')))
        wb_root = ET.fromstring(z.read('xl/workbook.xml'))
        ns = {'x': 'http://schemas.openxmlformats.org/spreadsheetml/2006/main',
              'r': 'http://schemas.openxmlformats.org/officeDocument/2006/relationships'}
        sheets = wb_root.find('x:sheets', ns)
        if sheets is None or not list(sheets):
            raise ValueError('O arquivo do SAT não contém planilhas legíveis.')
        first_sheet = list(sheets)[0]
        rel_id = first_sheet.get('{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id')
        rel_root = ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))
        target = ''
        for rel in rel_root:
            if rel.get('Id') == rel_id:
                target = rel.get('Target') or ''
                break
        if not target:
            raise ValueError('Não foi possível localizar a planilha do relatório do SAT.')
        target = target.lstrip('/')
        if not target.startswith('xl/'):
            target = 'xl/' + target
        if target not in names:
            raise ValueError('A planilha do relatório do SAT não foi encontrada dentro do XLSX.')
        ws_root = ET.fromstring(z.read(target))
        rows = []
        for row in ws_root.findall('.//{http://schemas.openxmlformats.org/spreadsheetml/2006/main}row'):
            cells = {}
            for c in row.findall('{http://schemas.openxmlformats.org/spreadsheetml/2006/main}c'):
                ref = c.get('r') or ''
                col = _xlsx_col_ref(ref)
                typ = c.get('t')
                v = c.find('{http://schemas.openxmlformats.org/spreadsheetml/2006/main}v')
                if typ == 'inlineStr':
                    is_node = c.find('{http://schemas.openxmlformats.org/spreadsheetml/2006/main}is')
                    val = ''.join(t.text or '' for t in is_node.iter('{http://schemas.openxmlformats.org/spreadsheetml/2006/main}t')) if is_node is not None else ''
                else:
                    raw = v.text if v is not None else ''
                    if typ == 's' and raw != '':
                        try: val = shared[int(raw)]
                        except Exception: val = raw
                    elif typ == 'b': val = '1' if raw == '1' else '0'
                    else: val = raw
                if col:
                    cells[col] = val
            if cells:
                rows.append(cells)
        if not rows:
            raise ValueError('O relatório do SAT está vazio.')
        headers = {str(v).strip(): k for k,v in rows[0].items() if str(v).strip()}
        required = ['NumeroDocumento', 'DataEmissao', 'ValorTotalNota']
        missing = [h for h in required if h not in headers]
        if missing:
            raise ValueError('O Excel selecionado não parece ser um relatório compatível do SAT. Campos ausentes: ' + ', '.join(missing))
        out=[]
        for r in rows[1:]:
            numero = str(r.get(headers.get('NumeroDocumento',''), '') or '').strip()
            if not numero:
                continue
            data = _excel_serial_to_iso(r.get(headers.get('DataEmissao',''), ''))
            raw_source = r.get(headers.get('ValorTotalNota',''), '')
            raw_val = str(raw_source if raw_source is not None else '').strip()
            try:
                # XLSX numeric cells use the invariant decimal point (e.g. 635.36).
                # Text exported with Brazilian formatting can use 1.234,56.
                if isinstance(raw_source, (int, float)):
                    value = Decimal(str(raw_source))
                elif ',' in raw_val:
                    # Brazilian text: remove thousands separators, then convert comma to decimal point.
                    normalized = raw_val.replace('.', '').replace(',', '.')
                    value = Decimal(normalized or '0')
                else:
                    # Plain numeric text from XLSX keeps its decimal point.
                    value = Decimal(raw_val or '0')
            except Exception:
                value = Decimal('0.00')
            def get(name):
                key=headers.get(name)
                return str(r.get(key,'') or '').strip() if key else ''
            out.append({
                'numero': numero.lstrip('0') or '0',
                'data': data,
                'valor': value,
                'chave': re.sub(r'\D','',get('ChaveAcesso')),
                'serie': get('SerieDocumento'),
                'situacao': get('Situacao'),
                'tipo_documento': get('TipoDocumento'),
                'operacao': get('TipoDeOperacaoEntradaOuSaida'),
            })
        return {'headers': list(headers.keys()), 'rows': out, 'path': str(path)}



def _sat_dn_parts(dn):
    """Read the common X.500 fields needed by Edge AutoSelectCertificateForUrls.

    Windows certificate subjects can contain commas inside quoted/escaped values.
    This parser intentionally handles the common CN/O/OU/L fields without trying to
    be a full X.500 parser; unknown fields are simply ignored.
    """
    text=str(dn or '').strip()
    if not text:
        return {}
    parts={}
    token=[]; chunks=[]; escaped=False; quoted=False
    for ch in text:
        if escaped:
            token.append(ch); escaped=False; continue
        if ch=='\\':
            token.append(ch); escaped=True; continue
        if ch=='"':
            quoted=not quoted; token.append(ch); continue
        if ch==',' and not quoted:
            chunks.append(''.join(token).strip()); token=[]; continue
        token.append(ch)
    if token: chunks.append(''.join(token).strip())
    for item in chunks:
        if '=' not in item:
            continue
        key,val=item.split('=',1)
        key=key.strip().upper()
        val=val.strip().strip('"')
        if key in {'CN','O','OU','L'} and val:
            parts[key]=val
    return parts


def _sat_subject_cn(subject):
    return _sat_dn_parts(subject).get('CN','')


def _sat_windows_certificate_identity(selected_certificate=None):
    """Read canonical certificate identity directly from the Windows store by thumbprint."""
    cert=selected_certificate or {}
    thumb=re.sub(r"\s+","",str(cert.get("Thumbprint") or "")).upper()
    if os.name!='nt' or not thumb:
        subject=str(cert.get('Subject') or '')
        issuer=str(cert.get('Issuer') or '')
        return {'Thumbprint':thumb,'Subject':subject,'Issuer':issuer,'SerialNumber':str(cert.get('SerialNumber') or ''),
                'SubjectCN':_sat_subject_cn(subject),'IssuerCN':_sat_dn_parts(issuer).get('CN','')}
    ps=r'''param([string]$Thumbprint)
$ErrorActionPreference='Stop'
foreach($path in @("Cert:\CurrentUser\My\$Thumbprint","Cert:\LocalMachine\My\$Thumbprint")){
  try{
    $c=Get-Item -Path $path -ErrorAction Stop
    if($c.HasPrivateKey){
      [PSCustomObject]@{Thumbprint=$c.Thumbprint;Subject=$c.Subject;Issuer=$c.Issuer;SerialNumber=$c.SerialNumber;FriendlyName=$c.FriendlyName;HasPrivateKey=[bool]$c.HasPrivateKey}|ConvertTo-Json -Compress
      exit 0
    }
  }catch{}
}
throw 'Certificado não localizado com chave privada no Windows.'
'''
    b64=base64.b64encode(ps.encode('utf-8')).decode('ascii')
    command=("$s=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('"+b64+"'));$sb=[ScriptBlock]::Create($s);& $sb "+f"-Thumbprint '{thumb}'")
    try:
        proc=subprocess.run(['powershell.exe','-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-Command',command],capture_output=True,text=True,timeout=15,encoding='utf-8',errors='replace')
        if proc.returncode==0 and proc.stdout.strip():
            raw=json.loads(proc.stdout.strip())
            if isinstance(raw,list): raw=raw[0] if raw else {}
            raw['SubjectCN']=_sat_subject_cn(raw.get('Subject') or '')
            raw['IssuerCN']=_sat_dn_parts(raw.get('Issuer') or '').get('CN','')
            return raw
    except Exception:
        pass
    subject=str(cert.get('Subject') or '')
    issuer=str(cert.get('Issuer') or '')
    return {'Thumbprint':thumb,'Subject':subject,'Issuer':issuer,'SerialNumber':str(cert.get('SerialNumber') or ''),
            'SubjectCN':_sat_subject_cn(subject),'IssuerCN':_sat_dn_parts(issuer).get('CN','')}

def _sat_build_certificate_filter(selected_certificate=None):
    """Build the documented Edge filter using the certificate's real Windows identity."""
    cert=selected_certificate or {}
    identity=_sat_windows_certificate_identity(cert)
    subject_parts=_sat_dn_parts(identity.get('Subject') or '')
    issuer_parts=_sat_dn_parts(identity.get('Issuer') or '')
    filt={}
    if subject_parts.get('CN'):
        filt['SUBJECT']={'CN':subject_parts['CN']}
    elif subject_parts.get('O') or subject_parts.get('OU') or subject_parts.get('L'):
        filt['SUBJECT']={k:subject_parts[k] for k in ('O','OU','L') if subject_parts.get(k)}
    elif issuer_parts.get('CN'):
        filt['ISSUER']={'CN':issuer_parts['CN']}
    elif issuer_parts:
        filt['ISSUER']={k:issuer_parts[k] for k in ('O','OU','L') if issuer_parts.get(k)}
    return filt

def _sat_install_edge_autoselect_policy(policy):
    """Temporarily install Edge's documented AutoSelectCertificateForUrls policy in HKCU.

    V061 passed the policy as a Chromium command-line argument. Microsoft documents this
    setting as an Edge policy stored under Software\\Policies\\Microsoft\\Edge. V062 used a temporary per-user policy entry so a clean Edge process could consume the rule. V063
    keeps that official path when Windows permits the HKCU write, but falls back to a corrected
    Chromium command-line policy payload when that per-user registry write is denied. Existing
    policy values are preserved and the temporary value is removed in cleanup.
    """
    if os.name != 'nt':
        return None
    try:
        import winreg
    except Exception as exc:
        raise RuntimeError(f'Não foi possível acessar as políticas do Microsoft Edge: {exc}')

    base=r'Software\Policies\Microsoft\Edge\AutoSelectCertificateForUrls'
    key=None; created=False; slot=None
    try:
        try:
            key=winreg.OpenKey(winreg.HKEY_CURRENT_USER, base, 0, winreg.KEY_READ|winreg.KEY_WRITE)
        except FileNotFoundError:
            key=winreg.CreateKey(winreg.HKEY_CURRENT_USER, base); created=True
        existing=set()
        try:
            count=winreg.QueryInfoKey(key)[1]
            for i in range(count):
                name,_,_=winreg.EnumValue(key,i)
                existing.add(str(name))
        except Exception:
            pass
        n=1
        while str(n) in existing:
            n+=1
        slot=str(n)
        value=json.dumps(policy,separators=(',',':'),ensure_ascii=False)
        winreg.SetValueEx(key,slot,0,winreg.REG_SZ,value)
        winreg.FlushKey(key)
        return {'base':base,'slot':slot,'created':created}
    finally:
        try:
            if key is not None: winreg.CloseKey(key)
        except Exception:
            pass


def _sat_remove_edge_autoselect_policy(token):
    if not token or os.name != 'nt':
        return
    try:
        import winreg
        base=token.get('base') or r'Software\Policies\Microsoft\Edge\AutoSelectCertificateForUrls'
        key=winreg.OpenKey(winreg.HKEY_CURRENT_USER,base,0,winreg.KEY_READ|winreg.KEY_WRITE)
        try:
            try: winreg.DeleteValue(key,str(token.get('slot')))
            except FileNotFoundError: pass
            winreg.FlushKey(key)
        finally:
            winreg.CloseKey(key)
        if token.get('created'):
            try:
                winreg.DeleteKey(winreg.HKEY_CURRENT_USER,base)
            except OSError:
                pass
    except Exception:
        pass


def _sat_login_diagnostics(page, selected_certificate=None):
    cert=selected_certificate or {}
    try:
        body=(page.locator('body').inner_text(timeout=2000) or '').strip()
    except Exception:
        body=''
    body_compact=re.sub(r'\s+',' ',body)
    markers=[]
    lowered=body_compact.casefold()
    checks=[
        ('certificado não disponível','Você não possui um certificado do tipo ICP Brasil'),
        ('múltiplos usuários','mais de um usuário ATIVO'),
