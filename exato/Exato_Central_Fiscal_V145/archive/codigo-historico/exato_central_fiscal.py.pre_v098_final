def _xml_parse_safe(xml_bytes):
    if not xml_bytes:
        return None
    try:
        return ET.fromstring(xml_bytes)
    except Exception:
        return None

def _xml_children_by_tag(node, tag):
    if node is None:
        return []
    wanted=str(tag or '').casefold()
    return [n for n in list(node) if _local_tag(n).casefold()==wanted]

def _xml_first(node, tag):
    if node is None:
        return None
    wanted=str(tag or '').casefold()
    for n in node.iter():
        if _local_tag(n).casefold()==wanted:
            return n
    return None

def _xml_text(node, *tags, default=''):
    if node is None:
        return default
    for tag in tags:
        n=_xml_first(node, tag)
        if n is not None and (n.text or '').strip():
            return (n.text or '').strip()
    return default

def _xml_decimal(text, default=Decimal('0.00')):
    try:
        s=str(text or '').strip()
        if not s: return default
        return Decimal(s.replace(',','.')).quantize(Decimal('0.01'))
    except Exception:
        return default

def _xml_number(text):
    try:
        v=Decimal(str(text or '').strip().replace(',','.'))
        return f'{v:f}'.rstrip('0').rstrip('.') if v != v.to_integral() else f'{int(v)}'
    except Exception:
        return str(text or '')

def _xml_party(node):
    end=_xml_first(node,'enderEmit') or _xml_first(node,'enderDest') or _xml_first(node,'enderReme') or _xml_first(node,'enderReceb') or _xml_first(node,'enderToma')
    addr=''
    if end is not None:
        parts=[_xml_text(end,'xLgr'),_xml_text(end,'nro')]
        bairro=_xml_text(end,'xBairro')
        city=_xml_text(end,'xMun')
        uf=_xml_text(end,'UF')
        cep=_xml_text(end,'CEP')
        if bairro: parts.append(bairro)
        if city: parts.append(f'{city}/{uf}' if uf else city)
        if cep: parts.append(cep)
        addr=', '.join(p for p in parts if p)
    return {
        'name':_xml_text(node,'xNome',default=''),
        'fantasy':_xml_text(node,'xFant',default=''),
        'cnpj':re.sub(r'\D','',_xml_text(node,'CNPJ',default='')),
        'cpf':re.sub(r'\D','',_xml_text(node,'CPF',default='')),
