def generate_fiscal_representation_pdf(documents, output_path, family=''):
    """Generate a consolidated fiscal representation from XMLs.

    NF-e -> DANFE; NFC-e -> DANFE NFC-e; CT-e -> DACTE. One document per page,
    sorted by emission date and document number. Only fields available in the XML are used.
    """
    _ensure_reportlab()
    from reportlab.lib import colors
