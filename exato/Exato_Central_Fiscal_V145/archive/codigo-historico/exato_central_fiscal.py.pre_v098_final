def save_documents_to_folder(documents, base_folder, cnpj):
    from pathlib import Path
    base = Path(base_folder)
    saved = []
    errors = []
    now = datetime.now()
    period = base / re.sub(r'\D', '', cnpj or 'sem_cnpj') / now.strftime('%Y') / now.strftime('%m')
    for idx, doc in enumerate(documents, 1):
        tipo = doc.get('tipo') or 'documento'
        if tipo == 'procEventoNFe':
            sub = period / 'Eventos'
        elif tipo in ('nfeProc','resNFe'):
            sub = period / 'NFe'
        else:
            sub = period / 'Outros'
        sub.mkdir(parents=True, exist_ok=True)
        key = _safe_filename(doc.get('chave') or '')
        nsu = _safe_filename(doc.get('nsu') or str(idx))
        filename = f'{key or "NSU_" + nsu}.xml'
        target = sub / filename
        # Never overwrite an existing XML with different content.
        if target.exists():
            try:
                if target.read_bytes() == doc['xml']:
                    saved.append(str(target)); continue
            except Exception:
                pass
            n = 2
            while True:
                alt = sub / f'{target.stem}_{n}{target.suffix}'
                if not alt.exists(): target = alt; break
                n += 1
        try:
            target.write_bytes(doc['xml'])
            saved.append(str(target))
        except Exception as exc:
            errors.append(f'{target.name}: {exc}')
    return saved, errors


