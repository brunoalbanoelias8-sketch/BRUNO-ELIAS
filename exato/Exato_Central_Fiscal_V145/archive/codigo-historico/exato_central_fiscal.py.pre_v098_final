        fam=SUPPORTED_FAMILIES.get(str(last.get('family') or ''), str(last.get('family') or ''))
        if fam:
            clauses.append(f'a última auditoria registrada foi de {fam}')
    prefix=('Bom ter você por aqui. ' if company else '')
    return prefix + '. '.join(clauses).capitalize() + '.'


class ExatoIAEngine:
    """Contextual, evidence-first conversational engine for Exato IA."""

    def __init__(self, result=None, company_name='', conversation_history=None):
        self.result=result or {}
        self.company_name=str(company_name or '').strip()
        self.history=list(conversation_history or [])[-8:]
        self.rows=list(self.result.get('audit_rows') or [])
        self.conform=[r for r in self.rows if r.get('status')=='Conforme']
        self.missing=[r for r in self.rows if r.get('status')=='XML não localizado']
        self.divergent=[r for r in self.rows if r.get('status')=='Divergência']
        self.total=len(self.rows)
        self.family=str(self.result.get('family') or '')
        self.family_label=SUPPORTED_FAMILIES.get(self.family, 'documentos fiscais')
        self.model=AUDIT_FAMILY_MODELS.get(self.family, '')
        self.sat_total=sum((_audit_clean_decimal(r.get('valor_sat')) for r in self.rows), Decimal('0.00'))
        self.matched_sat_total=_audit_clean_decimal(self.result.get('matched_sat_total') or 0)
        self.matched_xml_total=_audit_clean_decimal(self.result.get('matched_xml_total') or 0)
        self.missing_value=sum((_audit_clean_decimal(r.get('valor_sat')) for r in self.missing), Decimal('0.00'))
        self.value_diff=self._value_diff()
        self.number_diffs=list(self.result.get('number_differences') or [])
        self.date_diffs=list(self.result.get('date_differences') or [])
        self.xml_only=list(self.result.get('xml_only') or [])
        self.by_day=self._group_by_day()
        self.duplicate_numbers=self._duplicate_numbers()
        self.max_value=max(self.rows, key=lambda r:self._money(r.get('valor_sat')), default=None)
        self.min_value=min(self.rows, key=lambda r:self._money(r.get('valor_sat')), default=None)
        self.max_div=max(self.divergent, key=lambda r:self._money(r.get('valor_sat')), default=None)
        self.average=self._average_value()
        self.matched_count=len(self.conform)+len(self.divergent)
        self.matched_pct=float(_exato_ia_pct(self.matched_count,self.total))
        self.missing_pct=float(_exato_ia_pct(len(self.missing),self.total))
        self.div_pct=float(_exato_ia_pct(len(self.divergent),self.total))
        self.diff_pct=float(_exato_ia_pct(abs(self.value_diff),self.sat_total))
        self.top_day=max(self.by_day.items(), key=lambda x:x[1])[0] if self.by_day else ''
        self.top_day_count=self.by_day.get(self.top_day,0) if self.top_day else 0

    @staticmethod
    def _money(value):
        try:
            return _audit_clean_decimal(value)
        except Exception:
            return Decimal('0.00')

    def _value_diff(self):
        diffs=[_audit_clean_decimal(d.get('difference')) for d in (self.result.get('value_differences') or [])]
        return sum(diffs, Decimal('0.00')) if diffs else _audit_clean_decimal(self.result.get('value_difference') or 0)

    def _group_by_day(self):
        out={}
        for r in self.rows:
            d=str(r.get('data') or '')[:10]
            if d:
                out[d]=out.get(d,0)+1
        return out

    def _duplicate_numbers(self):
        counts={}
        for r in self.rows:
            n=str(r.get('numero') or '').strip()
            if n:
                counts[n]=counts.get(n,0)+1
        return sorted([n for n,c in counts.items() if c>1], key=lambda x:(len(x),x))

    def _average_value(self):
        if not self.total:
            return Decimal('0.00')
        return (self.sat_total / Decimal(str(self.total))).quantize(Decimal('0.01'))

    @staticmethod
    def _norm(text):
        text=unicodedata.normalize('NFKD', str(text or ''))
        text=''.join(ch for ch in text if not unicodedata.combining(ch))
        return ' '.join(text.casefold().split())

    def _row_by_number(self, number):
        target=str(number or '').lstrip('0') or '0'
        for r in self.rows:
            n=str(r.get('numero') or '').lstrip('0') or '0'
            if n==target:
                return r
        return None

    def _last_referenced_number(self):
        for item in reversed(self.history):
            txt=' '.join([str(item.get('question') or ''), str(item.get('answer') or item.get('text') or '')])
            m=re.search(r'\b(?:nota|documento)\s+(\d+)\b', self._norm(txt))
            if m:
                return m.group(1)
        return ''

    def _recent_topic(self):
        txt=' '.join(str(x.get('question') or '') for x in self.history[-4:])
        q=self._norm(txt)
        if any(k in q for k in ('maior movimento','dia com mais','maior valor')): return 'movimentacao'
        if any(k in q for k in ('pendencia','sem xml')): return 'pendencias'
        if any(k in q for k in ('divergencia','diferenca')): return 'divergencias'
        if any(k in q for k in ('valor conciliado','quanto conciliado','valor total')): return 'valores'
        if any(k in q for k in ('status','conforme','tudo certo')): return 'status'
        return ''

    def _extract_number(self, q):
        m=re.search(r'\b(?:nota|documento|n[º°o]?|numero|número)\s*[:#-]?\s*(\d{1,12})\b', q)
        if m:
            return m.group(1)
        pronoun_patterns=(r'\bessa nota\b',r'\besta nota\b',r'\bela\b',r'\besse documento\b',r'\beste documento\b',r'(?<![A-Za-zÀ-ÿ])e\s+ela\b',r'(?<![A-Za-zÀ-ÿ])e\s+esse\b',r'(?<![A-Za-zÀ-ÿ])e\s+esta\b')
        if any(re.search(p,q) for p in pronoun_patterns):
            return self._last_referenced_number()
        return ''

    def profile(self):
        return {
            'total':self.total,'conforme':len(self.conform),'missing':len(self.missing),'divergent':len(self.divergent),
            'matched_count':self.matched_count,'matched_pct':self.matched_pct,'missing_pct':self.missing_pct,'divergence_pct':self.div_pct,
            'sat_total':self.sat_total,'matched_sat_total':self.matched_sat_total,'matched_xml_total':self.matched_xml_total,
            'missing_value':self.missing_value,'value_diff':self.value_diff,'value_diff_pct':self.diff_pct,
            'top_day':self.top_day,'top_day_count':self.top_day_count,'average':self.average,
            'duplicate_numbers':list(self.duplicate_numbers),'family_label':self.family_label,'model':self.model,
        }

    def _document_list(self, rows, label, limit=10):
        if not rows:
            return f'Não há {label} nesta auditoria.'
        items=[]
        for r in rows[:limit]:
            n=str(r.get('numero') or '—')
            v=self._money(r.get('valor_sat'))
            items.append(f'nota {n} ({_format_brl(v)})')
        suffix=f'; e mais {len(rows)-limit}.' if len(rows)>limit else '.'
        return f'Encontrei {len(rows)} {label}: ' + ', '.join(items) + suffix

    def _row_description(self, row):
        if not row:
            return 'Não encontrei esse documento no resultado desta auditoria.'
        n=str(row.get('numero') or '—')
        date=_format_user_date(str(row.get('data') or '')[:10]) if row.get('data') else 'data não informada'
        sat=self._money(row.get('valor_sat'))
        xml=row.get('valor_xml')
        status=row.get('status') or 'Sem classificação'
        if status=='Conforme':
            return f'A nota {n} está CONFORME. Em {date}, o valor do SAT foi {_format_brl(sat)} e os dados conferidos no XML foram compatíveis.'
        if status=='XML não localizado':
            return f'A nota {n} está como XML NÃO LOCALIZADO. Ela aparece no SAT em {date}, com valor de {_format_brl(sat)}, mas o XML correspondente não foi localizado na Central.'
        diffs=row.get('differences') or []
        details='; '.join(str(d.get('detail') or '') for d in diffs if d.get('detail'))
        base=f'A nota {n} está como DIVERGÊNCIA. Em {date}, o SAT registra {_format_brl(sat)} e o XML {_format_brl(xml or 0)}.'
        return (base + ' ' + details).strip()

    def _row_value_difference(self, row):
        for diff in (row.get('differences') or []):
            if diff.get('kind')=='valor':
                m=re.search(r'\(([-+]?[^)]+)\)',str(diff.get('detail') or ''))
                if m:
                    raw=m.group(1).replace('R$','').replace('.','').replace(',','.').strip()
                    try:return Decimal(raw)
                    except Exception:pass
        if row.get('valor_xml') is not None:
            return self._money(row.get('valor_sat'))-self._money(row.get('valor_xml'))
        return Decimal('0.00')

    def _analysis_answer(self):
        if not self.total:
            return self._status_answer()
        parts=[self._status_answer()]
        if self.top_day and self.top_day_count>1:
            parts.append(f'O maior volume ficou em {_format_user_date(self.top_day)}, com {self.top_day_count} documento(s).')
        if self.max_value:
            parts.append(f'A maior movimentação foi a nota {self.max_value.get("numero") or "—"}, com {_format_brl(self.max_value.get("valor_sat") or 0)}.')
        if self.divergent:
            top_div=max(self.divergent,key=lambda r:abs(self._row_value_difference(r)))
            parts.append(f'A divergência de maior impacto de valor está na nota {top_div.get("numero") or "—"}, com diferença de {_format_brl(abs(self._row_value_difference(top_div)))}.')
        if self.missing:
            parts.append(f'{len(self.missing)} documento(s) ainda dependem de XML localizado, totalizando {_format_brl(self.missing_value)} no SAT.')
        if not self.divergent and not self.missing:
            parts.append('Não encontrei um ponto objetivo que peça revisão adicional dentro dos dados disponíveis.')
        return ' '.join(parts)

    def _comparison_answer(self):
        gap=self.matched_sat_total-self.matched_xml_total
        if not self.matched_count:
            return 'Ainda não há documentos conciliados o suficiente para comparar os totais SAT e XML.'
        if gap==Decimal('0.00'):
            return (f'Nos {self.matched_count} documentos conciliados, o SAT soma {_format_brl(self.matched_sat_total)} e os XMLs também somam '
                    f'{_format_brl(self.matched_xml_total)}. A diferença entre os totais conciliados é R$ 0,00.')
        return (f'Nos {self.matched_count} documentos conciliados, o SAT soma {_format_brl(self.matched_sat_total)} e os XMLs somam '
                f'{_format_brl(self.matched_xml_total)}. A diferença entre os totais conciliados é de {_format_brl(abs(gap))}.')

    def _status_answer(self):
        if self.total==0:
            return 'Ainda não há documentos suficientes para uma análise. Importe o Excel do SAT e eu consigo trabalhar sobre os dados reais.'
        if not self.missing and not self.divergent:
            return (f'A auditoria está CONFORME: {self.total} documento(s) foram conciliados, sem XMLs pendentes e sem divergências nos dados conferidos. '
                    f'O valor conciliado é {_format_brl(self.matched_sat_total)}.')
        parts=[]
        if self.missing: parts.append(f'{len(self.missing)} documento(s) sem XML localizado')
        if self.divergent: parts.append(f'{len(self.divergent)} documento(s) com divergências')
        if self.value_diff: parts.append(f'diferença financeira acumulada de {_format_brl(abs(self.value_diff))}')
        return 'O resultado pede atenção porque ' + ', '.join(parts) + '.'

    def _explain_answer(self):
        if self.total==0:
            return self._status_answer()
        if not self.missing and not self.divergent:
            if self.top_day_count>1:
                return (f'Ficou CONFORME porque os {self.total} documentos encontrados foram conciliados sem diferenças nos dados conferidos. '
                        f'Um detalhe interessante é que o dia {_format_user_date(self.top_day)} concentrou {self.top_day_count} documento(s), mas sem gerar divergências.')
            if self.max_value and self.sat_total and self._money(self.max_value.get('valor_sat')) >= self.sat_total*Decimal('0.20'):
                return (f'Ficou CONFORME porque os dados dos {self.total} documentos fecharam sem divergências. '
                        f'A nota {self.max_value.get("numero") or "—"} é a maior movimentação do período, com {_format_brl(self.max_value.get("valor_sat") or 0)}.')
            return f'Ficou CONFORME porque os {self.total} documentos foram localizados e os dados conferidos entre SAT e XML não apresentaram diferenças.'
        if self.divergent and self.missing:
            return (f'O resultado ficou em DIVERGÊNCIA porque {len(self.divergent)} documento(s) apresentaram diferenças. '
                    f'Além disso, {len(self.missing)} documento(s) do SAT ainda não tiveram XML localizado.')
        if self.divergent:
            return f'O resultado ficou em DIVERGÊNCIA porque {len(self.divergent)} documento(s) apresentaram diferenças nos dados conferidos.'
        return f'O resultado ficou em ATENÇÃO porque {len(self.missing)} documento(s) do SAT não tiveram XML correspondente localizado na Central.'

    def _priority_answer(self):
        candidates=self.divergent or self.missing
        if not candidates:
            if self.total:
                return 'Não existe um documento prioritário para revisão porque a auditoria não encontrou pendências ou divergências.'
            return 'Ainda não há documentos suficientes para definir uma prioridade.'
        def key(r):
            status_weight=2 if r.get('status')=='Divergência' else 1
            return (status_weight,self._money(r.get('valor_sat')),str(r.get('data') or ''))
        first=max(candidates,key=key)
        reason='uma divergência' if first.get('status')=='Divergência' else 'um XML não localizado'
        return (f'Eu começaria pela nota {first.get("numero") or "—"}. Ela aparece como {reason} e está entre os pontos de maior impacto financeiro desta auditoria, '
                f'com {_format_brl(first.get("valor_sat") or 0)} no SAT. {self._row_description(first)}')

    def _concentration_answer(self):
        if not self.by_day:
            return 'Não encontrei datas suficientes para analisar a concentração de documentos.'
        ordered=sorted(((d,c) for d,c in self.by_day.items() if d!=self.top_day), key=lambda x:(x[1],x[0]), reverse=True)
        pieces=[f'{_format_user_date(d)} ({c})' for d,c in ordered[:4]]
        if pieces:
            return f'O dia de maior movimento foi {_format_user_date(self.top_day)}, com {self.top_day_count} documento(s). Os maiores volumes seguintes foram: ' + ', '.join(pieces) + '.'
        return f'O dia de maior movimento foi {_format_user_date(self.top_day)}, com {self.top_day_count} documento(s).'

    def _oddity_answer(self):
        findings=[]
        if self.duplicate_numbers:
            findings.append(f'há numeração repetida nas notas {", ".join(self.duplicate_numbers[:6])}')
        if self.max_value and self.total and self.average and self._money(self.max_value.get('valor_sat')) >= self.average*Decimal('3'):
            findings.append(f'a nota {self.max_value.get("numero") or "—"} está bem acima da média, com {_format_brl(self.max_value.get("valor_sat") or 0)} contra média de {_format_brl(self.average)}')
        if self.top_day_count>=max(5,round(self.total*0.30)) and self.top_day_count<self.total:
            findings.append(f'{self.top_day_count} de {self.total} documentos estão concentrados em {_format_user_date(self.top_day)}')
        if self.divergent:
            findings.append(f'{len(self.divergent)} documento(s) possuem divergências')
        if self.missing:
            findings.append(f'{len(self.missing)} documento(s) não têm XML localizado')
        if not findings:
            return 'Não identifiquei um padrão claramente fora do esperado dentro dos dados disponíveis. Isso não substitui uma revisão humana; significa apenas que não apareceu um sinal objetivo forte nos dados que recebi.'
        return 'Encontrei alguns pontos que merecem uma olhada: ' + '; '.join(findings) + '.'

