        self.audit_ai_title.config(text=ai.get('title','Auditoria concluída'),fg=GREEN if ai.get('status')=='conforme' else (ORANGE if ai.get('status')=='atencao' else RED))
        self.audit_ai_message.config(text=ai.get('message','')); self.audit_ai_callout.config(text=ai.get('callout','')); self.audit_ai_chat_history=[]
