def _danfe_date_text(value):
    text = str(value or '').strip().replace('T', ' ')
    if not text:
        return '—'
    date_part = text[:10]
    try:
        date_fmt = datetime.strptime(date_part, '%Y-%m-%d').strftime('%d/%m/%Y')
    except Exception:
        date_fmt = date_part
    time_part = text[11:19] if len(text) >= 19 else ''
    return f'{date_fmt} {time_part}'.strip()


def _danfe_key_groups(key):
