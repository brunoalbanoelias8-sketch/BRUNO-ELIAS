def _safe_read_db_count(db_path):
    """Return total non-event documents in a candidate database without mutating it."""
    try:
        if not db_path.exists() or db_path.stat().st_size < 4096:
            return 0
        conn=sqlite3.connect(f"file:{db_path.as_posix()}?mode=ro", uri=True, timeout=5)
        try:
            row=conn.execute("SELECT COUNT(*) FROM documents WHERE status!='Evento'").fetchone()
            return int(row[0] or 0)
        except Exception:
            return 0
        finally:
            conn.close()
    except Exception:
        return 0



