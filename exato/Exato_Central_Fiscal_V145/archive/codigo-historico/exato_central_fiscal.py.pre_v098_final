def audit_sat_excel_against_xml(cnpj, sat_rows, date_from='', date_to='', family=''):
    """Reconcile the SAT report against the XML universe using a deterministic, document-first model."""
    sat = list(sat_rows or [])
    family_map={'Nfe':'nfe','NF-e':'nfe','NFCe':'nfce','NFC-e':'nfce','65':'nfce','55':'nfe','Nfce':'nfce'}
    detected=set()
    for r in sat:
        fam=_audit_family(r.get('tipo_documento')) or family_map.get(str(r.get('tipo_documento') or '').strip())
        if fam: detected.add(fam)
    if len(detected)==1 and not family:
        family=next(iter(detected))
    # Query only the relevant family when the SAT file tells us unambiguously what it contains.
    # This avoids loading/parsing the entire company archive twice for a single-family audit.
    xml_rows = _audit_xml_rows(cnpj, date_from, date_to, family if family else '')

    sat_dirs={_normalize_audit_direction(r.get('operacao')) for r in sat if _normalize_audit_direction(r.get('operacao'))}
    xml_dirs={_normalize_audit_direction(r.get('direcao')) for r in xml_rows if _normalize_audit_direction(r.get('direcao'))}
    direction_filter=''
    if len(sat_dirs)==1 and xml_dirs:
        only=next(iter(sat_dirs)); filtered=[r for r in xml_rows if _normalize_audit_direction(r.get('direcao')) in (only,'')]
        if filtered or not xml_rows:
            xml_rows=filtered; direction_filter=only

    # Exact access-key matches first.
    xml_key={_normalize_access_key(r.get('chave') or ''):r for r in xml_rows if len(_normalize_access_key(r.get('chave') or ''))==44}
    xml_fallback={}
    for r in xml_rows:
        key=_audit_fallback_key(r)
        xml_fallback.setdefault(key,r)

    matched=[]; used_xml=set(); sat_only=[]; value_diffs=[]; date_diffs=[]; number_diffs=[]
    sat_dedup=[]; seen_sat=set()
    for sr in sat:
        # Ignore explicit non-document rows or duplicated exports.
        if str(sr.get('situacao') or '').strip().casefold() in {'cancelada','cancelado','denegada','denegado'}:
            continue
        k=_audit_key(sr)
        if k in seen_sat: continue
        seen_sat.add(k)
        sat_dedup.append(sr)

    for sr in sat_dedup:
        access=_normalize_access_key(sr.get('chave') or '')
        xr=xml_key.get(access) if len(access)==44 else None
        if xr is not None:
            match_key=('xml',id(xr))
        else:
            fb=_audit_fallback_key(sr)
            xr=xml_fallback.get(fb)
            match_key=('xml',id(xr)) if xr is not None else None
        if xr is None:
            sat_only.append(sr)
            sr['_match_key']=None
            continue
        used_xml.add(id(xr)); sr['_match_key']=match_key
        matched.append((sr,xr))
        diffs,diff=_audit_compare_pair(sr,xr)
        if any(d['kind']=='numero' for d in diffs): number_diffs.append({'sat':sr,'xml':xr})
        if any(d['kind']=='data' for d in diffs): date_diffs.append({'sat':sr,'xml':xr})
        if any(d['kind']=='valor' for d in diffs): value_diffs.append({'sat':sr,'xml':xr,'difference':diff})

    xml_only=[xr for xr in xml_rows if id(xr) not in used_xml]
    sat_total=sum((_audit_clean_decimal(r.get('valor')) for r in sat_dedup),Decimal('0.00'))
    xml_total=sum((_audit_clean_decimal(r.get('valor')) for r in xml_rows),Decimal('0.00'))
    matched_sat_total=sum((_audit_clean_decimal(sr.get('valor')) for sr,_ in matched),Decimal('0.00'))
    matched_xml_total=sum((_audit_clean_decimal(xr.get('valor')) for _,xr in matched),Decimal('0.00'))
    value_difference=sum((_audit_clean_decimal(d.get('difference')) for d in value_diffs),Decimal('0.00'))

    xml_by_match_key={('xml',id(xr)):xr for xr in xml_rows}
    result={
        'sat_count':len(sat_dedup), 'xml_count':len(xml_rows),
        'sat_total':sat_total, 'xml_total':xml_total,
        'matched_sat_total':matched_sat_total, 'matched_xml_total':matched_xml_total,
        'count_difference':len(sat_dedup)-len(xml_rows),
        'matched':matched, 'sat_only':sat_only, 'xml_only':xml_only,
        'number_differences':number_diffs, 'date_differences':date_diffs, 'value_differences':value_diffs,
        'value_difference':value_difference,
        'missing_sat_value': sum((_audit_clean_decimal(r.get('valor')) for r in sat_only),Decimal('0.00')),
        'xml_only_value': sum((_audit_clean_decimal(r.get('valor')) for r in xml_only),Decimal('0.00')),
        'family':family or (next(iter(detected)) if len(detected)==1 else ''),
        'direction':direction_filter, 'period_start':date_from, 'period_end':date_to,
        'source_file':'', 'sat_rows':sat_dedup, '_xml_by_match_key':xml_by_match_key,
    }
    result['audit_rows']=_audit_build_rows(result)
    # The temporary internal map is intentionally removed before persistence/serialization.
    result.pop('_xml_by_match_key',None)
    result['ai_analysis']=analyze_audit_result(result)
    return result

