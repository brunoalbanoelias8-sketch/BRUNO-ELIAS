def _sync_state_key(cnpj, family):
    return f"{re.sub(r'\D', '', cnpj or '')}:{family}"


def get_saved_nsu(config_data, cnpj, family):
    state = config_data.get('sync_state') or {}
    item = state.get(_sync_state_key(cnpj, family)) or {}
    try:
        return max(0, int(item.get('last_saved_nsu', 0) or 0))
    except Exception:
        return 0


def get_sync_state_item(config_data, cnpj, family):
    return dict((config_data.get('sync_state') or {}).get(_sync_state_key(cnpj, family)) or {})


def save_nsu_state(config_data, cnpj, family, last_nsu, batch_docs=0, metadata=None):
    """Persist the synchronization checkpoint and the latest available NSU information.

    This state is intentionally lightweight and per company/family. It lets the UI
    show how many additional batches are approximately available without exposing
    implementation details to the user.
    """
    try:
        last_i=max(0, int(str(last_nsu or 0)))
    except Exception:
        last_i=0
    item={
        'last_saved_nsu': last_i,
        'last_batch_docs': int(batch_docs or 0),
        'updated_at': datetime.now().isoformat(timespec='seconds'),
    }
    if metadata:
        item.update(dict(metadata))
    config_data.setdefault('sync_state', {})[_sync_state_key(cnpj, family)] = item
    save_config(config_data)


NFE_SYNC_COOLDOWN_HOURS = 12
NFE_ACTOR_SEQUENCE = ('2', '1')  # Start with Destinatário/Entrada; alternate on subsequent runs.

def _parse_iso_datetime(value):
    try:
        if not value:
            return None
        return datetime.fromisoformat(str(value))
    except Exception:
        return None

def _nfe_control_key(cnpj):
    return re.sub(r'\D', '', str(cnpj or ''))

def get_nfe_sync_control(config_data, cnpj):
    key = _nfe_control_key(cnpj)
    controls = config_data.setdefault('nfe_sync_control', {})
    item = dict(controls.get(key) or {})
    if item.get('next_actor') not in {'1','2'}:
        item['next_actor'] = NFE_ACTOR_SEQUENCE[0]
    return item

def nfe_cooldown_remaining(config_data, cnpj, now=None):
    now = now or datetime.now()
    item = get_nfe_sync_control(config_data, cnpj)
    until = _parse_iso_datetime(item.get('cooldown_until'))
    if until is None:
        return 0, item
    remaining = int((until - now).total_seconds())
    if remaining <= 0:
        return 0, item
    return remaining, item

def _format_nfe_wait(seconds):
    seconds=max(0,int(seconds or 0))
    hours=seconds//3600
    minutes=(seconds%3600)//60
    if hours:
        return f'{hours}h{minutes:02d}'
    return f'{minutes}min'

def nfe_actor_meta(actor):
    actor=str(actor)
    if actor=='1':
        return 'Emitente / Saída','nfe_emitente'
    return 'Destinatário / Entrada','nfe_destinatario'

def choose_nfe_actor(config_data, cnpj):
    """Pick exactly one independent NF-e participation stream for a safe service cycle.

    SEF/SC requires a long cooldown after synchronization reaches status 117.
    The Central therefore alternates the two validated actor-specific cursors rather
    than issuing actor 1 and actor 2 back-to-back for the same CNPJ.
    """
    control = get_nfe_sync_control(config_data, cnpj)
    cnpj_digits=_nfe_control_key(cnpj)
    if control.get('last_actor') in {'1','2'}:
        return str(control.get('next_actor') or ('1' if control.get('last_actor')=='2' else '2'))
    # Migration-friendly first choice: if one actor already has locally stored sources
    # from an older version, prioritize the other independent stream. When there is no
    # actor-specific history, start with Destinatário/Entrada to avoid repeating the
    # exact V083/V084 scenario where Emitente returned 117 and blocked Entrada with 657.
    try:
        has1=db_has_actor_sources(cnpj_digits,'nfe','1')
        has2=db_has_actor_sources(cnpj_digits,'nfe','2')
    except Exception:
        has1=has2=False
    if has2 and not has1:
        return '1'
    if has1 and not has2:
        return '2'
    return '2'

def mark_nfe_sync_cycle(config_data, cnpj, actor, cstat, end_reason, cooldown_hours=NFE_SYNC_COOLDOWN_HOURS):
    now=datetime.now()
    key=_nfe_control_key(cnpj)
    control=get_nfe_sync_control(config_data, cnpj)
    actor=str(actor)
    next_actor='1' if actor=='2' else '2'
    hours=max(1,int(cooldown_hours or 1))
    until=now+timedelta(hours=hours)
    control.update({
        'last_actor': actor,
        'next_actor': next_actor,
        'last_query_at': now.isoformat(timespec='seconds'),
        'cooldown_until': until.isoformat(timespec='seconds'),
        'cooldown_hours': hours,
        'last_cstat': str(cstat or ''),
        'last_end_reason': str(end_reason or ''),
        'updated_at': now.isoformat(timespec='seconds'),
    })
    with CONFIG_LOCK:
        config_data.setdefault('nfe_sync_control', {})[key]=control
        save_config(config_data)
    return control

def estimate_remaining_batches(config_data, cnpj, family):
    """Estimate additional batches available from the latest service checkpoint.

    NSU sequences can contain gaps and events, so this is deliberately exposed as
    an estimate in the UI rather than an exact document count.
    """
    item=get_sync_state_item(config_data, cnpj, family)
    try:
        current=int(item.get('last_saved_nsu') or 0)
        max_nsu=int(item.get('max_nsu') or 0)
    except Exception:
        return None
    if max_nsu <= current:
        return 0
    return max(1, (max_nsu - current + 49) // 50)


def _nfe_requires_full_resync(config_data, cnpj):
    """Legacy compatibility check.

    V068 intentionally does not reset NF-e cursors merely because the local DB is empty.
    A saved NSU represents a server-side synchronization point and must be preserved.
    Returning False here keeps the validated V061 behavior: each actor starts from its
    own persisted cursor, with NSU=0 used only when that actor has never been initialized.
    """
    return False


def _nfe_bootstrap_state_key(cnpj):
    return _sync_state_key(cnpj, 'nfe_combined')


def _nfe_has_actor_history(config_data, cnpj):
    states=config_data.get('sync_state') or {}
    for suffix in ('nfe_emitente','nfe_destinatario'):
        item=states.get(_sync_state_key(cnpj,suffix)) or {}
        try:
            if int(str(item.get('last_saved_nsu') or 0))>0:
                return True
        except Exception:
            pass
        if item.get('actor_bootstrapped'):
            return True
    try:
        cnpj_digits=re.sub(r'\D','',str(cnpj or ''))
        conn=sqlite3.connect(DB_PATH, timeout=10)
        row=conn.execute("SELECT 1 FROM document_sources WHERE cnpj=? AND family='nfe' LIMIT 1", (cnpj_digits,)).fetchone()
        if row:
            conn.close(); return True
        row=conn.execute("SELECT 1 FROM documents WHERE cnpj=? AND family='nfe' AND status!='Evento' LIMIT 1", (cnpj_digits,)).fetchone()
        conn.close()
        return bool(row)
    except Exception:
        return False


def _nfe_mark_combined_cursor(config_data, cnpj, returned_nsu, max_nsu=''):
    """After an actor=9 bootstrap, seed both actor cursors at the same covered NSU."""
    try: n=int(str(returned_nsu or 0))
    except Exception: n=0
    meta={'nfe_actor_filter':'Emitente e Destinatário (bootstrap)','actor_bootstrapped':True,'bootstrap_actor_code':'9'}
    if max_nsu not in ('',None):
        try: meta['max_nsu']=int(str(max_nsu))
        except Exception: pass
    for suffix in ('nfe_emitente','nfe_destinatario'):
        save_nsu_state(config_data,cnpj,suffix,n,0,metadata=meta)
    save_nsu_state(config_data,cnpj,'nfe_combined',n,0,metadata=meta)


def sync_documents_automatically(fetch_batch, cert_thumbprint, cnpj, family,
                                  start_nsu=0, max_batches=2000, progress_cb=None, stop_cb=None,
                                  diagnostic_dir=None, batch_limit=None):
    """Consume SEF/SC distribution safely and record exactly why it stopped."""
    try:
        current_nsu = max(0, int(str(start_nsu or '0')))
    except Exception:
        raise ValueError('NSU inicial inválido.')
    all_docs=[]; batches=0; seen_nsus=set(); last_info={}; batch_history=[]
    while batches < max_batches:
        if stop_cb and stop_cb():
            return {'ok':False,'cancelled':True,'documents':all_docs,'batches':batches,'last_nsu':current_nsu,
                    'next_nsu':current_nsu,'last_info':last_info,'batch_history':batch_history,
                    'end_reason':'cancelado pelo usuário','message':'Atualização cancelada pelo usuário.'}
        batches += 1
        request_nsu=current_nsu
        ok,result,info=fetch_batch(cert_thumbprint,cnpj,current_nsu)
        info=info or {}; last_info=info
        diagnostic_path=_save_webservice_diagnostic(info,family,cnpj,batches,current_nsu,diagnostic_dir)
        if progress_cb:
            progress_cb({'batch':batches,'nsu_inicial':request_nsu,'ok':ok,'result':result,'info':info,
                         'diagnostic_path':diagnostic_path,'total_docs':len(all_docs)})
        cstat=str(info.get('cstat') or '')
        batch_docs=list(info.get('documents') or [])
        try: reported_qty=int(str(info.get('qtDfeRet') or '0'))
        except Exception: reported_qty=0
        returned_nsu=info.get('ultNSURet') or info.get('ultNuNSURet') or info.get('ultNSU') or info.get('ultNuNSU') or ''
        try: returned_nsu_i=int(str(returned_nsu or current_nsu))
        except Exception: returned_nsu_i=current_nsu
        max_doc_nsu=current_nsu
        for doc in batch_docs:
            try: max_doc_nsu=max(max_doc_nsu,int(str(doc.get('nsu') or 0)))
            except Exception: pass
        cursor_source='retorno'
        if returned_nsu_i <= current_nsu and max_doc_nsu > current_nsu:
            returned_nsu_i=max_doc_nsu; cursor_source='documento'
        batch_history.append({'lote':batches,'nsu_inicial':request_nsu,'nsu_final':returned_nsu_i,
                              'max_nsu':info.get('maxNSU') or '','quantidade_informada':reported_qty,
                              'documentos_interpretados':len(batch_docs),'cstat':cstat,'cursor_fonte':cursor_source})
        if cstat == '657':
            return {'ok':False,'documents':all_docs,'batches':batches,'last_nsu':current_nsu,'next_nsu':current_nsu,
                    'last_info':last_info,'batch_history':batch_history,'retry_after_hours':1,'end_reason':'consulta NF-e bloqueada pela SEF/SC (cStat 657)',
                    'message':result or 'A SEF/SC recusou a consulta por consumo indevido (cStat 657). Aguarde antes de tentar novamente.'}
        if not ok and cstat not in {'117','137','110'}:
            return {'ok':False,'documents':all_docs,'batches':batches,'last_nsu':current_nsu,'next_nsu':current_nsu,
                    'last_info':last_info,'batch_history':batch_history,'end_reason':f'erro do serviço ({cstat or "não identificado"})','message':result}
        if cstat=='110':
            return {'ok':False,'documents':all_docs,'batches':batches,'last_nsu':current_nsu,'next_nsu':current_nsu,
                    'last_info':last_info,'batch_history':batch_history,'retry_after_hours':1,'end_reason':'serviço em reprocessamento',
                    'message':result or 'O serviço está reprocessando a consulta. Tente novamente mais tarde.'}
        if reported_qty > 0 and len(batch_docs) != reported_qty:
            return {'ok':False,'documents':all_docs,'batches':batches,'last_nsu':current_nsu,'next_nsu':current_nsu,
                    'last_info':last_info,'batch_history':batch_history,
                    'end_reason':'inconsistência na quantidade recebida',
                    'message':f'O serviço informou {reported_qty} documento(s), mas apenas {len(batch_docs)} puderam ser interpretados. O ponto de atualização foi preservado para não perder documentos.'}
        if not batch_docs:
            if cstat in {'117','137'}:
                return {'ok':True,'documents':all_docs,'batches':batches,'last_nsu':returned_nsu_i,'next_nsu':returned_nsu_i,
                        'last_info':last_info,'batch_history':batch_history,'retry_after_hours':12,
                        'end_reason':'nenhum documento adicional disponível no momento','message':result or 'Nenhum documento adicional disponível.'}
            if cstat=='118' and (reported_qty>0 or info.get('lote_presente')):
                return {'ok':False,'documents':all_docs,'batches':batches,'last_nsu':current_nsu,'next_nsu':current_nsu,
                        'last_info':last_info,'batch_history':batch_history,'end_reason':'serviço informou documentos, mas nenhum XML pôde ser interpretado',
                        'message':'A SEF/SC informou documentos no lote, mas nenhum XML pôde ser interpretado. O ponto atual foi preservado.'}
            return {'ok':True,'documents':all_docs,'batches':batches,'last_nsu':returned_nsu_i,'next_nsu':returned_nsu_i,
                    'last_info':last_info,'batch_history':batch_history,'end_reason':'nenhum documento adicional disponível no momento','message':result}
        all_docs.extend(batch_docs)
        # Um lote de 50 não é um limite total. O avanço seguro é determinado pelo ponto
        # de atualização retornado pelo serviço; se o serviço não informar maxNSU,
        # um lote menor que 50 encerra a rodada, pois não há evidência de continuação.
        if returned_nsu_i <= current_nsu or returned_nsu_i in seen_nsus:
            return {'ok':False,'documents':all_docs,'batches':batches,'last_nsu':current_nsu,'next_nsu':current_nsu,
                    'last_info':last_info,'batch_history':batch_history,'end_reason':'ponto de continuação não avançou',
                    'message':'A SEF/SC não forneceu um ponto de continuação válido. O ponto atual foi preservado.'}
        seen_nsus.add(returned_nsu_i); current_nsu=returned_nsu_i
        try: max_nsu=int(str(info.get('maxNSU') or '0'))
        except Exception: max_nsu=0
        if max_nsu and current_nsu>=max_nsu:
            return {'ok':True,'documents':all_docs,'batches':batches,'last_nsu':current_nsu,'next_nsu':current_nsu,
                    'last_info':last_info,'batch_history':batch_history,'retry_after_hours':12,'end_reason':'ponto de atualização alcançado',
                    'message':(result or '')+'\n\nPonto de atualização alcançado.'}
        if not max_nsu and len(batch_docs)<50:
            return {'ok':True,'documents':all_docs,'batches':batches,'last_nsu':current_nsu,'next_nsu':current_nsu,
                    'last_info':last_info,'batch_history':batch_history,'retry_after_hours':12,
                    'end_reason':f'lote final com {len(batch_docs)} documento(s)',
                    'message':(result or '')+'\n\nNão há indicação de um lote posterior nesta resposta.'}
        if batch_limit is not None and batches>=max(1,int(batch_limit)):
            continuation=bool(len(batch_docs)>=50 or (max_nsu and current_nsu<max_nsu))
            return {'ok':True,'documents':all_docs,'batches':batches,'last_nsu':current_nsu,'next_nsu':current_nsu,
                    'last_info':last_info,'batch_history':batch_history,'continuation_available':continuation,
                    'end_reason':'limite da captura manual alcançado',
                    'message':(result or '')+('\\n\\nAinda existem documentos a consultar.' if continuation else '\\n\\nPonto de atualização alcançado.')}
    return {'ok':False,'documents':all_docs,'batches':batches,'last_nsu':current_nsu,'next_nsu':current_nsu,
            'last_info':last_info,'batch_history':batch_history,'end_reason':'limite de segurança atingido',
            'message':f'Atualização interrompida após {max_batches} lotes para proteção contra execução indefinida.'}

def _parse_document_metadata(xml_bytes, consulta_cnpj='', family_hint=''):
    import xml.etree.ElementTree as ET
    result={'empresa':'Empresa não identificada','direcao':'Entrada','tipo':'Documento','numero':'','serie':'','data':'','valor':Decimal('0.00'),'chave':'','family':family_hint or 'nfe'}
    try: root=ET.fromstring(xml_bytes)
    except Exception: return result
    model=''
    for n in root.iter():
        if _local_tag(n)=='mod' and (n.text or '').strip(): model=(n.text or '').strip(); break
    if model=='65': result['family']='nfce'; result['tipo']='NFC-e'
    elif model=='55': result['family']='nfe'; result['tipo']='NF-e'
    elif family_hint=='nfce': result['family']='nfce'; result['tipo']='NFC-e'
    elif family_hint=='nfe': result['family']='nfe'; result['tipo']='NF-e'
    elif family_hint=='cte': result['family']='cte'; result['tipo']='CT-e'
    cnpjq=re.sub(r'\D','',consulta_cnpj or '')
    if family_hint=='cte':
        emit_cnpj=emit_name=tom_cnpj=tom_name=''
        for parent in root.iter():
            tag=_local_tag(parent)
            if tag=='emit':
                for n in parent.iter():
                    nt=_local_tag(n); t=(n.text or '').strip()
                    if nt in ('CNPJ','CPF') and not emit_cnpj: emit_cnpj=re.sub(r'\D','',t)
                    elif nt=='xNome' and not emit_name: emit_name=t
            elif tag in ('toma3','toma4','toma'):
                for n in parent.iter():
                    nt=_local_tag(n); t=(n.text or '').strip()
                    if nt in ('CNPJ','CPF') and not tom_cnpj: tom_cnpj=re.sub(r'\D','',t)
                    elif nt=='xNome' and not tom_name: tom_name=t
        if cnpjq and cnpjq==tom_cnpj:
            result['direcao']='Entrada'; result['empresa']=tom_name or emit_name or 'Empresa não identificada'
        elif cnpjq and cnpjq==emit_cnpj:
            result['direcao']='Saída'; result['empresa']=emit_name or tom_name or 'Empresa não identificada'
        else:
            result['empresa']=tom_name or emit_name or 'Empresa não identificada'; result['direcao']='Entrada'
        for n in root.iter():
            tag=_local_tag(n); t=(n.text or '').strip()
            if tag=='nCT' and t: result['numero']=t
            elif tag=='serie' and t: result['serie']=t
            elif tag in ('dhEmi','dEmi') and t and not result['data']: result['data']=t
            elif tag=='vTPrest' and t:
                try: result['valor']=Decimal(t)
                except Exception: pass
            elif tag=='infCte':
                ident=n.attrib.get('Id') or ''; m=re.search(r'([A-Za-z0-9]{44})',ident)
                if m: result['chave']=m.group(1)
        return result
    emit_cnpj=dest_cnpj=emit_name=dest_name=''
    for parent in root.iter():
        tag=_local_tag(parent)
        if tag=='emit':
            for n in parent.iter():
                nt=_local_tag(n); t=(n.text or '').strip()
                if nt in ('CNPJ','CPF') and not emit_cnpj: emit_cnpj=re.sub(r'\D','',t)
                elif nt=='xNome' and not emit_name: emit_name=t
        elif tag=='dest':
            for n in parent.iter():
                nt=_local_tag(n); t=(n.text or '').strip()
                if nt in ('CNPJ','CPF') and not dest_cnpj: dest_cnpj=re.sub(r'\D','',t)
                elif nt=='xNome' and not dest_name: dest_name=t
    if cnpjq and cnpjq==emit_cnpj:
        result['direcao']='Saída'; result['empresa']=emit_name or 'Empresa não identificada'
    elif cnpjq and cnpjq==dest_cnpj:
        result['direcao']='Entrada'; result['empresa']=dest_name or emit_name or 'Empresa não identificada'
    else:
        result['empresa']=emit_name or dest_name or 'Empresa não identificada'; result['direcao']='Saída' if emit_cnpj else 'Entrada'
    for n in root.iter():
        tag=_local_tag(n); t=(n.text or '').strip()
        if tag=='nNF' and t: result['numero']=t
        elif tag=='serie' and t: result['serie']=t
        elif tag in ('dhEmi','dEmi') and t and not result['data']: result['data']=t
        elif tag=='vNF' and t:
            try: result['valor']=Decimal(t)
            except Exception: pass
        elif tag=='infNFe':
            ident=n.attrib.get('Id') or ''; m=re.search(r'([A-Za-z0-9]{44})',ident)
            if m: result['chave']=m.group(1)
    if not result['chave']:
        for n in root.iter():
            if _local_tag(n)=='chNFe' and (n.text or '').strip(): result['chave']=(n.text or '').strip(); break
    return result


def _certificate_identity_name(selected_cert, cnpj):
    """Return a usable certificate subject name only when the certificate belongs to the consulted CNPJ."""
    if not selected_cert or not cnpj:
        return ''
    cert_cnpj = re.sub(r'\D', '', str(selected_cert.get('document') or selected_cert.get('cnpj') or ''))
    if cert_cnpj != re.sub(r'\D', '', str(cnpj)):
        return ''
    raw = str(selected_cert.get('friendly_name') or selected_cert.get('subject') or selected_cert.get('identification') or '')
    # Strip the appended document id used by the certificate list.
    raw = re.sub(r'[: ](?:CNPJ|CPF)[: ]?[^:]+$', '', raw, flags=re.I).strip(' -:')
    return raw

def _canonical_company_name(documents, cnpj, config_data=None, selected_cert=None):
    """Choose one canonical folder name for a CNPJ and persist it."""
    cnpj_digits = re.sub(r'\D', '', str(cnpj or ''))
    cfg = config_data if isinstance(config_data, dict) else {}
    names = cfg.setdefault('company_names', {})
    if cnpj_digits and names.get(cnpj_digits):
        return str(names[cnpj_digits])

    cert_name = _certificate_identity_name(selected_cert, cnpj_digits)
    candidates = []
    if cert_name:
        candidates.append(cert_name)
    for doc in documents or []:
        nm = str(doc.get('empresa') or doc.get('company_name') or '').strip()
        if nm and nm != 'Empresa não identificada' and not nm.isdigit():
            candidates.append(nm)
            if len(candidates) >= 12:
                break
    # Most frequent exact name wins; ties prefer the longest informative name.
    from collections import Counter
    counts = Counter(candidates)
    if counts:
        best = sorted(counts, key=lambda n: (-counts[n], -len(n), n.casefold()))[0]
    else:
        best = f'Empresa_{cnpj_digits or "nao_identificada"}'
    best = re.sub(r'[\r\n\t]+', ' ', best).strip()
    names[cnpj_digits] = best
    try:
        if config_data is not None:
            save_config(config_data)
    except Exception:
        pass
    return best

def _move_existing_company_xmls_to_canonical(base, cnpj, canonical_company):
    """Merge old folders for the same CNPJ into the canonical company folder.
    This fixes duplicates produced by older versions that used xNome directly."""
    cnpj_digits = re.sub(r'\D', '', str(cnpj or ''))
    if not cnpj_digits or not base.exists():
        return 0
    moved = 0
    canonical_root = base / _safe_filename(canonical_company)
    canonical_root.mkdir(parents=True, exist_ok=True)
    for path in list(base.rglob('*.xml')):
        # Do not reprocess files already under the canonical root.
        try:
            path.relative_to(canonical_root)
            continue
        except ValueError:
            pass
        try:
            data = path.read_bytes()
            meta = _parse_document_metadata(data, cnpj_digits, '')
        except Exception:
            continue
        # The parser already uses the consultation CNPJ to determine side/name.
        # If neither side contains that CNPJ, do not move the document.
        if not meta.get('empresa') or meta.get('empresa') == 'Empresa não identificada':
            continue
        # Validate by reading emit/dest CNPJ directly.
        try:
            import xml.etree.ElementTree as ET
            root = ET.fromstring(data)
            found = False
            for node in root.iter():
                if _local_tag(node) in ('emit','dest'):
                    for child in node.iter():
                        if _local_tag(child) in ('CNPJ','CPF') and re.sub(r'\D','',child.text or '') == cnpj_digits:
                            found = True; break
                if found: break
            if not found:
                continue
        except Exception:
            continue
        direction = _safe_filename(meta.get('direcao') or 'Entrada')
        dtype = _safe_filename(meta.get('tipo') or 'Documento')
        if path.name.lower().startswith('evento') or 'eventos' in [p.casefold() for p in path.parts]:
            dest_dir = canonical_root / 'Eventos' / dtype
        else:
            dest_dir = canonical_root / direction / dtype
        dest_dir.mkdir(parents=True, exist_ok=True)
        dest = dest_dir / path.name
        if dest.exists():
            if dest.read_bytes() == data:
                path.unlink(missing_ok=True)
                moved += 1
                continue
            stem, suffix = path.stem, path.suffix
            n = 2
            while (dest_dir / f'{stem}_{n}{suffix}').exists():
                n += 1
            dest = dest_dir / f'{stem}_{n}{suffix}'
        try:
            path.replace(dest)
            moved += 1
        except Exception:
            pass
    # Remove empty legacy folders after consolidation.
    for d in sorted([p for p in base.rglob('*') if p.is_dir()], key=lambda p: len(p.parts), reverse=True):
        if d == canonical_root or canonical_root in d.parents:
            continue
        try:
            next(d.iterdir())
        except StopIteration:
            try: d.rmdir()
            except Exception: pass
        except Exception:
            pass
    return moved


