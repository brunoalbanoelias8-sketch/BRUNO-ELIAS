$variants=@(); try{$variants=ConvertFrom-Json $MatchJson}catch{}
$sw=[Diagnostics.Stopwatch]::StartNew(); $result=[ordered]@{found=$false;selected=$false;title='';matched='';variants=$variants}
$root=[System.Windows.Automation.AutomationElement]::RootElement
while($sw.Elapsed.TotalSeconds -lt $TimeoutSec){
 try{
  $wins=$root.FindAll([System.Windows.Automation.TreeScope]::Children,[System.Windows.Automation.Condition]::TrueCondition)
  foreach($w in $wins){
   $name=[string]$w.Current.Name
   if([string]::IsNullOrWhiteSpace($name)){continue}
   if($name -notmatch '(?i)select.*certificate|selecione.*certificado|selecion.*certificado'){continue}
   $result.found=$true; $result.title=$name
   try{[ExatoWin32]::SetWindowPos([IntPtr]$w.Current.NativeWindowHandle,[IntPtr]::Zero,-2400,-1400,900,500,0x0010)|Out-Null}catch{}
   $desc=$w.FindAll([System.Windows.Automation.TreeScope]::Descendants,[System.Windows.Automation.Condition]::TrueCondition)
   $target=$null
   foreach($el in $desc){
    try{
     $et=$el.Current.ControlType.ProgrammaticName; $en=[string]$el.Current.Name
     if(-not $en -or $et -notmatch '(ListItem|DataItem|Text|Custom)'){continue}
     foreach($v in $variants){ if($v -and $en.IndexOf([string]$v,[StringComparison]::OrdinalIgnoreCase) -ge 0){$target=$el;$result.matched=$v;break} }
