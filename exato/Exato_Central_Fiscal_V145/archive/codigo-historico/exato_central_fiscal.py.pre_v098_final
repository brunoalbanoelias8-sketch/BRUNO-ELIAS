        if hasattr(self,'audit_ai_callout'): self.audit_ai_callout.config(bg=call)
        if hasattr(self,'audit_ai_tag'): self.audit_ai_tag.config(fg=accent)
        if hasattr(self,'audit_ai_title') and getattr(self,'last_audit_result',None): self.audit_ai_title.config(fg=accent)
        if hasattr(self,'audit_ai_next'):
            self.audit_ai_next.config(bg=nextbg,highlightbackground='#C7DCF7')
        if hasattr(self,'audit_ai_next_title'): self.audit_ai_next_title.config(fg=BLUE,bg=nextbg)
        if hasattr(self,'audit_ai_next_step'): self.audit_ai_next_step.config(bg=nextbg)
        if hasattr(self,'audit_status_banner'):
            self.audit_status_banner.config(bg=bg,highlightbackground=border)
