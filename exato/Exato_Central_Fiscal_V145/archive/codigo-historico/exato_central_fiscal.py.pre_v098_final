def _open_default_path(path):
    """Open a local file or folder with the platform default application."""
    p=Path(path)
    if os.name=='nt': os.startfile(str(p))
    elif sys.platform=='darwin': subprocess.Popen(['open',str(p)])
    else: subprocess.Popen(['xdg-open',str(p)])


def _document_family_from_row(row):
    row=row or {}
    fam=str(row.get('family') or '').casefold().strip()
    if fam in SUPPORTED_FAMILIES: return fam
    dtype=str(row.get('doc_type') or row.get('tipo') or '').casefold()
    return {'nfe':'nfe','nf-e':'nfe','nfeproc':'nfe','nfce':'nfce','nfc-e':'nfce','cte':'cte','cteproc':'cte'}.get(dtype,'')


def _fiscal_document_cache_path(row):
    row=row or {}; family=_document_family_from_row(row); cnpj=re.sub(r'\D','',str(row.get('cnpj') or ''))
    number=_safe_filename(row.get('number') or row.get('numero') or 'documento')
    key=_safe_filename(row.get('access_key') or row.get('chave') or row.get('doc_id') or hashlib.sha1((cnpj+'|'+number).encode()).hexdigest()[:12])
    prefix={'nfe':'NFe','nfce':'NFCe','cte':'CTe'}.get(family,'DOC')
    folder=APP_DATA_DIR/'Representacoes_Fiscais'/cnpj/(family or 'outros'); folder.mkdir(parents=True,exist_ok=True)
    return folder/f'{prefix}_{number}_{key}.pdf'


def open_document_fiscal_representation(row):
    """Open an individual DANFE/DANFE NFC-e/DACTE, reusing an existing PDF."""
    row=row or {}; family=_document_family_from_row(row); xml=row.get('xml') or b''
    if family not in SUPPORTED_FAMILIES: raise ValueError('Tipo documental não identificado para gerar a representação fiscal.')
    if isinstance(xml,memoryview): xml=xml.tobytes()
    if not isinstance(xml,(bytes,bytearray)) or not xml: raise ValueError('O XML original deste documento não está disponível.')
    path=_fiscal_document_cache_path(row)
    if not path.exists() or path.stat().st_size < 1000:
        payload={'xml':bytes(xml),'family':family,'doc_type':row.get('doc_type') or row.get('tipo') or family,
                 'chave':row.get('access_key') or row.get('chave') or '', 'numero':row.get('number') or row.get('numero') or '',
                 'serie':row.get('series') or row.get('serie') or '', 'data':str(row.get('issued_at') or row.get('data') or '')[:10],
                 'direcao':row.get('direction') or row.get('direcao') or ''}
        generate_fiscal_representation_pdf([payload],str(path),family=family)
    _open_default_path(path); return str(path)


def _document_view_xml_path(row):
    row=row or {}; family=_document_family_from_row(row); cnpj=re.sub(r'\D','',str(row.get('cnpj') or ''))
    number=_safe_filename(row.get('number') or row.get('numero') or 'documento')
    key=_safe_filename(row.get('access_key') or row.get('chave') or row.get('doc_id') or 'xml')
    folder=APP_DATA_DIR/'XML_Visualizacao'/cnpj/(family or 'outros'); folder.mkdir(parents=True,exist_ok=True)
    return folder/f'{key}_{number}.xml'


def save_document_xml_for_view(row):
    xml=(row or {}).get('xml') or b''
