def extract_document_id(text):
    digits = re.sub(r"\D", "", text or "")
    m = re.search(r"(\d{14})", digits)
    if m:
        cnpj = m.group(1)
        return f"{cnpj[:2]}.{cnpj[2:5]}.{cnpj[5:8]}/{cnpj[8:12]}-{cnpj[12:]}"
    m = re.search(r"(\d{11})", digits)
    if m:
        cpf = m.group(1)
        return f"{cpf[:3]}.{cpf[3:6]}.{cpf[6:9]}-{cpf[9:]}"
    return "Não identificado"


def classify_certificate(provider_name, subject, friendly_name):
    text = " ".join(filter(None, [provider_name, subject, friendly_name])).lower()
    smart_terms = [
        "smart card", "smartcard", "cartão", "card", "token", "minidriver",
        "gemalto", "safenet", "soluti smart", "serasa smart", "certisign smart",
    ]
    if any(term in text for term in smart_terms):
        return "Provável A3/token"
    if "microsoft software key storage provider" in text or "software key storage provider" in text:
        return "Provável A1"
    return "Não determinado"


def enumerate_windows_certificates():
    if os.name != "nt":
        return [], "Este teste precisa ser executado no Windows."

    ps = r'''
$ErrorActionPreference = 'Stop'
$stores = @('CurrentUser\\My','LocalMachine\\My')
$result = foreach ($store in $stores) {
    try {
        Get-ChildItem -Path ("Cert:\\" + $store) -ErrorAction Stop |
            Where-Object { $_.HasPrivateKey } |
            ForEach-Object {
                $provider = ''
                try {
                    if ($_.PrivateKey -and $_.PrivateKey.CspKeyContainerInfo) { $provider = $_.PrivateKey.CspKeyContainerInfo.ProviderName }
                } catch {}
                [PSCustomObject]@{
                    Thumbprint = $_.Thumbprint
                    Subject = $_.Subject
                    Issuer = $_.Issuer
                    FriendlyName = $_.FriendlyName
                    NotBefore = $_.NotBefore.ToString('o')
                    NotAfter = $_.NotAfter.ToString('o')
                    SerialNumber = $_.SerialNumber
                    HasPrivateKey = [bool]$_.HasPrivateKey
                    ProviderName = $provider
                    Store = $store
                }
            }
    } catch {}
}
$result | ConvertTo-Json -Compress
'''
    try:
        proc = subprocess.run(
            ["powershell.exe", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command", ps],
            capture_output=True,
            text=True,
            timeout=15,
            encoding="utf-8",
            errors="replace",
        )
        if proc.returncode != 0:
            return [], (proc.stderr.strip() or "Falha ao consultar o repositório de certificados do Windows.")
        raw = proc.stdout.strip()
        if not raw:
            return [], "Nenhum certificado com chave privada foi encontrado nos repositórios consultados."
        data = json.loads(raw)
        if isinstance(data, dict):
            data = [data]
        clean = []
        seen = set()
        now = datetime.now()
        for item in data:
            thumb = (item.get("Thumbprint") or "").replace(" ", "").upper()
            if not thumb or thumb in seen:
                continue
            seen.add(thumb)
            try:
                not_after = datetime.fromisoformat((item.get("NotAfter") or "").replace("Z", "+00:00")).replace(tzinfo=None)
            except Exception:
                not_after = None
            item["Document"] = extract_document_id(" ".join([
                item.get("Subject") or "", item.get("FriendlyName") or "", item.get("Issuer") or ""
            ]))
            item["Status"] = "Válido" if (not_after is None or not_after >= now) else "Expirado"
            item["TypeGuess"] = classify_certificate(
                item.get("ProviderName", ""), item.get("Subject", ""), item.get("FriendlyName", "")
            )
            clean.append(item)
        return clean, None
    except FileNotFoundError:
        return [], "PowerShell não foi encontrado neste Windows."
    except subprocess.TimeoutExpired:
        return [], "Tempo excedido ao consultar os certificados."
    except json.JSONDecodeError:
        return [], "O Windows retornou um formato inesperado ao listar os certificados."
    except Exception as exc:
        return [], f"Não foi possível listar os certificados: {exc}"


def _clean_response_text(text):
    return (text or "").replace("\r", " ").replace("\n", " ").strip()


def _safe_filename(value):
    text = re.sub(r"[^A-Za-z0-9._-]+", "_", str(value or "")).strip("._")
    return text or "arquivo"


def _save_webservice_diagnostic(info, family, cnpj, batch, request_nsu, diagnostic_dir):
    """Persist the raw SOAP response, decompressed lot and raw child XMLs for diagnosis.

    This is intentionally outside the normal document-export path. It lets us compare
    exactly what the SEF/SC Web Service returned with the XML later written by the Central.
    """
    if not diagnostic_dir:
        return None
    try:
        root = Path(diagnostic_dir)
        root.mkdir(parents=True, exist_ok=True)
        stamp = datetime.now().strftime('%Y%m%d_%H%M%S_%f')
        fam_dir = root / f"{int(batch):04d}_{_safe_filename(family)}_{_safe_filename(request_nsu)}_{stamp}"
        fam_dir.mkdir(parents=True, exist_ok=True)

        raw = info.get('raw') or ''
        if raw:
            (fam_dir / '01_resposta_soap_original.xml').write_bytes(
                raw.encode('utf-8', errors='replace')
            )
        lote_texto = info.get('lote_texto') or ''
        if lote_texto:
            (fam_dir / '02_lote_descompactado.xml').write_bytes(
                lote_texto.encode('utf-8', errors='replace')
            )

        docs = info.get('documents') or []
        manifest = {
            'familia': family,
            'ator': str(info.get('actor_label') or info.get('actor_code') or ''),
            'ator_codigo': str(info.get('actor_code') or ''),
            'cnpj': re.sub(r'\D', '', str(cnpj or '')),
            'lote': int(batch),
            'nsu_inicial': str(request_nsu),
            'cstat': str(info.get('cstat') or ''),
            'motivo': str(info.get('motivo') or ''),
            'ultNSU': str(info.get('ultNSU') or ''),
            'ultNSURet': str(info.get('ultNSURet') or ''),
            'qtDfeRet': str(info.get('qtDfeRet') or ''),
            'documentos_identificados': len(docs),
            'lote_bytes': int(info.get('lote_bytes') or 0),
            'tipos': list(info.get('tipos') or []),
            'arquivos': []
        }
        for idx, doc in enumerate(docs, start=1):
            xml = bytes(doc.get('xml') or b'')
            key = _safe_filename(doc.get('chave') or f"sem_chave_{idx}")
            ctag = _safe_filename(doc.get('tipo') or 'documento')
            target = fam_dir / f"03_{idx:03d}_{ctag}_{key}.xml"
            if xml:
                target.write_bytes(xml)
                manifest['arquivos'].append({
                    'arquivo': target.name,
                    'nsu': str(doc.get('nsu') or ''),
                    'chave': str(doc.get('chave') or ''),
                    'tipo': str(doc.get('tipo') or ''),
                    'bytes': len(xml)
                })

        (fam_dir / '04_manifesto.json').write_text(
            json.dumps(manifest, ensure_ascii=False, indent=2), encoding='utf-8'
        )
        return str(fam_dir)
    except Exception:
        return None



def _local_tag(elem):
    return elem.tag.rsplit('}', 1)[-1] if '}' in elem.tag else elem.tag


def _raw_document_blocks_from_lote(raw_bytes):
    """Yield raw child XML bytes from a distributed lot without re-serializing the signed XML.

    ElementTree.tostring() can rewrite namespace prefixes/namespace declarations and thereby
    invalidate the XML Digital Signature digest. This extractor keeps the original bytes from
    the SEF/SC response and only adds an XML declaration at file-export time when necessary.
    """
    import re
    if not isinstance(raw_bytes, (bytes, bytearray)):
        raw_bytes = str(raw_bytes or '').encode('utf-8')
    dist_pat = re.compile(rb'<(?:(?:[A-Za-z_][\w.-]*):)?dist(?:NFe|NFCe|CTe)SC\b[^>]*>.*?</(?:(?:[A-Za-z_][\w.-]*):)?dist(?:NFe|NFCe|CTe)SC>', re.S)
    child_pat = re.compile(rb'<(?:(?:[A-Za-z_][\w.-]*):)?(nfeProc|procEventoNFe|resNFe|resEvento|procEventoNFCe|cteProc|procEventoCTe)\b[^>]*>.*?</(?:(?:[A-Za-z_][\w.-]*):)?\1>', re.S)
    import xml.etree.ElementTree as ET
    for dist_match in dist_pat.finditer(raw_bytes):
        block = dist_match.group(0)
        try:
            item = ET.fromstring(block)
            nsu = item.attrib.get('NSU') or item.attrib.get('nsu') or ''
            chave = item.attrib.get('chAcesso') or item.attrib.get('chAcesso') or ''
        except Exception:
            # The embedded child can carry its own XML declaration. Parse only the
            # distribution header attributes in that case; raw child bytes remain untouched.
            open_tag = re.search(rb'^<(?:(?:[A-Za-z_][\w.-]*):)?dist(?:NFe|NFCe|CTe)SC\b([^>]*)>', block)
            attrs = open_tag.group(1) if open_tag else b''
            m_nsu = re.search(rb'\bNSU=[\"\']([^\"\']*)[\"\']', attrs, re.I)
            m_key = re.search(rb'\bchAcesso=[\"\']([^\"\']*)[\"\']', attrs, re.I)
            nsu = m_nsu.group(1).decode('utf-8','replace') if m_nsu else ''
            chave = m_key.group(1).decode('utf-8','replace') if m_key else ''
        for child_match in child_pat.finditer(block):
            ctag = child_match.group(1).decode('ascii', errors='replace')
            raw_child = child_match.group(0)
            yield nsu, chave, ctag, raw_child


def _ensure_xml_declaration(xml_bytes):
    """Return XML bytes unchanged, adding only a declaration when absent."""
    if not xml_bytes:
        return xml_bytes
    stripped = bytes(xml_bytes).lstrip()
    if stripped.startswith(b'<?xml'):
        return bytes(xml_bytes)
    return b'<?xml version="1.0" encoding="UTF-8"?>\n' + bytes(xml_bytes)


def _extract_access_key_from_xml(xml_bytes):
    import xml.etree.ElementTree as ET
    key=''
    try:
        root=ET.fromstring(xml_bytes)
    except Exception:
        return key
    for node in root.iter():
        tag=_local_tag(node); txt=(node.text or '').strip()
        if tag == 'chNFe' and txt:
            return txt
        if tag == 'chCTe' and txt:
            return txt
        if tag in ('infNFe','infCte'):
            ident=node.attrib.get('Id') or ''
            m=re.search(r'([A-Za-z0-9]{44})', ident)
            if m:
                key=m.group(1)
    return key


def _parse_sef_response(raw):
    import xml.etree.ElementTree as ET
    info = {
        'cstat':'não identificado','motivo':'','dh':'','ultNSU':'','maxNSU':'','ultNSURet':'',
        'qtDfeRet':'','docs':0,'schemas':[],'lote_presente':False,'lote_bytes':0,
        'lote_texto':'','lote_erro':'','tipos':[],'documents':[],'raw':raw or ''
    }
    try:
        root = ET.fromstring(raw)
    except Exception:
        return info

    lote_b64 = None
    for elem in root.iter():
        tag = _local_tag(elem)
        text = (elem.text or '').strip()
        if tag == 'cStat' and text: info['cstat'] = text
        elif tag == 'xMotivo' and text: info['motivo'] = text
        elif tag == 'dhResp' and text: info['dh'] = text
        elif tag == 'ultNSU' and text: info['ultNSU'] = text
        elif tag in ('maxNSU','maxNuNSU') and text: info['maxNSU'] = text
        elif tag in ('ultNSURet','ultNuNSURet') and text: info['ultNSURet'] = text
        elif tag in ('qtDfeRet','qtdDfeRet') and text: info['qtDfeRet'] = text
        elif tag == 'docZip' and text:
            info['docs'] += 1
            schema = elem.attrib.get('schema') or elem.attrib.get('Schema')
            if schema and schema not in info['schemas']: info['schemas'].append(schema)
        elif tag == 'loteDistComp' and text:
            lote_b64 = text

    if lote_b64:
        info['lote_presente'] = True
        try:
            compressed = base64.b64decode(lote_b64, validate=False)
            info['lote_bytes'] = len(compressed)
            decompressed = None
            errors = []
            for fn in (gzip.decompress, zlib.decompress):
                try:
                    decompressed = fn(compressed)
                    break
                except Exception as exc:
                    errors.append(str(exc))
            if decompressed is None:
                if compressed.lstrip().startswith(b'<'):
                    decompressed = compressed
                else:
                    raise ValueError('não foi possível descompactar loteDistComp')
            info['lote_texto'] = decompressed.decode('utf-8', errors='replace')
            try:
                lote_root = ET.fromstring(info['lote_texto'])
                raw_blocks = list(_raw_document_blocks_from_lote(decompressed))
                if raw_blocks:
                    for nsu, chave, ctag, xml_bytes in raw_blocks:
                        schema = ''
                        try:
                            child = ET.fromstring(xml_bytes)
                            schema = child.attrib.get('schema') or child.attrib.get('Schema') or ''
                            key = chave or _extract_access_key_from_xml(xml_bytes)
                        except Exception:
                            key = chave
                        if schema and schema not in info['schemas']:
                            info['schemas'].append(schema)
                        info['documents'].append({'nsu': nsu, 'chave': key, 'tipo': ctag, 'xml': bytes(xml_bytes)})
                        if ctag not in info['tipos']: info['tipos'].append(ctag)
                else:
                    # Fallback for unexpected lot layouts: preserve old behavior rather than
                    # dropping documents, while still using raw XML when possible.
                    for item in list(lote_root):
                        tag = _local_tag(item)
                        if tag != 'distNFeSC':
                            continue
                        nsu = item.attrib.get('NSU') or item.attrib.get('nsu') or ''
                        chave = item.attrib.get('chAcesso') or ''
                        for child in [c for c in list(item) if _local_tag(c) in ('nfeProc','procEventoNFe','resNFe','resEvento')]:
                            ctag = _local_tag(child); schema = child.attrib.get('schema') or child.attrib.get('Schema')
                            if schema and schema not in info['schemas']: info['schemas'].append(schema)
                            xml_bytes = ET.tostring(child, encoding='utf-8', xml_declaration=True)
                            info['documents'].append({'nsu': nsu, 'chave': chave or _extract_access_key_from_xml(xml_bytes), 'tipo': ctag, 'xml': xml_bytes})
                            if ctag not in info['tipos']: info['tipos'].append(ctag)
                info['docs'] = max(info['docs'], len(info['documents']))
            except Exception as exc:
                info['lote_erro'] = f'falha ao interpretar o XML interno: {exc}'
        except Exception as exc:
            info['lote_erro'] = str(exc)
    return info

