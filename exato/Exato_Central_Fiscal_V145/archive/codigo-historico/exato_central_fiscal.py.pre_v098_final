  try{foreach($c in $cookie.GetCookies([Uri]$u)){
    $same=($cookies | Where-Object {$_.Name -eq $c.Name -and $_.Domain -eq $c.Domain -and $_.Path -eq $c.Path})
    if(-not $same){$cookies+=@([PSCustomObject]@{Name=$c.Name;Value=$c.Value;Domain=$c.Domain;Path=$c.Path;Secure=[bool]$c.Secure;HttpOnly=[bool]$c.HttpOnly})}
  }}catch{}
}
$body=[string]$apps.Content
$success=($apps.Status -eq 200 -and ($apps.Url -match '(?i)/Apps\.aspx$') -and $cookies.Count -gt 0 -and ($body -match '(?i)Aplicações|Aplicacoes|Favoritos'))
[PSCustomObject]@{LoginStatus=$first.Status;DefaultStatus=$default.Status;DefaultLocation=$default.Location;AppsStatus=$apps.Status;AppsUrl=$apps.Url;ConsultStatus=$consult.Status;ConsultUrl=$consult.Url;CookieCount=$cookies.Count;Cookies=$cookies;Success=[bool]$success;RedirectChain=@($chain|ForEach-Object{[PSCustomObject]@{Status=$_.Status;Url=$_.Url;Location=$_.Location}})}|ConvertTo-Json -Depth 10 -Compress'''
