def _outside_period_documents(results, date_from='', date_to=''):
    """Find unique current-run documents that fall outside the selected period.
    This intentionally inspects only the current synchronization result, not the
    full persistent archive, so the notice never invents availability from old data.
    """
    found={}
    for res in (results or {}).values():
        for doc in (res or {}).get('documents') or []:
            d=str(doc.get('data') or doc.get('issued_at') or '')[:10]
            if not d: continue
            if date_from and d >= str(date_from)[:10] and (not date_to or d <= str(date_to)[:10]):
                continue
            if date_to and d > str(date_to)[:10]:
                pass
            elif date_from and d < str(date_from)[:10]:
                pass
            else:
                continue
            key=_normalize_access_key(doc.get('chave') or '') or f"{doc.get('family','')}|{d}|{doc.get('numero') or doc.get('number') or ''}"
            found[key]=(d,doc)
    groups={}
    for _,(d,doc) in found.items():
        month=d[:7]
        groups.setdefault(month,{'count':0,'examples':[]})
        groups[month]['count']+=1
        if len(groups[month]['examples'])<2:
            groups[month]['examples'].append(str(doc.get('numero') or doc.get('number') or ''))
    return groups


def _sort_document_exports(documents):
    def key(doc):
        d=str(doc.get('data') or doc.get('issued_at') or '')[:10]
        n=str(doc.get('numero') or doc.get('number') or '').strip()
        digits=re.sub(r'\D','',n)
        try: ni=int(digits) if digits else 10**12
        except Exception: ni=10**12
        return (d or '9999-99-99', ni, n.casefold(), _normalize_access_key(doc.get('chave') or ''))
    return sorted(list(documents or []), key=key)

