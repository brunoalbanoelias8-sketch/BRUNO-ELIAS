def create_data_backup(reason='manual'):
    """Create a safe local backup of persistent data without exporting certificates/keys."""
    APP_DATA_DIR.mkdir(parents=True, exist_ok=True)
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    safe_reason = _safe_filename(reason or 'backup')
    zip_path = BACKUP_DIR / f'Exato_Backup_{APP_VERSION}_{stamp}_{safe_reason}.zip'
    tmp_db = BACKUP_DIR / f'.central_fiscal_backup_{stamp}.db'
    try:
        if DB_PATH.exists():
            src = sqlite3.connect(DB_PATH, timeout=30)
            dst = sqlite3.connect(tmp_db)
            try:
                src.backup(dst)
            finally:
                dst.close(); src.close()
        with zipfile.ZipFile(zip_path, 'w', compression=zipfile.ZIP_DEFLATED) as z:
            if tmp_db.exists(): z.write(tmp_db, 'central_fiscal.db')
            for p, arc in ((CONFIG_PATH, 'config.json'), (AUDIT_HISTORY_PATH, 'auditoria_historico.json')):
                if p.exists(): z.write(p, arc)
            manifest = {
                'application': APP_NAME,
                'version': APP_VERSION,
                'created_at': datetime.now().isoformat(timespec='seconds'),
                'reason': str(reason),
                'data_dir': str(APP_DATA_DIR),
                'note': 'Backup local de dados e configuração; nenhuma chave privada foi exportada.'
            }
            z.writestr('backup_manifest.json', json.dumps(manifest, ensure_ascii=False, indent=2))
        return zip_path
    finally:
        try:
            tmp_db.unlink(missing_ok=True)
        except Exception:
            pass


def _prepare_persistent_storage():
    """Move legacy package-local data into the shared data directory conservatively."""
    APP_DATA_DIR.mkdir(parents=True, exist_ok=True)
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    legacy_pairs = [
        (APP_DIR / 'central_fiscal.db', DB_PATH),
        (APP_DIR / 'config.json', CONFIG_PATH),
        (APP_DIR / 'auditoria_historico.json', AUDIT_HISTORY_PATH),
    ]
    migrated = []
    for src, dst in legacy_pairs:
        try:
            if src.exists() and not dst.exists():
                shutil.copy2(src, dst)
                migrated.append(src.name)
        except Exception:
            continue
    state = _read_data_state()
    backup_created = ''
    if DB_PATH.exists() and state.get('last_backup_version') != APP_VERSION:
        try:
            p = create_data_backup(reason='antes_da_atualizacao')
            backup_created = str(p)
            state['last_backup_version'] = APP_VERSION
            state['last_backup_at'] = datetime.now().isoformat(timespec='seconds')
            state['last_backup_path'] = backup_created
            _write_data_state(state)
        except Exception:
            pass
    return {'migrated_files': migrated, 'backup_created': backup_created}


