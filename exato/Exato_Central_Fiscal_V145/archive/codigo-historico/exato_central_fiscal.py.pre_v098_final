def _ensure_reportlab():
    """Ensure the PDF engine is available for this installation.

    The application is commonly launched directly with Python on office PCs, so the
    launcher cannot be the only place responsible for the PDF dependency. If ReportLab
    is missing, install it for the current user and retry the import once.
    """
    global _REPORTLAB_READY
    if _REPORTLAB_READY:
        return True
    try:
        import reportlab  # noqa: F401
        _REPORTLAB_READY = True
        return True
    except Exception:
        pass
    try:
        cmd = [sys.executable, '-m', 'pip', 'install', '--user', '--disable-pip-version-check', 'reportlab>=4.0,<5']
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=90)
        if proc.returncode != 0:
            detail = (proc.stderr or proc.stdout or '').strip()
            raise RuntimeError(detail or 'Não foi possível instalar o componente do relatório PDF.')
        import importlib
        importlib.invalidate_caches()
        import reportlab  # noqa: F401
        _REPORTLAB_READY = True
        return True
    except Exception as exc:
        raise RuntimeError(
            'O gerador de PDF não está disponível neste computador. '
            'O sistema tentou preparar automaticamente o componente necessário, mas não conseguiu. '
            'Os documentos fiscais continuam preservados.\n\n'
            f'Detalhe técnico: {exc}'
        ) from exc


class InfoTip:
    """Contextual help bubble with safe screen-aware positioning."""
    def __init__(self, widget, title, text):
        self.widget = widget
        self.title = title
        self.text = text
        self.tip = None
        widget.bind('<Enter>', self.show, add='+')
        widget.bind('<Leave>', self.hide, add='+')
        widget.bind('<Button-1>', self.toggle, add='+')

    def _create(self):
        if self.tip and self.tip.winfo_exists():
            return
        self.widget.update_idletasks()
        width = 360
        height = 118
        x = self.widget.winfo_rootx() + self.widget.winfo_width() + 10
        y = self.widget.winfo_rooty() - 8
        sw = self.widget.winfo_screenwidth()
        sh = self.widget.winfo_screenheight()
        if x + width > sw - 12:
            x = self.widget.winfo_rootx() - width - 10
        if x < 8:
            x = 8
        if y + height > sh - 12:
            y = sh - height - 12
        if y < 8:
            y = 8
        self.tip = tk.Toplevel(self.widget)
        self.tip.overrideredirect(True)
        self.tip.attributes('-topmost', True)
        outer = tk.Frame(self.tip, bg='#D9DDE3')
        outer.pack(padx=1, pady=1)
        frame = tk.Frame(outer, bg=WHITE)
        frame.pack()
        tk.Frame(frame, bg=RED, height=4, width=360).pack(fill='x')
        tk.Label(frame, text=self.title, bg=WHITE, fg=TEXT,
                 font=('Segoe UI Semibold', 9), anchor='w').pack(fill='x', padx=15, pady=(10,3))
        tk.Label(frame, text=self.text, bg=WHITE, fg='#475467',
                 font=('Segoe UI', 9), wraplength=330, justify='left', anchor='w').pack(fill='x', padx=15, pady=(0,12))
        self.tip.update_idletasks()
        tip_h=max(78, outer.winfo_reqheight()+2)
        # Recalcula a posição vertical para manter o balão junto ao ícone e dentro da tela.
        y=self.widget.winfo_rooty()-tip_h//3
        if y+tip_h>sh-8: y=sh-tip_h-8
        if y<8: y=8
        self.tip.geometry(f'360x{tip_h}+{int(x)}+{int(y)}')

    def show(self, event=None):
        self._create()
    def hide(self, event=None):
        if self.tip:
            try:
                self.tip.destroy()
            except Exception:
                pass
            self.tip = None
    def toggle(self, event=None):
        if self.tip:
            self.hide()
        else:
            self._create()


