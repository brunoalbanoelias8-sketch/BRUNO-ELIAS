    def _audit_apply_ai_theme(self,status='conforme'):
        if status=='conforme':
            bg='#ECF8F0'; accent=GREEN; call='#DDF2E6'; border='#C8E5D1'; nextbg='#EEF6FF'; icon='✓'; side='Tudo certo por aqui!'
        elif status=='divergencia':
            bg='#FFF0F1'; accent=RED; call='#FFE0E3'; border='#F0C6CA'; nextbg='#FFF7E8'; icon='!'; side='Vale revisar os documentos destacados.'
        else:
            bg='#FFF7E8'; accent=ORANGE; call='#FFF0D6'; border='#F1D49B'; nextbg='#EEF6FF'; icon='!'; side='Vamos conferir esses pontos com calma.'
        # Keep the mascot column white; only the AI workspace takes the result tone.
        for w in (getattr(self,'audit_ai_mid',None),getattr(self,'audit_ai_tag',None),getattr(self,'audit_ai_title',None),getattr(self,'audit_ai_message',None),getattr(self,'audit_ai_chat_frame',None),getattr(self,'audit_ai_chat_canvas',None),getattr(self,'audit_ai_chat_host',None)):
