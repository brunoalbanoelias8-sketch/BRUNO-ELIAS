    ok=info['cstat'] not in {'9999','215','280','657'}
    return ok, '\n'.join(summary), info



def _parse_sef_response_flexible(raw, family='nfe'):
    import xml.etree.ElementTree as ET
    info={'cstat':'não identificado','motivo':'','dh':'','ultNSU':'','maxNSU':'','ultNSURet':'','qtDfeRet':'','docs':0,'schemas':[],'lote_presente':False,'lote_bytes':0,'lote_texto':'','lote_erro':'','tipos':[],'documents':[],'raw':raw or '', 'family':family}
    try: root=ET.fromstring(raw)
    except Exception: return info
    lote_b64=None
    for elem in root.iter():
        tag=_local_tag(elem); text=(elem.text or '').strip()
        if tag=='cStat' and text: info['cstat']=text
        elif tag=='xMotivo' and text: info['motivo']=text
        elif tag=='dhResp' and text: info['dh']=text
        elif tag in ('ultNSU','ultNuNSU') and text: info['ultNSU']=text
        elif tag in ('maxNSU','maxNuNSU') and text: info['maxNSU']=text
        elif tag in ('ultNSURet','ultNuNSURet') and text: info['ultNSURet']=text
        elif tag in ('qtDfeRet','qtdDfeRet') and text: info['qtDfeRet']=text
        elif tag=='loteDistComp' and text: lote_b64=text
    if not lote_b64: return info
    info['lote_presente']=True
    try:
        compressed=base64.b64decode(lote_b64,validate=False); info['lote_bytes']=len(compressed)
        decompressed=None
        for fn in (gzip.decompress,zlib.decompress):
            try: decompressed=fn(compressed); break
            except Exception: pass
        if decompressed is None:
            if compressed.lstrip().startswith(b'<'): decompressed=compressed
            else: raise ValueError('não foi possível descompactar o lote')
        info['lote_texto']=decompressed.decode('utf-8',errors='replace')
        lote_root=ET.fromstring(info['lote_texto'])
        for item in lote_root.iter():
            if _local_tag(item) not in ('distNFeSC','distNFCeSC','distCTeSC'): continue
            nsu=item.attrib.get('NSU') or item.attrib.get('nsu') or ''
            chave=item.attrib.get('chAcesso') or ''
            raw_blocks = list(_raw_document_blocks_from_lote(decompressed))
            if raw_blocks:
                for nsu2, chave2, ctag, xml_bytes in raw_blocks:
                    if nsu2 != nsu:
                        continue
                    schema=''
                    try:
                        child=ET.fromstring(xml_bytes)
                        schema=child.attrib.get('schema') or child.attrib.get('Schema') or ''
                    except Exception:
                        pass
                    if schema and schema not in info['schemas']: info['schemas'].append(schema)
                    key=chave2 or _extract_access_key_from_xml(xml_bytes)
                    info['documents'].append({'nsu':nsu2 or nsu,'chave':key,'tipo':ctag,'xml':bytes(xml_bytes),'family':family})
                    if ctag not in info['tipos']: info['tipos'].append(ctag)
            else:
                children=[c for c in list(item) if _local_tag(c) in ('nfeProc','procEventoNFe','resNFe','resEvento','procEventoNFCe','cteProc','procEventoCTe')]
                for child in children:
                    ctag=_local_tag(child); schema=child.attrib.get('schema') or child.attrib.get('Schema')
                    if schema and schema not in info['schemas']: info['schemas'].append(schema)
                    xml_bytes=ET.tostring(child,encoding='utf-8',xml_declaration=True)
                    key=chave or _extract_access_key_from_xml(xml_bytes)
                    info['documents'].append({'nsu':nsu,'chave':key,'tipo':ctag,'xml':xml_bytes,'family':family})
                    if ctag not in info['tipos']: info['tipos'].append(ctag)
        info['docs']=len(info['documents'])
    except Exception as exc:
        info['lote_erro']=f'falha ao interpretar o lote: {exc}'
    return info


