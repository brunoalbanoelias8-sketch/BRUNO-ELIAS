def _find_previous_installation():
    """Find the richest previous Exato Central Fiscal installation beside this version.

    New ZIP versions are commonly extracted into sibling folders (V061, V062, ...).
    The application must never silently start with an empty database when an older
    validated installation already contains the company's documents/checkpoints.
    """
    m=re.search(r'_V(\d+)$', APP_DIR.name, re.I)
    current=int(m.group(1)) if m else 0
    candidates=[]
    for child in APP_DIR.parent.iterdir():
        if not child.is_dir() or child.resolve()==APP_DIR.resolve():
            continue
        mm=re.match(r'^Exato_Central_Fiscal_V(\d+)$', child.name, re.I)
        if not mm:
            continue
        ver=int(mm.group(1))
        if ver>=current:
            continue
        db=child/'central_fiscal.db'; cfg=child/'config.json'
        count=_safe_read_db_count(db)
        if db.exists() or cfg.exists():
            candidates.append((count,ver,child))
    if not candidates:
        return None
    # Prefer the installation with the richest durable index; version breaks ties.
    candidates.sort(key=lambda x:(x[0],x[1]), reverse=True)
    return candidates[0][2]


def _merge_previous_installation():
    """Merge prior local DB/config into the current version, without overwriting data.

    This is a one-time startup migration. It is deliberately conservative: current
    documents/checkpoints are retained, while missing records and higher NSUs from a
    richer previous installation are brought forward.
    """
    previous=_find_previous_installation()
    if previous is None:
        return {'migrated':False,'source':''}
    init_database()
    src_db=previous/'central_fiscal.db'
    if src_db.exists() and _safe_read_db_count(src_db)>0:
        conn=sqlite3.connect(DB_PATH, timeout=30)
        try:
            conn.execute("ATTACH DATABASE ? AS olddb", (str(src_db),))
            for table in ('companies','documents','document_sources','audit_runs','sync_runs'):
                try:
                    cols=[r[1] for r in conn.execute(f'PRAGMA table_info({table})').fetchall()]
                    oldcols=[r[1] for r in conn.execute(f'PRAGMA olddb.table_info({table})').fetchall()]
                    common=[c for c in cols if c in oldcols]
                    if not common: continue
                    colsql=','.join(common)
                    conn.execute(f'INSERT OR IGNORE INTO {table} ({colsql}) SELECT {colsql} FROM olddb.{table}')
                except Exception:
                    continue
            conn.commit()
        finally:
            try: conn.execute('DETACH DATABASE olddb')
            except Exception: pass
            conn.close()
    # Merge config conservatively, preserving current selected certificate/config values.
    try:
        current=load_config()
    except Exception:
        current={}
    try:
        older=json.loads((previous/'config.json').read_text(encoding='utf-8')) if (previous/'config.json').exists() else {}
    except Exception:
        older={}
    merged=dict(older)
    merged.update(current)
    old_states=older.get('sync_state') or {}; cur_states=current.get('sync_state') or {}
    merged_states=dict(old_states); merged_states.update(cur_states)
    for key,item in old_states.items():
        if key not in cur_states: continue
        a=cur_states.get(key) or {}; b=item or {}
        try:
            if int(str(b.get('last_saved_nsu') or 0))>int(str(a.get('last_saved_nsu') or 0)):
                merged_states[key]=dict(b, **{k:v for k,v in a.items() if k not in {'last_saved_nsu'}})
        except Exception:
            pass
    merged['sync_state']=merged_states
    if older.get('selected_certificate_thumbprint') and not current.get('selected_certificate_thumbprint'):
        merged['selected_certificate_thumbprint']=older.get('selected_certificate_thumbprint')
        merged['selected_certificate_subject']=older.get('selected_certificate_subject','')
        merged['selected_certificate_document']=older.get('selected_certificate_document','')
        merged['selected_at']=older.get('selected_at','')
    try:
        save_config(merged)
    except Exception:
        pass
    try:
        (APP_DIR/'MIGRACAO_V068.txt').write_text(
            f'Migração automática de continuidade realizada a partir de: {previous}\n'
            f'Data/hora: {datetime.now().isoformat(timespec="seconds")}\n'
            'Os documentos e checkpoints anteriores foram preservados/mesclados.\n', encoding='utf-8')
    except Exception: pass
    return {'migrated':True,'source':str(previous)}


