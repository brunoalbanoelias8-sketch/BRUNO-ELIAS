    def answer(self,question):
        q=self._norm(question)
        number=self._extract_number(q)
        # Specific document first, so “o que aconteceu com a nota 1048?” wins over generic intents.
        if number:
            row=self._row_by_number(number)
            if row:
                return self._row_description(row)
            return f'Não localizei a nota {number} no universo desta auditoria.'
        if any(k in q for k in ('dia com mais','maior movimento','mais movimento','maior movimentacao','maior movimentação')):
            if not self.by_day: return 'Não há datas suficientes no resultado para identificar um dia de maior movimento.'
            ordered=sorted(self.by_day.items(), key=lambda x:(-x[1],x[0]))
            top=ordered[0]; others=', '.join(f'{_format_user_date(d)} ({c})' for d,c in ordered[1:4])
            return f'O dia de maior movimento foi {_format_user_date(top[0])}, com {top[1]} documento(s).' + (f' Os seguintes foram {others}.' if others else '')
        if any(k in q for k in ('ticket medio','ticket médio','valor medio','valor médio','media por documento','média por documento')):
            return f'O valor médio por documento foi { _format_brl(self.average) } considerando os {self.total} documento(s) do universo analisado.'
        if any(k in q for k in ('maior valor','maior movimentacao por valor','maior movimentação por valor','nota de maior valor')):
            if not self.max_value: return 'Não há valores suficientes para identificar a maior movimentação.'
            return f'A maior movimentação foi a nota {self.max_value.get("numero") or "—"}, com {_format_brl(self.max_value.get("valor_sat") or 0)}.'
        if any(k in q for k in ('menor valor','menor movimentacao','menor movimentação')):
            if not self.min_value: return 'Não há valores suficientes para identificar a menor movimentação.'
            return f'A menor movimentação foi a nota {self.min_value.get("numero") or "—"}, com {_format_brl(self.min_value.get("valor_sat") or 0)}.'
        if any(k in q for k in ('qual nota merece','qual documento merece','qual nota devo revisar','qual documento devo revisar','nota devo revisar','documento devo revisar','por onde eu começo','primeiro documento','primeira nota','atenção primeiro','revisar primeiro','maior diferença','maior diferenca')):
            if self.divergent:
                row=max(self.divergent,key=lambda r:abs(self._row_value_difference(r)))
                return f'Eu começaria pela nota {row.get("numero") or "—"}. Ela concentra a maior diferença de valor entre os documentos divergentes.'
            if self.missing:
                row=max(self.missing,key=lambda r:self._money(r.get('valor_sat')))
                return f'Eu começaria pela nota {row.get("numero") or "—"}, que está sem XML localizado e tem valor de {_format_brl(row.get("valor_sat") or 0)}.'
            return 'Não encontrei um documento que mereça prioridade sobre os demais; a auditoria ficou sem pendências e sem divergências.'
        if any(k in q for k in ('pendencia','pendência','sem xml','xml faltando','xml não localizado','xml nao localizado')):
            return self._document_list(self.missing,'documento(s) sem XML localizado') if self.missing else 'Não há documentos sem XML localizado nesta auditoria.'
        if any(k in q for k in ('maior diferenca','maior diferença')):
            diffs=[]
            for row in self.rows:
                try: dv=abs(float(row.get('sat_value') or 0)-float(row.get('xml_value') or 0))
                except Exception: dv=0.0
                if dv>0: diffs.append((dv,row))
            diffs.sort(key=lambda x:(-x[0], _natural_number_key(x[1].get('number') or x[1].get('numero') or '')))
            if diffs:
                dv,row=diffs[0]; num=row.get('number') or row.get('numero') or 'não identificado'; satv=row.get('sat_value'); xmlv=row.get('xml_value')
                return f'A maior diferença de valor está na nota {num}: SAT {self._money(satv)} × XML {self._money(xmlv)}, diferença de {self._money(dv)}.'
            return 'Não há diferenças de valor registradas na conciliação.'
        if any(k in q for k in ('divergencia','divergência','diferenca de valor','diferença de valor','erro de valor')):
            return self._document_list(self.divergent,'documento(s) com divergência') if self.divergent else 'Não há documentos classificados como divergência nesta auditoria.'
        if any(k in q for k in ('compar','sat e xml','sat x xml','totais')):
            return self._comparison_answer()
        if any(k in q for k in ('quanto foi','valor conciliado','quanto conciliado','total conciliado')):
            return f'O valor conciliado foi {_format_brl(self.matched_sat_total)}.'
        if any(k in q for k in ('valor total sat','total sat','quanto aparece no sat')):
            return f'O SAT apresenta {_format_brl(self.sat_total)} considerando os {self.total} documento(s) auditados.'
        if any(k in q for k in ('quantos documentos','quantidade de documentos','numero de documentos','número de documentos','quantidade')):
            return f'Foram analisados {self.total} documento(s): {len(self.conform)} conformes, {len(self.missing)} sem XML localizado e {len(self.divergent)} com divergências.'
        if any(k in q for k in ('qual o periodo','qual o período','qual periodo','qual é o periodo','qual é o período')):
            ps=self.result.get('period_start') or ''; pe=self.result.get('period_end') or ''
            if ps and pe: return f'O período auditado foi {_format_user_date(ps)} até {_format_user_date(pe)}.'
            return 'O período da auditoria não está informado no resultado atual.'
        if any(k in q for k in ('percentual','porcentagem','percent')):
            return f'A taxa de conciliação é de {self.matched_pct:.1f}%. As pendências representam {self.missing_pct:.1f}% e as divergências {self.div_pct:.1f}% do universo.'
        if any(k in q for k in ('dia','data','periodo','período')) and not self.by_day:
            return 'O período desta auditoria não possui datas suficientes para uma análise temporal.'
        if any(k in q for k in ('tipo de documento','qual documento','modelo','nfe','nf-e','nfce','nfc-e')):
            return f'Esta auditoria está configurada para {self.family_label}, modelo {self.model}.'
        if any(k in q for k in ('grave','preocupante','devo me preocupar','risco')):
            if self.divergent or self.missing:
                return f'Eu não classificaria a situação como “grave” apenas pelos dados disponíveis. O que consigo afirmar é que há {len(self.divergent)} divergência(s) e {len(self.missing)} pendência(s) de XML, então vale revisar os pontos destacados antes de concluir a apuração.'
            return 'Não apareceu um sinal objetivo de problema nos dados desta auditoria. A conferência ficou conforme.'
        if any(k in q for k in ('analise geral','análise geral','me explica','explique a auditoria','resumo','visao geral','visão geral')):
            return self._analysis_answer()
        if any(k in q for k in ('status','resultado','esta tudo certo','tá tudo certo','tudo certo','esta conforme','conforme')):
            return self._status_answer()
        # Open question: produce a context-aware mini briefing rather than a static fallback.
        details=[self._status_answer()]
        if self.top_day and self.top_day_count>1: details.append(f'O maior volume ficou em {_format_user_date(self.top_day)}, com {self.top_day_count} documento(s).')
        if self.max_value: details.append(f'A maior nota por valor foi a {self.max_value.get("numero") or "—"}, com {_format_brl(self.max_value.get("valor_sat") or 0)}.')
        if self.missing: details.append(f'Há {len(self.missing)} documento(s) sem XML localizado.')
        if self.divergent: details.append(f'Há {len(self.divergent)} divergência(s) para revisão.')
        return ' '.join(details)



def exato_ia_answer_question(question, result, company_name='', conversation_history=None):
