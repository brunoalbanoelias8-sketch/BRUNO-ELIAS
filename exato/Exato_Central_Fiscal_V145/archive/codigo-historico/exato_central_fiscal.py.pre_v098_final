        base=re.sub(r'\s*:\s*\d{8,}$','',value).strip() if value else ''
        if base and base not in variants: variants.append(base)
    result_path=str(result_path or (APP_DIR/'SAT_CERT_DIALOG_RESULT.json'))
    try: Path(result_path).unlink(missing_ok=True)
    except Exception: pass
    ps=r'''param([string]$MatchJson,[int]$TimeoutSec,[string]$ResultPath)
