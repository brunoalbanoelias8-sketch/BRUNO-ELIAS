def _sat_wait_query_result(page, timeout_ms=60000, response=None):
    """Wait until the SAT POST/XHR has actually updated the query result."""
    if response is not None:
        try:
            if int(response.status) >= 400:
                raise RuntimeError(f'O SAT retornou HTTP {response.status} na consulta.')
        except AttributeError:
            pass
    deadline=time.monotonic()+max(5,timeout_ms/1000.0)
    while time.monotonic()<deadline:
        try:
            body=(page.locator('body').inner_text(timeout=1500) or '').casefold()
            if any(t in body for t in ('nenhum registro','nenhum documento','não foram encontrados registros','nao foram encontrados registros','nenhuma nota encontrada','0 documento(s)')):
                return True
            if 'exibindo' in body and 'registros' in body:
                return True
            try:
                results_table=page.locator('table').filter(has_text=re.compile(r'Situação',re.I)).first
                if results_table.count() and results_table.locator('tbody tr').count()>0:
                    return True
            except Exception:
                pass
        except Exception:
            pass
        try: page.wait_for_timeout(400)
        except Exception: time.sleep(0.4)
    return False


def _sat_export_current_result(page, download_dir, timeout_ms=45000):
    export_btn=_sat_button(page,['Exportar'])
    if export_btn is None:
        # Some builds use an image/link. Fall back to visible text/links.
        export_btn=page.locator('a,button,input').filter(has_text=re.compile(r'Exportar',re.I)).first
    if export_btn is None or not export_btn.count():
        raise RuntimeError('O SAT não apresentou o comando de exportação do resultado.')
    with page.expect_download(timeout=timeout_ms) as info:
        export_btn.click()
    download=info.value
    target=Path(download_dir)/download.suggested_filename
    download.save_as(str(target))
    if not target.exists() or target.stat().st_size < 100:
        raise RuntimeError('O SAT iniciou a exportação, mas o arquivo não foi recebido corretamente.')
    return target


def _sat_probe_direct_tls_certificate(selected_certificate=None, timeout=20):
