def _sat_find_field(page, labels, input_type=None):
    """Best-effort control lookup for the SAT's ASP.NET form.

    The portal is server-rendered and its generated ids can change. We therefore
    avoid hard-coding one control id and first try semantic labels, then nearby
    input/select elements and finally common name/id fragments.
    """
    labels=[str(x).strip() for x in labels if str(x).strip()]
    for label in labels:
        try:
            loc=page.get_by_label(label, exact=False).first
            if loc.count():
                return loc
        except Exception:
            pass
        try:
            loc=page.locator(f'input[aria-label*="{label}"]' if input_type!='select' else f'select[aria-label*="{label}"]').first
            if loc.count(): return loc
        except Exception:
            pass
    # Inspect all form controls and compare their nearby text/id/name.
    try:
        controls=page.locator('input, select, textarea').all()
        for c in controls:
            try:
                tag=(c.evaluate('(el)=>el.tagName') or '').lower()
                typ=(c.get_attribute('type') or '').lower()
                if input_type=='select' and tag!='select':
                    continue
                if input_type and input_type!='select' and typ and typ!=input_type:
                    continue
                attrs=' '.join(filter(None,[c.get_attribute('id'),c.get_attribute('name'),c.get_attribute('placeholder'),c.get_attribute('aria-label')])).casefold()
                if any(lbl.casefold() in attrs for lbl in labels):
                    return c
            except Exception:
                continue
    except Exception:
        pass
    return None


def _sat_find_select(page, labels, option_texts):
    # Direct label / generated id attempts.
    loc=_sat_find_field(page, labels, input_type='select')
    if loc is not None:
        for text in option_texts:
            try:
                loc.select_option(label=text)
                return loc
            except Exception:
                pass
            try:
                # Match by option text/substring.
                loc.select_option(value=text)
                return loc
            except Exception:
                pass
    # Search all select elements by their option texts.
    try:
        sels=page.locator('select')
        for i in range(sels.count()):
            sel=sels.nth(i)
            txt=(sel.inner_text() or '').casefold()
            if any(t.casefold() in txt for t in option_texts):
                for option in option_texts:
                    try:
                        sel.select_option(label=option)
                        return sel
                    except Exception:
                        continue
    except Exception:
        pass
    return None


def _sat_fill_by_hints(page, hints, value):
    loc=_sat_find_field(page,hints,input_type='text')
    if loc is None:
        # fallback: name/id fragments
        for hint in hints:
            try:
                q=page.locator('input').filter(has_text='')
            except Exception:
                q=None
            if q is not None:
                try:
                    for attr in ('id','name','placeholder','aria-label'):
                        cand=page.locator(f'input[{attr}*="{hint}"]' if attr in ('id','name') else f'input[{attr}*="{hint}"]').first
                        if cand.count(): loc=cand; break
                except Exception:
                    pass
            if loc is not None: break
    if loc is None:
        return False
    try:
        loc.fill(str(value or ''))
        return True
    except Exception:
        return False


def _sat_clear_by_hints(page,hints):
    return _sat_fill_by_hints(page,hints,'')


def _sat_button(page, names):
    for name in names:
        try:
            loc=page.get_by_role('button',name=re.compile(re.escape(name),re.I)).first
            if loc.count(): return loc
        except Exception: pass
        try:
            loc=page.get_by_text(re.compile(r'^\s*'+re.escape(name)+r'\s*$',re.I)).first
            if loc.count(): return loc
        except Exception: pass
        try:
            loc=page.locator(f'input[type="submit"][value*="{name}"]').first
            if loc.count(): return loc
        except Exception: pass
    return None


def _sat_has_human_challenge(page):
    """Detect an unsolved human-security challenge without treating a successful Cloudflare widget as an error."""
    try:
        body=(page.locator('body').inner_text(timeout=2000) or '').casefold()
    except Exception:
        body=''
    solved=('sucesso!' in body)
    terms=('verifique se é humano','verifique se você é humano','verifique se voce é humano','não sou um robô','nao sou um robo','desafio de segurança','checking your browser','just a moment','attention required')
    if solved and not any(t in body for t in terms):
        return False
    return any(t in body for t in terms)


