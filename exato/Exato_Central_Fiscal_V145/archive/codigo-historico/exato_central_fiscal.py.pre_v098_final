                if len(detected)>1:
                    labels=', '.join(SUPPORTED_FAMILIES.get(f,f) for f in sorted(detected))
                    raise ValueError(f'Os arquivos selecionados misturam tipos de documento ({labels}). Uma auditoria deve conter apenas um tipo documental.')
                seen=set(); sat_rows=[]
                for r in all_rows:
                    k=_audit_key(r)
                    if k in seen: continue
                    seen.add(k); sat_rows.append(r)
                if self.audit_cancel_event.is_set(): raise AuditCancelled('Auditoria cancelada pelo usuário.')
                self.after(0,lambda n=len(sat_rows),fam=family:self.audit_progress_label.config(text=f'Conferindo {n} documento(s) de {SUPPORTED_FAMILIES[fam]} com os XMLs da Central...',fg=BLUE))
