     try{$target.SetFocus();[System.Windows.Forms.SendKeys]::SendWait('{ENTER}');$result.selected=$true}catch{}
    }
   }
   if($result.selected){
    Start-Sleep -Milliseconds 180
    foreach($b in $desc){try{$bt=$b.Current.ControlType.ProgrammaticName;$bn=[string]$b.Current.Name;if($bt -match 'Button' -and $bn -match '^(OK|Ok|Confirmar|Confirm|&?OK)$'){$inv=$b.GetCurrentPattern([System.Windows.Automation.InvokePattern]::Pattern);$inv.Invoke();break}}catch{}}
    try{[System.Windows.Forms.SendKeys]::SendWait('{ENTER}')}catch{}
