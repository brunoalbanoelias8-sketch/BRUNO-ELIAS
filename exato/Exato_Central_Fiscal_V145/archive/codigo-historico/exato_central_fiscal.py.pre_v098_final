    searched,sc=_sat_follow(session['curl'],session['jar'],session['thumbprint'],action,'POST',pairs,page['url'],timeout_sec=60,cancel_cb=cancel_cb)
    if 'Login.aspx' in searched['url']: raise RuntimeError('O SAT perdeu a sessão autenticada durante a consulta.')
    html2=searched['body'].decode('utf-8','ignore'); parser2=_sat_parse_form(html2)
    exp=next((c for c in parser2.controls if _sat_norm_text(c.get('value') or c.get('text'))=='exportar'),None)
    out=Path(download_dir)/f'{idx:02d}_{document_label.replace("-","_")}_{direction_label.replace(" ","_")}.xlsx'
    if exp and exp.get('name'):
        ep=_sat_build_form_payload(parser2,{},'Exportar'); ea=_sat_form_action(parser2,searched['url'])
        exported,ec=_sat_follow(session['curl'],session['jar'],session['thumbprint'],ea,'POST',ep,searched['url'],output_path=out,timeout_sec=60,cancel_cb=cancel_cb)
        raw=out.read_bytes() if out.exists() else b''
        if raw.startswith(b'PK'):
            parsed=_xlsx_read_values(out); return parsed['rows'],{'documento':document_label,'direcao':direction_label,'status':'ok','arquivo':str(out),'registros':len(parsed['rows'])}
    rows=_sat_parse_result_table(html2)
    return rows,{'documento':document_label,'direcao':direction_label,'status':'ok_html','arquivo':'','registros':len(rows)}

