    def _refresh_documents_dashboard_visuals(self):
        """Refresh the capture dashboard using only documents inside the selected period."""
        try:
            docs=list(getattr(self,'last_documents',[]) or [])
            df,dt=getattr(self,'_capture_period_snapshot',('',''))
            docs=self._filter_documents_for_capture_view(docs,df,dt)
            total=len(docs)
            if hasattr(self,'total_docs_label'):
                self.total_docs_label.config(text=f'{total:,}'.replace(',','.'))
            if hasattr(self,'sync_summary_labels'):
                self.sync_summary_labels['presented'].config(text=f'{total:,}'.replace(',','.'))
                self.sync_summary_labels['new'].config(text=str(getattr(self,'_last_sync_new_count',0)))
                self.sync_summary_labels['existing'].config(text=str(getattr(self,'_last_sync_duplicate_count',0)))
            if hasattr(self,'sync_completion_label'):
                state=getattr(self,'_last_sync_status','Pronto para consulta')
                color=GREEN if state in ('Concluído','Pronto para consulta') else ORANGE
                bg='#ECFDF3' if state in ('Concluído','Pronto para consulta') else '#FFFAEB'
                self.sync_completion_label.config(text='●  '+state,fg=color,bg=bg)
            if not hasattr(self,'docs_chart_canvas'): return
            cv=self.docs_chart_canvas; cv.delete('all'); cv.update_idletasks(); w=max(cv.winfo_width(),420); h=120
            counts={}
            for d in docs:
                date=str(d.get('data') or d.get('issued_at') or '')[:10]
                if date: counts[date]=counts.get(date,0)+1
            dates=sorted(counts)
            if not dates:
                cv.create_text(w/2,45,text='Nenhum documento no período',fill=MUTED,font=('Segoe UI',9)); return
            if len(dates)>31: dates=dates[-31:]
            maxv=max((counts.get(d,0) for d in dates),default=1) or 1
            left=12; right=w-10; bottom=h-24; chart_h=h-42; slot=(right-left)/max(1,len(dates)); bar_w=max(5,slot-3)
            for i,d in enumerate(dates):
                x=left+i*slot; bh=(counts.get(d,0)/maxv)*chart_h
                cv.create_rectangle(x,bottom-bh,x+bar_w,bottom,fill=NFCE_ACCENT,outline='')
                if i in (0,len(dates)//2,len(dates)-1):
                    cv.create_text(x+bar_w/2,bottom+11,text=_format_user_date(d)[:5],fill=MUTED,font=('Segoe UI',7))
            cv.create_line(left,bottom,right,bottom,fill='#E4E7EC')
            if hasattr(self,'docs_chart_subtitle'):
                self.docs_chart_subtitle.config(text=f'{maxv} documento(s) no dia de maior movimentação.' if maxv else 'Distribuição dos documentos encontrados no período.')
        except Exception:
            pass


    def _confirm_period(self):
        try:
            df,dt=self._get_capture_period()
        except ValueError as exc:
            messagebox.showerror('Período inválido',str(exc)); return
        if not df and not dt:
            label='Todo o período disponível'
        else:
            label=self._capture_period_label(df,dt)
        self._capture_period_snapshot=(df,dt)
        if hasattr(self,'sync_outside_period_label'): self.sync_outside_period_label.pack_forget()
        self._period_confirmed=True
        self.period_status.config(text=f'Período selecionado: {label}',fg=GREEN)
        self.progress_title.config(text='Período confirmado. Pronto para buscar XML')
        self.progress_subtitle.config(text=f'Os documentos serão consultados para {label.lower()}.')
        self._set_sync_controls(False)
        self._write_result(f'Período selecionado: {label}.\n\nAgora clique em BUSCAR XML para consultar os documentos disponíveis.')
        self.set_status(f'Período selecionado: {label}.')

    def _get_capture_period(self):
        if not hasattr(self,'capture_from') or not hasattr(self,'capture_to'):
            return '',''
        df=_parse_user_date(self.capture_from.get(),'data inicial da captura') if self.capture_from.get().strip() else ''
        dt=_parse_user_date(self.capture_to.get(),'data final da captura') if self.capture_to.get().strip() else ''
        if df and dt and df>dt:
            raise ValueError('A data inicial da captura não pode ser maior que a data final.')
        return df,dt

    def _filter_documents_for_capture_view(self, documents, date_from='', date_to=''):
        docs=list(documents or [])
        if not date_from and not date_to:
            return docs
        out=[]
        for doc in docs:
            d=str(doc.get('data') or doc.get('issued_at') or '')[:10]
            if not d:
                continue
            if date_from and d<date_from: continue
            if date_to and d>date_to: continue
            out.append(doc)
        return out

    def _capture_period_label(self, date_from='', date_to=''):
        if not date_from and not date_to:
            return 'Todos os documentos disponíveis'
        left=_format_user_date(date_from) if date_from else 'início'
        right=_format_user_date(date_to) if date_to else 'fim'
        return f'{left} até {right}'

    def _load_persisted_company_state(self, cnpj=None):
        """Load documents already stored locally for the selected company.
        This keeps the Central persistent across application restarts: synchronization
        only fetches novelties, while the local index remains the source for reports
        and organized export.
        """
        digits = re.sub(r'\D', '', str(cnpj if cnpj is not None else self.cnpj_var.get().strip()))
        if len(digits) != 14:
            self.last_documents = []
            self._reset_sync_cards()
            if hasattr(self, 'save_btn'): self.save_btn.config(state='disabled')
            if hasattr(self, 'pdf_btn'): self.pdf_btn.config(state='disabled')
            return []
        # Repair stale company names left by previous versions using the documents
        # actually tied to the consulted CNPJ.
        try:
            local_name = db_reconcile_company_name(digits, limit=100)
        except Exception:
            local_name = ''
        docs = db_load_documents_as_payload(digits, limit=100000)
        if local_name and local_name not in {f'Empresa_{digits}','Empresa não identificada'} and getattr(self, 'cnpj_confirmed', '') == digits:
            self.sync_company_label.config(text=f'Empresa: {local_name}', fg=TEXT)
            if hasattr(self,'cnpj_name_label'):
                self.cnpj_name_label.config(text='✓ Empresa identificada a partir dos documentos fiscais', fg=GREEN)
            if hasattr(self,'sync_company_header'):
                self.sync_company_header.config(text=local_name)
                self.sync_company_header_doc.config(text=_format_cnpj(digits))
        self.last_documents = list(docs)
        self._refresh_documents_dashboard_visuals()
        for family in ('nfe','nfce','cte'):
            count = db_family_document_count(digits, family)
            self._update_sync_card(family, count, 'Disponível' if count else 'Sem documentos')
        total = len(docs)
        if hasattr(self, 'total_docs_label'):
            self.total_docs_label.config(text=f'Total: {total:,} documentos'.replace(',', '.'))
        if hasattr(self, 'progress_title'):
            self.progress_title.config(text='Documentos disponíveis na Central' if total else 'Pronto para buscar XML')
        if hasattr(self, 'progress_subtitle'):
            self.progress_subtitle.config(text=(f'{total:,} documento(s) já armazenado(s). A próxima atualização buscará somente novidades.' if total else 'A Central Fiscal cuidará da atualização automaticamente.').replace(',', '.'))
        if hasattr(self, 'test_result') and total:
