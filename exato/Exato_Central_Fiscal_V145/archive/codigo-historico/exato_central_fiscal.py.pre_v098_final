def _sat_is_applications_page(page):
    """Return True when the authenticated SAT portal is showing the Applications hub."""
    try:
        body=(page.locator('body').inner_text(timeout=2500) or '').casefold()
    except Exception:
        body=''
    return ('aplicações' in body or 'aplicacoes' in body) and ('áreas' in body or 'areas' in body) and not _sat_is_login_page(page)


def _sat_open_consulta_from_applications(page, context):
    """Open the NFe/NFCe consultation through the authenticated SAT application link.

    The manual user flow does not jump directly to ConsultaOnlineCC.aspx: after certificate
    authentication the Applications hub is reached first, then the user clicks
    "1. NFe / NFCe - Consulta". We reproduce that navigation so the SAT can keep the
    same authenticated session and any server-side navigation context attached to the link.
    """
    pattern=re.compile(r'^\s*1\.\s*NFe\s*/\s*NFCe\s*-\s*Consulta\s*$',re.I)
    candidates=[]
    for locator_expr in ('a','button'):
        try:
            loc=page.locator(locator_expr)
            for i in range(loc.count()):
                el=loc.nth(i)
                try:
                    text=re.sub(r'\s+',' ',(el.inner_text() or '').strip())
                except Exception:
                    text=''
                if pattern.search(text):
                    candidates.append(el); break
        except Exception:
            continue
    if not candidates:
        try:
            loc=page.get_by_text(pattern).first
            if loc.count(): candidates.append(loc)
        except Exception:
            pass
    if not candidates:
        raise RuntimeError('A área Aplicações foi aberta, mas o link "1. NFe / NFCe - Consulta" não foi localizado no SAT.')
    link=candidates[0]
    # The real portal opens the consultation in a new tab in the manual flow.
    try:
        with context.expect_page(timeout=5000) as popup_info:
            link.click(timeout=10000)
        popup=popup_info.value
        popup.wait_for_load_state('domcontentloaded', timeout=30000)
        popup.wait_for_timeout(1200)
        if _sat_is_login_page(popup):
            raise RuntimeError('O SAT abriu a consulta, mas a sessão autenticada não foi mantida: a página voltou ao Login.')
        return popup
    except Exception as popup_exc:
        # If the portal keeps the same tab, click again only when the first attempt did not
        # navigate it to the consultation. Do not hide a real login/session failure.
        try:
            if 'ConsultaOnlineCC.aspx' in getattr(page,'url','') and not _sat_is_login_page(page):
                return page
        except Exception:
            pass
        try:
            if _sat_is_login_page(page):
                raise RuntimeError('O SAT voltou ao Login ao abrir a consulta NFe/NFCe. A sessão autenticada não foi preservada.')
        except RuntimeError:
            raise
        try:
            current_url=getattr(page,'url','')
            # If click produced a same-tab navigation, give it a moment to settle.
            page.wait_for_timeout(1200)
            if 'ConsultaOnlineCC.aspx' in getattr(page,'url','') and not _sat_is_login_page(page):
                return page
            # Last-resort same-tab click only when no popup/navigation occurred.
            link.click(timeout=5000)
            page.wait_for_timeout(1200)
            if 'ConsultaOnlineCC.aspx' in getattr(page,'url','') and not _sat_is_login_page(page):
                return page
        except Exception:
            pass
        raise RuntimeError(f'Não foi possível abrir a consulta NFe/NFCe pela área Aplicações do SAT ({popup_exc}).')


def _sat_start_native_certificate_monitor(selected_certificate, timeout_sec=45, result_path=None):
    """Watch the native Windows certificate picker and select only the stored certificate."""
    if os.name!='nt': return None, None
    cert=selected_certificate or {}
    identity=_sat_windows_certificate_identity(cert)
    cn=str(identity.get('SubjectCN') or '').strip()
