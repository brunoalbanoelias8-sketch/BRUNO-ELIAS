    }

def _fiscal_access_key(root, family=''):
    key=_extract_access_key_from_xml(ET.tostring(root,encoding='utf-8')) if root is not None else ''
    if key: return re.sub(r'\D','',key)[:44]
    for tag in ('chNFe','chCTe'):
        n=_xml_first(root,tag)
        if n is not None and (n.text or '').strip():
            k=re.sub(r'\D','',(n.text or '').strip())
            if len(k)==44: return k
    return ''

