def _find_newer_local_versions():
    current_match = re.search(r'_V(\d+)$', APP_DIR.name, re.I)
    current = int(current_match.group(1)) if current_match else int(re.sub(r'\D','', APP_VERSION) or 0)
    found=[]
    try:
        for child in APP_DIR.parent.iterdir():
            if not child.is_dir():
                continue
            m=re.match(r'^Exato_Central_Fiscal_V(\d+)$', child.name, re.I)
            if not m: continue
            ver=int(m.group(1))
            if ver <= current: continue
            marker=child/'VERSAO.txt'
            found.append((ver, child, marker.read_text(encoding='utf-8').strip() if marker.exists() else child.name))
    except Exception:
        pass
    return sorted(found, key=lambda x:x[0], reverse=True)


