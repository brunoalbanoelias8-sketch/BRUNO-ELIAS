    def _run_auto_sync(self, family):
        if not self.selected:
            return
        cnpj=self.cnpj_var.get().strip()
        thumb=(self.selected.get('Thumbprint') or '').replace(' ','').upper()
        self._sync_family_pending = family
        if self.use_saved_var.get():
            start_nsu=get_saved_nsu(self.config_data, cnpj, family)
            self.nsu_var.set(str(start_nsu))
        else:
            start_nsu='0'
        try:
            int(str(start_nsu or '0'))
        except Exception:
            messagebox.showerror('NSU inválido','Informe um NSU inicial válido.')
            return
        for widget in (self.sync_all_btn,self.save_btn,self.pdf_btn):
            widget.config(state='disabled')
        family_label='NF-e' if family=='nfe' else ('NFC-e' if family=='nfce' else 'CT-e (Entrada)')
        self.test_result.config(state='normal');self.test_result.delete('1.0','end');self.progress_title.config(text=f'Sincronizando {family_label}...'); self.progress_subtitle.config(text='O sistema está trabalhando automaticamente.'); self._show_progress_bar(); self.progress_bar.start(10); self.test_result.insert('1.0',f'Iniciando atualização de {family_label}...\n\nO sistema está trabalhando automaticamente.');self.test_result.config(state='disabled')
        self.set_status(f'Sincronizando {family_label} pela SEF/SC...')

        def progress(evt):
            info=evt.get('info') or {}
            docs=len(info.get('documents') or [])
            returned=info.get('ultNSURet') or info.get('ultNSU') or '?'
            max_nsu=info.get('maxNSU') or '?'
            text=(f"Sincronizando {family_label}...\n\n"
                  f"Lote processado: {evt['batch']}\n"
                  f"Documentos encontrados neste lote: {docs}\n"
                  f"Documentos encontrados até agora: {evt['total_docs']}\n\n"
                  f"O sistema continuará automaticamente.")
            self.after(0,lambda t=text:self._append_sync_progress(t))

        homolog = bool(self.hom_var.get()) if family=='nfe' else False
        def worker():
            if family=='nfe':
                fetch=lambda th,c,n: test_sef_nfe_webservice(th,c,homolog,1,n)
            else:
                fetch=lambda th,c,n: test_sef_nfce_webservice(th,c,1,3,n)
