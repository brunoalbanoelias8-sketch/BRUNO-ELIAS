    def _import_sat_excel_files(self):
        if getattr(self,'audit_running',False): self.set_status('Já existe uma auditoria em andamento.'); return
        family=getattr(self,'audit_family_var',tk.StringVar(value='')).get() if hasattr(self,'audit_family_var') else ''
        if family not in ('nfe','nfce'):
            messagebox.showinfo('Tipo de documento','Escolha primeiro se a auditoria será de NF-e ou NFC-e.'); return
        paths=filedialog.askopenfilenames(title=f'Selecione o(s) Excel(ns) do SAT — {SUPPORTED_FAMILIES[family]}',filetypes=[('Excel do SAT','*.xlsx'),('Todos os arquivos','*.*')])
        if not paths: return
        self.audit_running=True; self.audit_cancel_event.clear(); self.audit_import_btn.config(state='disabled'); self.audit_cancel_btn.config(state='normal'); self.audit_pdf_btn.config(state='disabled')
