[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12
$cert=$null
foreach($path in @("Cert:\CurrentUser\My\$Thumbprint","Cert:\LocalMachine\My\$Thumbprint")) { try { $candidate=Get-Item -Path $path -ErrorAction Stop; if($candidate.HasPrivateKey){$cert=$candidate;break} } catch {} }
if(-not $cert){throw 'Certificado com chave privada não localizado no repositório do Windows.'}
$body=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($BodyBase64))
$request=[System.Net.HttpWebRequest]::Create($Url); $request.Method='POST'
$request.ContentType='application/soap+xml; charset=utf-8; action="'+$SoapAction+'"'; $request.Accept='application/soap+xml, text/xml'
$request.UserAgent='ExatoCentralFiscal/0.1'; $request.ClientCertificates.Add($cert)|Out-Null
$bytes=[Text.Encoding]::UTF8.GetBytes($body); $request.ContentLength=$bytes.Length
$stream=$request.GetRequestStream();$stream.Write($bytes,0,$bytes.Length);$stream.Close()
try {$response=[Net.HttpWebResponse]$request.GetResponse();$reader=New-Object IO.StreamReader($response.GetResponseStream(),[Text.Encoding]::UTF8);$content=$reader.ReadToEnd();$reader.Close();$response.Close();Write-Output $content}
catch [Net.WebException] {$resp=$_.Exception.Response;if($resp){$reader=New-Object IO.StreamReader($resp.GetResponseStream(),[Text.Encoding]::UTF8);$content=$reader.ReadToEnd();$reader.Close();$resp.Close();Write-Output $content}else{throw}}'''
    ps_b64=base64.b64encode(ps.encode('utf-8')).decode('ascii'); body_b64=base64.b64encode(body.encode('utf-8')).decode('ascii')
    command=("$s=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('"+ps_b64+"'));$sb=[ScriptBlock]::Create($s);& $sb "+f"-Thumbprint '{thumb}' -Url '{url}' -SoapAction '{action}' -BodyBase64 '{body_b64}'")
