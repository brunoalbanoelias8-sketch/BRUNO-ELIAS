def _sat_set_period_and_filters(page, cnpj, date_from, date_to, document_label, direction_label):
    # Tipo de documento
    sel=_sat_find_select(page,['Tipo de documento','Tipo Documento','Tipo'],[document_label])
    if sel is None:
        raise RuntimeError('Não foi possível localizar o filtro de tipo de documento no SAT.')
    # Situação: todas
    _sat_find_select(page,['Situação','Situacao'],['Todas','Todos'])
    # Clear both sides first, then fill selected side.
    _sat_clear_by_hints(page,['Emitente','CNPJ Emitente','CpfCnpjEmitente','txtEmitente','emissor'])
    _sat_clear_by_hints(page,['Destinatário','Destinatario','CNPJ Destinatário','CnpjDestinatario','txtDestinatario','destinatario'])
    hints=['Emitente','CNPJ Emitente','CpfCnpjEmitente','txtEmitente','emissor'] if direction_label=='Emitente' else ['Destinatário','Destinatario','CNPJ Destinatário','CnpjDestinatario','txtDestinatario','destinatario']
    if not _sat_fill_by_hints(page,hints,cnpj):
        raise RuntimeError(f'Não foi possível localizar o campo de {direction_label.lower()} no SAT.')
    # Dates
    if not _sat_fill_by_hints(page,['dtDataInicial','Data inicial','Data de emissão - De','DtInicio','txtDataInicio','data de'],date_from):
        raise RuntimeError('Não foi possível localizar a data inicial no SAT.')
    if not _sat_fill_by_hints(page,['dtDataFinal','Data final','Data de emissão - Até','DtFim','txtDataFim','data até'],date_to):
        raise RuntimeError('Não foi possível localizar a data final no SAT.')


def _sat_has_no_results(page):
