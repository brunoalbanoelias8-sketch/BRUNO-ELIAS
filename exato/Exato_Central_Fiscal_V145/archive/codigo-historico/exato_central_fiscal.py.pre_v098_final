def init_database():
    """Create the local fiscal database used as durable document index/storage."""
    conn = sqlite3.connect(DB_PATH)
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("""CREATE TABLE IF NOT EXISTS companies (
        cnpj TEXT PRIMARY KEY,
        name TEXT NOT NULL,
        last_sync_at TEXT,
        created_at TEXT NOT NULL
    )""")
    conn.execute("""CREATE TABLE IF NOT EXISTS documents (
        doc_id TEXT PRIMARY KEY,
        cnpj TEXT NOT NULL,
        family TEXT NOT NULL,
        doc_type TEXT NOT NULL,
        direction TEXT,
        number TEXT,
        series TEXT,
        issued_at TEXT,
        value TEXT,
        status TEXT,
        access_key TEXT,
        source_nsu TEXT,
        xml BLOB NOT NULL,
        first_seen_at TEXT NOT NULL,
        last_seen_at TEXT NOT NULL
    )""")
    conn.execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_documents_key ON documents(cnpj, access_key) WHERE access_key IS NOT NULL AND access_key <> ''")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_documents_company ON documents(cnpj)")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_documents_date ON documents(issued_at)")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_documents_family ON documents(family)")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_documents_direction ON documents(direction)")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_documents_status ON documents(status)")
    conn.execute("""CREATE TABLE IF NOT EXISTS document_sources (
        cnpj TEXT NOT NULL,
        doc_id TEXT NOT NULL,
        family TEXT NOT NULL,
        actor_code TEXT NOT NULL DEFAULT '',
        actor_label TEXT NOT NULL DEFAULT '',
        source_nsu TEXT NOT NULL DEFAULT '',
        first_seen_at TEXT NOT NULL,
        last_seen_at TEXT NOT NULL,
        PRIMARY KEY(cnpj, doc_id, actor_code)
    )""")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_document_sources_lookup ON document_sources(cnpj, family, actor_code, source_nsu)")
    conn.execute("""CREATE TABLE IF NOT EXISTS audit_runs (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        cnpj TEXT NOT NULL,
        started_at TEXT NOT NULL,
        finished_at TEXT,
        period_start TEXT,
        period_end TEXT,
        status TEXT NOT NULL,
        findings_json TEXT DEFAULT '{}'
    )""")
    conn.execute("""CREATE TABLE IF NOT EXISTS sync_runs (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        cnpj TEXT NOT NULL,
        started_at TEXT NOT NULL,
        finished_at TEXT,
        status TEXT NOT NULL,
        total_found INTEGER DEFAULT 0,
        new_count INTEGER DEFAULT 0,
        duplicate_count INTEGER DEFAULT 0,
        error_text TEXT DEFAULT ''
    )""")
    conn.commit(); conn.close()


def _document_db_id(cnpj, doc):
    xml = doc.get('xml') or b''
    key = re.sub(r'\D','', str(doc.get('chave') or ''))
    if key:
        return f"{re.sub(r'\D','',str(cnpj or ''))}|{key}"
    return hashlib.sha256(re.sub(r'\D','',str(cnpj or '')).encode()+b'|'+xml).hexdigest()



def _pick_authoritative_company_name(documents, cnpj):
    """Return the most reliable company name for the consulted CNPJ.

    The name must come from a document where the consulted CNPJ is actually a
    participant identified by _parse_document_metadata, never from an arbitrary
    supplier/customer name and never from the certificate subject.
    """
    cnpj_digits = re.sub(r'\D', '', str(cnpj or ''))
    if not cnpj_digits:
        return ''
    candidates = []
    for doc in documents or []:
        try:
            raw_type = str(doc.get('tipo') or doc.get('doc_type') or '')
            if 'evento' in raw_type.casefold():
                continue
            xml = doc.get('xml') or b''
            if not xml:
                continue
            meta = _parse_document_metadata(xml, cnpj_digits, doc.get('family') or '')
            name = str(meta.get('empresa') or '').strip()
            if name and name != 'Empresa não identificada':
                candidates.append(name)
        except Exception:
            continue
    if not candidates:
        return ''
    from collections import Counter
    counts = Counter(candidates)
    return sorted(counts, key=lambda n: (-counts[n], -len(n), n.casefold()))[0]


def db_reconcile_company_name(cnpj, limit=100):
    """Repair a stale/wrong company name using documents tied to the same CNPJ."""
    cnpj_digits = re.sub(r'\D', '', str(cnpj or ''))
    if not cnpj_digits:
        return ''
    init_database()
    conn = sqlite3.connect(DB_PATH, timeout=30)
    conn.row_factory = sqlite3.Row
    rows = conn.execute(
        "SELECT xml,family,doc_type FROM documents WHERE cnpj=? AND status!='Evento' ORDER BY rowid DESC LIMIT ?",
        (cnpj_digits, int(limit)),
    ).fetchall()
    conn.close()
    docs = [dict(r) for r in rows]
    name = _pick_authoritative_company_name(docs, cnpj_digits)
    if not name:
        return db_get_company_name(cnpj_digits)
    conn = sqlite3.connect(DB_PATH, timeout=30)
    conn.execute("UPDATE companies SET name=? WHERE cnpj=?", (name, cnpj_digits))
    conn.commit(); conn.close()
    return name


def db_upsert_documents(cnpj, documents):
    """Persist fetched XMLs immediately and return (new, duplicate) counts.
    Also enrich each in-memory document with parsed metadata so later export
    can write files without parsing the same XML again.
    """
    init_database()
    conn = sqlite3.connect(DB_PATH, timeout=30)
    now = datetime.now().isoformat(timespec='seconds')
    new_count = dup_count = 0
    cnpj_digits = re.sub(r'\D','', str(cnpj or ''))
    # Prefer the legal name extracted from documents where the consulted CNPJ is
    # actually the relevant party. This repairs stale/misattributed names from
    # older versions and prevents supplier/customer names from becoming the company.
    company_name = _pick_authoritative_company_name(documents, cnpj_digits)
    if not company_name:
        existing_name = conn.execute("SELECT name FROM companies WHERE cnpj=?", (cnpj_digits,)).fetchone()
        company_name = str(existing_name[0]).strip() if existing_name and str(existing_name[0] or '').strip() else ''
    if not company_name:
        company_name = f'Empresa_{cnpj_digits}' if cnpj_digits else 'Empresa não identificada'
    conn.execute("INSERT INTO companies(cnpj,name,last_sync_at,created_at) VALUES(?,?,?,?) ON CONFLICT(cnpj) DO UPDATE SET name=excluded.name,last_sync_at=excluded.last_sync_at", (cnpj_digits, company_name, now, now))
    for doc in documents or []:
        xml = doc.get('xml') or b''
        if not xml:
            continue
        family = doc.get('family') or ('nfce' if doc.get('tipo')=='nfeProc' and b'mod>65<' in xml else 'nfe')
        meta = _parse_document_metadata(xml, cnpj_digits, family)
        # Keep the parsed metadata on the in-memory payload.
        # The export routine can then avoid reparsing every XML.
        doc.setdefault('family', family)
        doc['direcao'] = meta.get('direcao') or doc.get('direcao') or 'Entrada'
        doc['numero'] = meta.get('numero') or doc.get('numero') or ''
        doc['serie'] = meta.get('serie') or doc.get('serie') or ''
        doc['data'] = meta.get('data') or doc.get('data') or ''
        doc['valor'] = meta.get('valor') if meta.get('valor') is not None else doc.get('valor') or Decimal('0.00')
        doc['chave'] = re.sub(r'\D','', str(meta.get('chave') or doc.get('chave') or ''))
        doc['empresa'] = meta.get('empresa') or doc.get('empresa') or ''
        doc['doc_type'] = meta.get('tipo') or doc.get('doc_type') or doc.get('tipo') or 'Documento'
        key = doc['chave']
        doc_id = _document_db_id(cnpj_digits, {'chave': key, 'xml': xml})
        # Repeated polling should update last_seen/source NSU without duplicating XML.
        actor_code = str(doc.get('actor_code') or '')
        actor_label = str(doc.get('actor_label') or '')
        source_nsu = str(doc.get('nsu') or '')
        exists = conn.execute("SELECT 1 FROM documents WHERE doc_id=?", (doc_id,)).fetchone()
        if exists:
            dup_count += 1
            conn.execute("UPDATE documents SET source_nsu=?, last_seen_at=? WHERE doc_id=?", (source_nsu, now, doc_id))
            if actor_code:
                conn.execute("""INSERT INTO document_sources(cnpj,doc_id,family,actor_code,actor_label,source_nsu,first_seen_at,last_seen_at)
                               VALUES(?,?,?,?,?,?,?,?)
                               ON CONFLICT(cnpj,doc_id,actor_code) DO UPDATE SET actor_label=excluded.actor_label, source_nsu=excluded.source_nsu, last_seen_at=excluded.last_seen_at""",
                               (cnpj_digits,doc_id,family,actor_code,actor_label,source_nsu,now,now))
            continue
        status = 'Autorizado'
        doc_type = meta.get('tipo') or doc.get('doc_type') or doc.get('tipo') or 'Documento'
        if str(doc.get('tipo') or '').lower().startswith('procEvento'):
            status = 'Evento'; doc_type = 'Evento'
        conn.execute("""INSERT INTO documents(doc_id,cnpj,family,doc_type,direction,number,series,issued_at,value,status,access_key,source_nsu,xml,first_seen_at,last_seen_at)
                       VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""", (
            doc_id, cnpj_digits, family, doc_type, meta.get('direcao') or 'Entrada',
            meta.get('numero') or '', meta.get('serie') or '', meta.get('data') or '', str(meta.get('valor') or Decimal('0.00')),
            status, key, str(doc.get('nsu') or ''), sqlite3.Binary(xml), now, now))
        if actor_code:
            conn.execute("""INSERT INTO document_sources(cnpj,doc_id,family,actor_code,actor_label,source_nsu,first_seen_at,last_seen_at)
                           VALUES(?,?,?,?,?,?,?,?)""",
                           (cnpj_digits,doc_id,family,actor_code,actor_label,source_nsu,now,now))
        new_count += 1
    conn.commit(); conn.close()
    return new_count, dup_count


def db_update_run(run_id, status=None, finished=False, total_found=None, new_count=None, duplicate_count=None, error_text=None):
    init_database(); conn=sqlite3.connect(DB_PATH, timeout=30)
    fields=[]; vals=[]
    if status is not None: fields.append('status=?'); vals.append(status)
    if finished: fields.append('finished_at=?'); vals.append(datetime.now().isoformat(timespec='seconds'))
    if total_found is not None: fields.append('total_found=?'); vals.append(int(total_found))
    if new_count is not None: fields.append('new_count=?'); vals.append(int(new_count))
    if duplicate_count is not None: fields.append('duplicate_count=?'); vals.append(int(duplicate_count))
    if error_text is not None: fields.append('error_text=?'); vals.append(str(error_text))
    if fields:
        vals.append(run_id); conn.execute(f"UPDATE sync_runs SET {', '.join(fields)} WHERE id=?", vals); conn.commit()
    conn.close()


def db_start_run(cnpj):
    init_database(); conn=sqlite3.connect(DB_PATH, timeout=30)
    cur=conn.execute("INSERT INTO sync_runs(cnpj,started_at,status) VALUES(?,?,?)", (re.sub(r'\D','',str(cnpj or '')), datetime.now().isoformat(timespec='seconds'), 'Em andamento'))
    run_id=cur.lastrowid; conn.commit(); conn.close(); return run_id


def db_list_companies(limit=500):
    init_database(); conn=sqlite3.connect(DB_PATH, timeout=30); conn.row_factory=sqlite3.Row
    rows=conn.execute("""SELECT c.cnpj,c.name,
                        COALESCE((SELECT MAX(COALESCE(s.finished_at,s.started_at)) FROM sync_runs s WHERE s.cnpj=c.cnpj), c.last_sync_at) AS last_sync,
                        COALESCE((SELECT COUNT(*) FROM documents d WHERE d.cnpj=c.cnpj AND d.status='Autorizado'),0) AS documents
                        FROM companies c GROUP BY c.cnpj,c.name ORDER BY c.name COLLATE NOCASE LIMIT ?""",(int(limit),)).fetchall()
    conn.close(); return [dict(r) for r in rows]


def db_list_documents(cnpj='', family='', direction='', status='', query='', limit=300,
                      date_from='', date_to='', company_query=''):
    init_database(); conn=sqlite3.connect(DB_PATH, timeout=30); conn.row_factory=sqlite3.Row
    sql='SELECT d.*, COALESCE(c.name, d.cnpj) AS company_name FROM documents d LEFT JOIN companies c ON c.cnpj=d.cnpj WHERE 1=1'; args=[]
    cnpj_digits=re.sub(r'\D','',str(cnpj or ''))
    if cnpj_digits: sql+=' AND d.cnpj=?'; args.append(cnpj_digits)
    if family: sql+=' AND d.family=?'; args.append(family)
    if direction: sql+=' AND d.direction=?'; args.append(direction)
    if status: sql+=' AND d.status=?'; args.append(status)
    if date_from: sql+=' AND substr(d.issued_at,1,10)>=?'; args.append(date_from)
    if date_to: sql+=' AND substr(d.issued_at,1,10)<=?'; args.append(date_to)
    if company_query:
        q=f'%{company_query.strip()}%'; sql+=' AND (c.name LIKE ? OR d.cnpj LIKE ?)'; args += [q,q]
    if query:
        q=f'%{query.strip()}%'; sql+=' AND (d.number LIKE ? OR d.series LIKE ? OR d.access_key LIKE ? OR d.doc_type LIKE ? OR c.name LIKE ?)'; args += [q,q,q,q,q]
    sql+=' ORDER BY COALESCE(d.issued_at,\'\') DESC, d.doc_id DESC LIMIT ?'; args.append(int(limit))
    rows=conn.execute(sql,args).fetchall(); conn.close(); return [dict(r) for r in rows]

def db_family_document_count(cnpj, family):
